[["いっぽんの木と、いちわの小鳥とはたいへんなかよしでした。小鳥はいちんちその木の枝で歌をうたい、木はいちんちじゅう小鳥の歌をきいていました。",[[0,4,"1166600"],[5,1,"1534520"],[8,3,"1161110"],[12,2,"1348530"],[16,4,"1415000"],[20,4,"1426100"],[28,2,"1348530"],[30,2,"1472870"],[32,2,"1431840"],[34,1,"1077410"],[35,2,"1006830"],[37,1,"1534520"],[39,1,"1310530"],[41,1,"1193180"],[43,3,"1588120"],[47,1,"1534520"],[52,1,"1388740"],[53,3,"1579840"],[56,2,"1348530"],[59,1,"1193180"],[61,2,"1226210"],[64,1,"1577980"]],[[5,1,"き"],[12,2,"ことり"],[28,2,"ことり"],[37,1,"き"],[39,1,"えだ"],[41,1,"うた"],[47,1,"き"],[56,2,"ことり"],[59,1,"うた"]]],["けれど寒い冬がちかづいてきたので、小鳥は木からわかれてゆかねばなりませんでした。",[[0,3,"1004200"],[3,2,"1210360"],[5,1,"1446070"],[7,4,"1242170"],[12,1,"1547720"],[17,2,"1348530"],[20,1,"1534520"],[23,3,"1606600"],[27,2,"1578850"],[31,2,"1375610"]],[[3,1,"さむ"],[5,1,"ふゆ"],[17,2,"ことり"],[20,1,"き"]]],["「さよなら。また来年きて、歌をきかせてください。」",[[1,4,"1291050"],[6,2,"1524930"],[8,2,"1548220"],[10,1,"1547720"],[13,1,"1193180"],[15,2,"1226210"],[19,4,"1184280"]],[[8,2,"らいねん"],[13,1,"うた"]]],["と木はいいました。",[[1,1,"1534520"],[3,2,"1587040"]],[[1,1,"き"]]],["「え。それまで待っててね。」",[[1,1,"2194050"],[3,2,"1006970"],[7,2,"1410590"]],[[7,1,"ま"]]],["と、小鳥はいって、南の方へとんでゆきました。",[[2,2,"1348530"],[5,2,"1587040"],[9,1,"1459870"],[11,1,"1516930"],[13,2,"1429700"],[16,2,"1578850"]],[[2,2,"ことり"],[9,1,"みなみ"],[11,1,"ほう"]]],["春がめぐってきました。野や森から、雪がきえていきました。",[[0,1,"1341000"],[2,3,"1342050"],[6,1,"1547720"],[11,1,"1537250"],[13,1,"1362490"],[17,1,"1386500"],[19,2,"1350040"],[22,2,"1578850"]],[[0,1,"はる"],[11,1,"の"],[13,1,"もり"],[17,1,"ゆき"]]],["小鳥は、なかよしの去年の木のところへまたかえっていきました。",[[0,2,"1348530"],[4,4,"1426100"],[9,2,"1231690"],[12,1,"1534520"],[14,3,"1343100"],[18,2,"1524930"],[20,3,"1589780"],[24,2,"1578850"]],[[0,2,"ことり"],[9,2,"きょねん"],[12,1,"き"]]],["ところが、これはどうしたことでしょう。木はそこにありませんでした。根っこだけがのこっていました。",[[0,3,"1343100"],[5,2,"1628530"],[8,2,"1451160"],[10,1,"1157170"],[12,2,"1241450"],[19,1,"1534520"],[21,2,"1436050"],[24,2,"1296400"],[33,3,"1612490"],[39,3,"1304510"],[43,1,"1577980"]],[[19,1,"き"],[33,1,"ね"]]],["「ここに立ってた木は、