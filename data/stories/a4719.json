50"],[6,3,"1128430"],[10,4,"1593570"],[14,2,"1296400"]],[]],["とききました。",[[1,2,"1226210"]],[]],["すると女の子は、",[[0,2,"1157170"],[3,3,"1344970"]],[[3,3,"おんなのこ"]]],["「マッチはもえてしまいました。けれどマッチのともした火が、まだこのランプにともっています。」",[[1,3,"1128430"],[5,2,"1469570"],[8,3,"1305380"],[15,3,"1004200"],[18,3,"1128430"],[22,3,"1582140"],[26,1,"1193610"],[29,2,"1527110"],[31,2,"1582920"],[33,3,"1140360"],[37,3,"1582150"],[41,1,"1577980"]],[[26,1,"ひ"]]],["といいました。",[[1,2,"1587040"]],[]],["小鳥は、ランプの火をじっとみつめておりました。",[[0,2,"1348530"],[4,3,"1140360"],[8,1,"1193610"],[10,3,"1005870"],[13,3,"1604580"],[17,2,"1577985"]],[[0,2,"ことり"],[8,1,"ひ"]]],["それから、去年の歌をうたって火にきかせてやりました。火はゆらゆらとゆらめいて、こころからよろこんでいるようにみえました。",[[0,2,"1006970"],[5,2,"1231690"],[8,1,"1193180"],[10,3,"1588120"],[14,1,"1193610"],[16,2,"1226210"],[20,2,"1012980"],[26,1,"1193610"],[28,4,"1013080"],[33,4,"1855250"],[39,3,"1360480"],[44,4,"1218760"],[49,2,"1577980"],[51,2,"1250220"],[54,2,"1259140"]],[[5,2,"きょねん"],[8,1,"うた"],[14,1,"ひ"],[26,1,"ひ"]]],["歌をうたってしまうと、小鳥はまたじっとランプの火をみていました。それから、どこかへとんでいってしまいました。",[[0,1,"1193180"],[2,3,"1588120"],[6,3,"1305380"],[11,2,"1348530"],[14,2,"1524930"],[16,3,"1005870"],[19,3,"1140360"],[23,1,"1193610"],[25,1,"1259290"],[27,1,"1577980"],[32,2,"1006970"],[37,2,"1577140"],[41,2,"1429700"],[44,2,"1578850"],[47,3,"1305380"]],[[0,1,"うた"],[11,2,"ことり"],[23,1,"ひ"]]]]