[["一",[],[[0,1,"いち"]]],["太郎は長いあいだ、病気でふしていましたが、ようやく床からはなれて出られるようになりました。けれどまだ三月の末で、朝と晩には寒いことがありました。",[[3,5,"1429760"],[9,2,"1490230"],[12,2,"1602650"],[15,1,"1577980"],[21,4,"1394600"],[25,1,"1349380"],[28,3,"1550840"],[32,1,"1338240"],[36,2,"1605845"],[39,2,"1375610"],[45,3,"2853889"],[48,2,"1527110"],[50,2,"1300250"],[53,1,"1525250"],[56,1,"1428280"],[58,1,"1482110"],[61,2,"1210360"],[63,2,"1241450"],[66,2,"1296400"]],[[0,2,"たろう"],[3,1,"なが"],[9,2,"びょうき"],[25,1,"とこ"],[32,1,"で"],[50,2,"さんがつ"],[53,1,"すえ"],[56,1,"あさ"],[58,1,"ばん"],[61,1,"さむ"]]],["だから、日のあたっているときには、外へ出てもさしつかえなかったけれど、晩がたになると早く家へはいるように、おかあさんからいいきかされていました。",[[4,1,"1463770"],[6,3,"1448810"],[10,2,"1577980"],[12,2,"1315840"],[17,1,"1203250"],[19,1,"1338240"],[22,5,"1291180"],[35,1,"1482110"],[36,2,"2253290"],[39,2,"1375610"],[42,2,"1404975"],[44,1,"1191730"],[46,3,"1465590"],[49,2,"1605845"],[53,5,"1002650"],[60,5,"1264270"],[67,1,"1577980"]],[[4,1,"ひ"],[17,1,"そと"],[19,1,"で"],[35,1,"ばん"],[42,1,"はや"],[44,1,"いえ"]]],["まだ、さくらの花も、ももの花も咲くには早うございましたけれど、うめだけが、かきねのきわに咲いていました。そして、雪もたいてい消えてしまって、ただ大きな寺のうらや、畑のすみのところなどに、いくぶんか消えずにのこっているくらいのものでありました。",[[0,2,"1527110"],[3,3,"1593710"],[7,1,"1194500"],[10,2,"1448290"],[13,1,"1194500"],[15,2,"1297210"],[19,2,"1404975"],[21,3,"1270350"],[37,3,"1204800"],[41,2,"1296290"],[44,2,"1297210"],[47,1,"1577980"],[52,3,"1006730"],[56,1,"1386500"],[58,4,"1414580"],[62,2,"1350040"],[65,3,"1305380"],[70,2,"1538900"],[72,3,"1412890"],[75,1,"1315240"],[77,2,"1550190"],[81,1,"1476520"],[83,2,"1246440"],[86,3,"1343100"],[93,4,"1220060"],[98,2,"1350040"],[102,3,"1304510"],[106,2,"1577980"],[112,2,"1502390"],[115,2,"1296400"]],[[7,1,"はな"],[13,1,"はな"],[15,1,"さ"],[19,1,"はよ"],[44,1,"さ"],[56,1,"ゆき"],[62,1,"き"],[72,1,"おお"],[75,1,"てら"],[81,1,"はたけ"],[98,1,"き"]]],["太郎は、外に出ましたけれど、往来にはちょうど、だれも友だちが遊んでいませんでした。みんな天気がよいので、遠くの方まで遊びに行ったものとみえます。もし、この近所であったら、自分も行ってみようと思って、耳をすましてみましたけれど、それらしい声などはきこえなかったのであります。",[[4,1,"1203250"],[6,1,"1338240"],[14,2,"1179790"],[18,4,"1427340"],[23,2,"1416830"],[26,3,"1540170"],[30,2,"