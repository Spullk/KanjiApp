[["あるところに男の子がいました。男の子は「羊飼い」です。",[[0,2,"1586840"],[2,3,"1343100"],[6,3,"1420010"],[10,1,"1577980"],[15,3,"1420010"],[20,3,"1546500"]],[[6,3,"おとこのこ"],[15,3,"おとこのこ"],[20,2,"ひつじか"]]],["男の子は朝、羊といっしょに山へ行きます。そして、夕方、帰ります。",[[0,3,"1420010"],[4,1,"1428280"],[6,1,"1546490"],[8,4,"1163400"],[13,1,"1302680"],[15,2,"1578850"],[20,3,"1006730"],[24,2,"1542790"],[27,2,"1221270"]],[[0,3,"おとこのこ"],[4,1,"あさ"],[6,1,"ひつじ"],[13,1,"やま"],[15,1,"い"],[24,2,"ゆうがた"],[27,1,"かえ"]]],["毎日、同じ仕事です。男の子はおもしろくありません。――何かおもしろいことがしたいな･･･。あ、そうだ！――",[[0,2,"1524720"],[3,2,"1451750"],[5,2,"1304970"],[10,3,"1420010"],[14,5,"1533580"],[19,2,"1296400"],[27,1,"2846738"],[29,5,"1533580"],[34,2,"1241450"],[37,1,"1157170"],[45,1,"2394370"],[47,2,"1241450"]],[[0,2,"まいにち"],[3,1,"おな"],[5,2,"しごと"],[10,3,"おとこのこ"],[27,1,"なん"]]],["男の子は村へ行きました。そして、大きな声で言いました。「オオカミだ！」",[[0,3,"1420010"],[4,1,"1406820"],[6,2,"1578850"],[12,3,"1006730"],[16,3,"1412890"],[19,1,"1380440"],[21,2,"1587040"],[28,4,"1560940"]],[[0,3,"おとこのこ"],[4,1,"むら"],[6,1,"い"],[16,1,"おお"],[19,1,"こえ"],[21,1,"い"]]],["村の人たちが来ました。「オオカミはどこだ？」「オオカミはどこだ？」",[[0,1,"1406820"],[2,3,"1368740"],[6,1,"1547720"],[12,4,"1560940"],[17,2,"1577140"],[23,4,"1560940"],[28,2,"1577140"]],[[0,1,"むら"],[2,1,"ひと"],[6,1,"き"]]],["でも、オオカミはいません。村の人たちは帰りました。――これはおもしろい！――男の子は笑いました。",[[3,4,"1560940"],[8,1,"1577980"],[13,1,"1406820"],[15,3,"1368740"],[19,2,"1221270"],[27,2,"1628530"],[30,5,"1533580"],[38,3,"1420010"],[42,2,"1351360"]],[[13,1,"むら"],[15,1,"ひと"],[19,1,"かえ"],[38,3,"おとこのこ"],[42,1,"わら"]]],["次の日、男の子は、また大きな声で言いました。「オオカミだ！オオカミだ！」",[[0,1,"1316380"],[2,1,"1463770"],[4,3,"1420010"],[9,2,"1524930"],[11,3,"1412890"],[14,1,"1380440"],[16,2,"1587040"],[23,4,"1560940"],[29,4,"1560940"]],[[0,1,"つぎ"],[2,1,"ひ"],[4,3,"おとこのこ"],[11,1,"おお"],[14,1,"こえ"],[16,1,"い"]]],["村の人たちが、また、来ました。でも、オオカミはいません。",[[0,1,"1406820"],[2,3,"1368740"],[7,2,"1524930"],[10,1,"1547720"],[18,4,"1560940"],[23,1,"1577980"]],[[0,1,"むら"],[2,1,"ひと"],[10,1,"き"]]],["村の人たちは帰りました。――おもしろい、おもしろい！――男の子は、笑いました。",[[0,1,"1406820"],[2,3,"1368740"],[6,2,"1221270"],[14,5,"1533580"],[20,5,"1533580"],[28,3,"1420010"],[33,2,"1351360"]],[[0,1,"むら"],[2,1,"ひと"],[6,1,"かえ"],[28,3,"おとこのこ"],[33,1,"わら"]]],["その次の日、本当にオオカミが来ました。",[[0,2,"1006830"],[2,1,"1316380"],[4,1,"1463770"],[6,2,"1523060"],[9,4,"1560940"],[14,1,"1547720"]],[[2,1,"つぎ"],[4,1,"ひ"],[6,2,"ほんとう"],[14,1,"き"]]],["男の子は大きな声で言いました。「大変だ、オオカミだ！オオカミだ！」でも、村の人たちは来ません。",[[0,3,"1420010"],[4,3,"1412890"],[7,1,"1380440"],[9,2,"1587040"],[16,2,"1415000"],[20,4,"1560940"],[26,4,"1560940"],[36,1,"1406820"],[38,3,"1368740"],[42,1,"1547720"]],[[0,3,"おとこのこ"],[4,1,"おお"],[7,1,"こえ"],[9,1,"い"],[16,2,"たいへん"],[36,1,"むら"],[38,1,"ひと"],[42,1,"き"]]],["オオカミは、羊をみんな食べました。",[[0,4,"1560940"],[6,1,"1546490"],[8,3,"1202150"],[11,2,"1358280"]],[[6,1,"ひつじ"],[11,1,"た"]]]]