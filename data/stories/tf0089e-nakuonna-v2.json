[["むかしむかし、メキシコのある村にとてもきれいな女の人がいました。名前はマリアでした。",[[0,6,"1604810"],[12,2,"1296400"],[14,1,"1406820"],[16,3,"1008630"],[19,3,"1591900"],[23,1,"1344930"],[25,1,"1580640"],[27,1,"1577980"],[32,2,"1531710"]],[[14,1,"むら"],[23,1,"おんな"],[25,1,"ひと"],[32,2,"なまえ"]]],["ある日、とてもハンサムなスペイン人の男が、マリアの村に来ました。",[[0,3,"1153630"],[4,3,"1008630"],[7,4,"1096560"],[12,5,"2192270"],[18,1,"1419990"],[25,1,"1406820"],[27,1,"1547720"]],[[2,1,"ひ"],[16,1,"じん"],[18,1,"おとこ"],[25,1,"むら"],[27,1,"き"]]],["男の人は、マリアが好きになりました。マリアも男の人が好きになりました。",[[0,1,"1419990"],[2,1,"1580640"],[9,2,"1277450"],[12,2,"1375610"],[22,1,"1419990"],[24,1,"1580640"],[26,2,"1277450"],[29,2,"1375610"]],[[0,1,"おとこ"],[2,1,"ひと"],[9,1,"す"],[22,1,"おとこ"],[24,1,"ひと"],[26,1,"す"]]],["二人は結婚しました。",[[0,2,"1582670"],[3,2,"1254790"],[5,1,"1157170"]],[[0,2,"ふたり"],[3,2,"けっこん"]]],["三人の子どもが生まれました。男は子どもが大好きでした。子どもとよく遊びます。でも、マリアとあまり話しません。マリアは悲しいです。",[[0,2,"1301000"],[3,3,"1307850"],[7,3,"1378690"],[14,1,"1419990"],[16,3,"1307850"],[20,3,"1413660"],[27,3,"1307850"],[31,2,"1605870"],[33,2,"1542160"],[45,3,"1584930"],[48,2,"1562350"],[58,3,"1483190"]],[[0,2,"さんにん"],[3,1,"こ"],[7,1,"う"],[14,1,"おとこ"],[16,1,"こ"],[20,2,"だいす"],[27,1,"こ"],[33,1,"あそ"],[48,1,"はな"],[58,1,"かな"]]],["ある日、男はどこかへ行きました。そして、その日、うちに帰りませんでした。次の日も、その次の日も帰りませんでした。そして、一年経ちました。",[[0,3,"1153630"],[4,1,"1419990"],[6,2,"1577140"],[10,2,"1578850"],[16,3,"1006730"],[20,3,"2002320"],[24,2,"1457730"],[27,2,"1221270"],[36,1,"1316380"],[38,1,"1463770"],[41,2,"1006830"],[43,1,"1316380"],[45,1,"1463770"],[47,2,"1221270"],[56,3,"1006730"],[60,2,"1576280"],[62,2,"1251100"]],[[2,1,"ひ"],[4,1,"おとこ"],[10,1,"い"],[22,1,"ひ"],[27,1,"かえ"],[36,1,"つぎ"],[38,1,"ひ"],[43,1,"つぎ"],[45,1,"ひ"],[47,1,"かえ"],[60,2,"いちねん"],[62,1,"た"]]],["ある日、マリアと子どもたちは川に行きました。そして遊びました。川にだれか来ました。子どもたちが、「あ、お父さんだ！」と言いました。マリアはびっくりしました。男は、きれいな女といっしょでした。",[[0,3,"1153630"],[8,5,"1307870"],[14,1,"1390020"],[16,2,"1578850"],[22,3,"1006730"],[25,2,"1542160"],[31,1,"1390020"],[33,2,"1416830"],[36,1,"1547720"],[41,5,"1307870"],[49,1,"2394370"],[51,4,"1002590"],[59,2,"1587040"],[69,4,"1226360"],[73,1,"1157170"],[78,1,"1419990"],[81,3,"1591900"],[85,1,"1344930"],[87,4,"1163400"]],[[2,1,"ひ"],[8,1,"こ"],[14,1,"かわ"],[16,1,"い"],[25,1,"あそ"],[31,1,"かわ"],[36,1,"き"],[41,1,"こ"],[52,1,"とう"],[59,1,"い"],[78,1,"おとこ"],[85,1,"おんな"]]],["男が子どもたちを見ました。そして、言いました。「おお、私のかわいい子どもたち。会いたかったよ。でも、忙しかったんだよ」男は、マリアの方を見ませんでした。マリアは何も言いませんでした。",[[0,1,"1419990"],[2,5,"1307870"],[8,1,"1259290"],[13,3,"1006730"],[17,2,"1587040"],[24,2,"2082140"],[27,1,"2842390"],[29,4,"1577200"],[33,5,"1307870"],[39,2,"1198180"],[50,4,"1519290"],[59,1,"1419990"],[66,1,"1516930"],[68,1,"1259290"],[80,1,"2846738"],[82,2,"1587040"]],[[0,1,"おとこ"],[2,1,"こ"],[8,1,"み"],[17,1,"い"],[27,1,"わたくし"],[33,1,"こ"],[39,1,"あ"],[50,1,"いそが"],[59,1,"おとこ"],[66,1,"ほう"],[68,1,"み"],[80,1,"なん"],[82,1,"い"]]],["マリアは、とてもとても怒りました。そして・・・・・・、子どもを川に投げ捨てました。どぶん！また、どぶん！そして、また、どぶん！",[[5,6,"2220780"],[11,2,"1445690"],[17,3,"1006730"],[27,3,"1307850"],[31,1,"1390020"],[33,4,"1447030"],[41,3,"2394240"],[45,2,"1524930"],[48,3,"2394240"],[52,3,"1006730"],[56,2,"1524930"],[59,3,"2394240"]],[[11,1,"おこ"],[27,1,"こ"],[31,1,"かわ"],[33,3,"なげす"]]],["マリアは、長い間、川のそばにいました。それから、大きな声を出しました。「子どもたちはどこ？子どもたちがいない・・・・・・どうして？!」",[[5,3,"1429760"],[9,1,"1390020"],[11,2,"1403830"],[14,1,"1577980"],[19,2,"1006970"],[24,3,"1412890"],[27,1,"1380440"],[29,2,"1338180"],[36,5,"1307870"],[42,2,"1577140"],[45,5,"1307870"],[51,1,"1577980"],[60,2,"1451160"],[62,1,"1157170"]],[[5,3,"ながいあいだ"],[9,1,"かわ"],[24,1,"おお"],[27,1,"こえ"],[29,1,"だ"],[36,1,"こ"],[45,1,"こ"]]],["マリアは、泣きました。そして、川の中へ入りました。マリアも、もういません。",[[5,2,"1229840"],[11,3,"1006730"],[15,1,"1390020"],[17,1,"1423310"],[19,2,"1465590"],[30,2,"1012480"],[32,1,"1577980"]],[[5,1,"な"],[15,1,"かわ"],[17,1,"なか"],[19,1,"はい"]]],["それから、メキシコでは、夜、白い服の女の人が、村や町を歩きます。そして、悲しい声で泣きます。「私の子どもは、どこ？」「私の子どもはどこ？」",[[0,2,"1006970"],[12,1,"1536350"],[14,2,"1474910"],[16,1,"1500940"],[18,1,"1344930"],[20,1,"1580640"],[23,1,"1406820"],[25,1,"1603990"],[27,2,"1514320"],[32,3,"1006730"],[36,3,"1483190"],[39,1,"1380440"],[41,2,"1229840"],[47,1,"2842390"],[49,3,"1307850"],[54,2,"1577140"],[59,1,"2842390"],[61,3,"1307850"],[65,2,"1577140"]],[[12,1,"よる"],[14,1,"しろ"],[16,1,"ふく"],[18,1,"おんな"],[20,1,"ひと"],[23,1,"むら"],[25,1,"まち"],[27,1,"ある"],[36,1,"かな"],[39,1,"こえ"],[41,1,"な"],[47,1,"わたくし"],[49,1,"こ"],[59,1,"わたくし"],[61,1,"こ"]]],["メキシコでは、このお話はとても有名です。メキシコ人は、この話を子どもによくします。そして、「夜は、危ないですよ。夜、外に行ってはいけません」と言います。",[[7,2,"1582920"],[9,2,"2581590"],[12,3,"1008630"],[15,2,"1541620"],[20,5,"2153800"],[27,2,"1582920"],[29,1,"1600900"],[31,3,"1307850"],[35,3,"2255500"],[41,3,"1006730"],[46,1,"1536350"],[49,3,"1218380"],[56,1,"1536350"],[58,1,"1203250"],[60,2,"1578850"],[64,2,"1578850"],[71,2,"1587040"]],[[10,1,"はなし"],[15,2,"ゆうめい"],[24,1,"にん"],[29,1,"はなし"],[31,1,"こ"],[46,1,"よる"],[49,1,"あぶ"],[56,1,"よる"],[58,1,"そと"],[60,1,"い"],[71,1,"い"]]]]