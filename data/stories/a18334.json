[["一",[],[[0,1,"いち"]]],["むかし、むかし、あるところに、猿とかにがありました。",[[0,3,"1382370"],[4,3,"1382370"],[8,2,"1586840"],[10,3,"1343100"],[15,1,"1177390"],[20,2,"1296400"]],[[15,1,"さる"]]],["ある日猿とかにはお天気がいいので、連れだって遊びに出ました。その途中、山道で猿は柿の種を拾いました。またしばらく行くと、川のそばでかにはおむすびを拾いました。かには、",[[0,3,"1153630"],[3,1,"1177390"],[8,3,"1002470"],[12,2,"1605820"],[17,4,"1559360"],[22,2,"1542160"],[25,1,"1338240"],[30,2,"1006830"],[32,2,"1582200"],[35,2,"1303090"],[38,1,"1177390"],[40,1,"1204810"],[42,1,"1328810"],[44,2,"1332570"],[50,2,"1524930"],[52,4,"1304420"],[56,2,"1578850"],[60,1,"1390020"],[62,2,"1403830"],[68,4,"1001850"],[73,2,"1332570"],[79,2,"1202410"]],[[2,1,"ひ"],[3,1,"さる"],[9,2,"てんき"],[17,1,"つ"],[22,1,"あそ"],[25,1,"で"],[32,2,"とちゅう"],[35,2,"やまみち"],[38,1,"さる"],[40,1,"かき"],[42,1,"たね"],[44,1,"ひろ"],[56,1,"い"],[60,1,"かわ"],[73,1,"ひろ"]]],["「こんないいものを拾った。」",[[1,3,"1004880"],[4,2,"1605820"],[6,2,"1502390"],[9,2,"1332570"]],[[9,1,"ひろ"]]],["と言って猿に見せますと、猿も、",[[1,2,"1587040"],[4,1,"1177390"],[6,2,"1259210"],[12,1,"1177390"]],[[1,1,"い"],[4,1,"さる"],[6,1,"み"],[12,1,"さる"]]],["「わたしだってこんないいものを拾った。」",[[1,3,"1311110"],[7,3,"1004880"],[10,2,"1605820"],[12,2,"1502390"],[15,2,"1332570"]],[[15,1,"ひろ"]]],["と言って、柿の種を見せました。けれど猿はほんとうはおむすびがほしくってならないものですから、かにに向かって、",[[1,2,"1587040"],[5,1,"1204810"],[7,1,"1328810"],[9,2,"1259210"],[15,3,"2853889"],[18,1,"1177390"],[20,4,"1523060"],[25,4,"1001850"],[30,3,"1547330"],[35,2,"1375610"],[39,2,"1502390"],[46,2,"1202410"],[49,3,"1604800"]],[[1,1,"い"],[5,1,"かき"],[7,1,"たね"],[9,1,"み"],[18,1,"さる"],[49,1,"む"]]],["「どうだ、この柿の種と取りかえっこをしないか。」",[[1,2,"1451160"],[5,2,"1582920"],[7,1,"1204810"],[9,1,"1328810"],[11,4,"1326830"],[15,2,"2255460"],[18,1,"1157170"]],[[7,1,"かき"],[9,1,"たね"],[11,1,"と"]]],["と言いました。",[[1,2,"1587040"]],[[1,1,"い"]]],["「でもおむすびの方が大きいじゃないか。」",[[3,4,"1001850"],[8,1,"1516930"],[10,3,"1588880"],[15,2,"1529520"]],[[8,1,"ほう"],[10,1,"おお"]]],["とかには言いました。",[[4,2,"1587040"]],[[4,1,"い"]]],["「でも柿の種は、まけば芽が出て木になって、おいしい実がなるよ。」",[[3,1,"1204810"],[5,1,"1328810"],[8,2,"1524750"],[11,1,"1197710"],[13,1,"1338240"],[15,1,"1534520"],[17,2,"1375610"],[21,4,"1486650"],[25,1,"1320800"],[27,2,"1375610"]],[[3,1,"かき"],[5,1,"たね"],[11,1,"め"],[13,1,"で"],[15,1,"き"],[25,1,"み"]]],["と猿は言いました。そう言われるとかにも種がほしくなって、",[[1,1,"1177390"],[3,2,"1587040"],[9,4,"1394680"],[19,1,"1328810"],[21,3,"1547330"],[24,2,"1375610"]],[[1,1,"さる"],[3,1,"い"],[11,1,"い"],[19,1,"たね"]]],["「それもそうだなあ。」",[[1,2,"1006970"],[4,2,"1241450"]],[]],["と言いながら、とうとう大きなおむすびと、小さな柿の種とを取りかえてしまいました。猿はうまくかにをだましておむすびをもらうと、見せびらかしながらうまそうにむしゃむしゃ食べて、",[[1,2,"1587040"],[7,4,"1449890"],[11,3,"1412890"],[14,4,"1001850"],[20,3,"2136180"],[23,1,"1204810"],[25,1,"1328810"],[28,4,"1326830"],[33,3,"1305380"],[40,1,"1177390"],[42,3,"1310460"],[45,2,"1202410"],[48,3,"1574550"],[52,4,"1001850"],[57,3,"1535910"],[62,6,"1259200"],[71,2,"1310460"],[73,2,"1241450"],[76,6,"1628710"],[82,2,"1358280"]],[[1,1,"い"],[11,1,"おお"],[20,1,"ちい"],[23,1,"かき"],[25,1,"たね"],[28,1,"と"],[40,1,"さる"],[62,1,"み"],[82,1,"た"]]],["「さようなら、かにさん、ごちそうさま。」",[[1,5,"1291050"],[7,2,"1202410"],[9,2,"1579350"],[12,6,"1270520"]],[]],["と言って、のそのそ自分のうちへ帰っていきました。",[[1,2,"1587040"],[5,4,"1009930"],[9,2,"1318610"],[12,2,"1457730"],[15,2,"1221270"],[18,2,"1578850"]],[[1,1,"い"],[9,2,"じぶん"],[15,1,"かえ"]]],["二",[],[[0,1,"に"]]],["かには柿の種をさっそくお庭にまきました。そして、",[[0,2,"1202410"],[3,1,"1204810"],[5,1,"1328810"],[7,4,"1400300"],[12,1,"1436130"],[14,2,"1524750"],[20,3,"1006730"]],[[3,1,"かき"],[5,1,"たね"],[12,1,"にわ"]]],["「早く芽を出せ、柿の種。",[[1,2,"1404975"],[3,1,"1197710"],[5,2,"1338180"],[8,1,"1204810"],[10,1,"1328810"]],[[1,1,"はや"],[3,1,"め"],[5,1,"だ"],[8,1,"かき"],[10,1,"たね"]]],["出さぬと、はさみでちょん切るぞ。」",[[0,2,"1338180"],[5,3,"1573820"],[9,5,"2008940"]],[[0,1,"だ"],[12,1,"ぎ"]]],["と言いました。すると間もなく、かわいらしい芽がにょきんと出ました。",[[1,2,"1587040"],[7,2,"1157170"],[10,1,"1215240"],[12,2,"1529520"],[15,6,"1190740"],[21,1,"1197710"],[26,2,"2007420"],[28,1,"1338240"]],[[1,1,"い"],[10,1,"ま"],[21,1,"め"],[28,1,"で"]]],["かにはその芽に向かって毎日、",[[0,2,"1202410"],[3,2,"1006830"],[5,1,"1197710"],[7,3,"1604800"],[11,2,"1524720"]],[[5,1,"め"],[7,1,"む"],[11,2,"まいにち"]]],["「早く木になれ、柿の芽よ。",[[1,2,"1404975"],[3,1,"1534520"],[5,2,"1375610"],[8,1,"1204810"],[10,1,"1197710"]],[[1,1,"はや"],[3,1,"き"],[8,1,"かき"],[10,1,"め"]]],["ならぬと、はさみでちょん切るぞ。」",[[0,2,"1375610"],[5,3,"1573820"],[9,5,"2008940"]],[[12,1,"ぎ"]]],["と言いました。すると柿の芽はずんずんのびて、大きな木になって、枝が出て、葉が茂って、やがて花が咲きました。",[[1,2,"1587040"],[7,2,"1157170"],[10,1,"1204810"],[12,1,"1197710"],[14,4,"1006470"],[18,2,"1358870"],[22,3,"1412890"],[25,1,"1534520"],[27,2,"1375610"],[31,1,"1310530"],[33,1,"1338240"],[36,1,"1546550"],[38,2,"1533740"],[42,3,"1012730"],[45,1,"1194500"],[47,2,"1297210"]],[[1,1,"い"],[10,1,"かき"],[12,1,"め"],[22,1,"おお"],[25,1,"き"],[31,1,"えだ"],[33,1,"で"],[36,1,"は"],[38,1,"しげ"],[45,1,"はな"],[47,1,"さ"]]],["かにはこんどはその木に向かって毎日、",[[0,2,"1202410"],[3,3,"1289370"],[7,2,"1006830"],[9,1,"1534520"],[11,3,"1604800"],[15,2,"1524720"]],[[9,1,"き"],[11,1,"む"],[15,2,"まいにち"]]],["「早く実がなれ、柿の木よ。",[[1,2,"1404975"],[3,1,"1320800"],[5,2,"1212670"]],[[1,1,"はや"],[3,1,"み"],[8,1,"かき"]]],["ならぬと、はさみでちょん切るぞ。」",[[0,2,"1375610"],[5,3,"1573820"],[9,5,"2008940"]],[[12,1,"ぎ"]]],["と言いました。すると間もなく柿の木にはたくさん実がなって、ずんずん赤くなりました。それを下からかには見上げて、",[[1,2,"1587040"],[7,2,"1157170"],[10,1,"1215240"],[12,2,"1529520"],[19,4,"1415870"],[23,1,"1320800"],[29,4,"1006470"],[33,2,"1383240"],[35,2,"1375610"],[41,2,"1006970"],[44,1,"1184140"],[47,2,"1202410"],[50,3,"1259740"]],[[1,1,"い"],[10,1,"ま"],[14,1,"かき"],[23,1,"み"],[33,1,"あか"],[44,1,"した"],[50,2,"みあ"]]],["「うまそうだなあ。早く一つ食べてみたい。」",[[1,2,"1310460"],[3,2,"1241450"],[9,2,"1404975"],[11,2,"1160820"],[13,2,"1358280"],[16,1,"1259290"]],[[9,1,"はや"],[11,1,"ひと"],[13,1,"た"]]],["といって、手をのばしましたが、背がひくくってとどきません。こんどは木の上に登ろうとしましたが、横ばいですからいくら登っても登っても落ちてしまいます。とうとうかにもあきらめて、それでも毎日、くやしそうに下からながめていました。",[[1,2,"1587040"],[5,1,"1327190"],[7,3,"1600290"],[15,1,"2147990"],[17,3,"1434180"],[22,3,"1457200"],[29,3,"1289370"],[33,1,"1534520"],[35,1,"1352130"],[37,3,"1352570"],[41,1,"1157170"],[47,3,"1614800"],[54,3,"1219980"],[57,2,"1352570"],[61,2,"1352570"],[65,2,"1548550"],[68,3,"1305380"],[74,4,"1449890"],[78,2,"1202410"],[81,4,"1436730"],[87,2,"1006970"],[91,2,"1524720"],[94,3,"1592350"],[97,2,"1241450"],[100,1,"1184140"],[103,3,"1428830"],[107,1,"1577980"]],[[5,1,"て"],[15,1,"せい"],[33,1,"き"],[35,1,"うえ"],[37,1,"のぼ"],[47,1,"よこ"],[57,1,"のぼ"],[61,1,"のぼ"],[65,1,"お"],[91,2,"まいにち"],[100,1,"した"]]],["するとある日猿が来て、鈴なりになっている柿を見上げてよだれをたらしました。そしてこんなにりっぱな実がなるなら、おむすびと取りかえっこをするのではなかったと思いました。それを見てかには、",[[0,2,"1157170"],[3,3,"1153630"],[6,1,"1177390"],[8,1,"1547720"],[11,3,"1757830"],[15,2,"1375610"],[18,2,"1577980"],[20,1,"1204810"],[22,3,"1259740"],[26,3,"1013160"],[30,3,"1370840"],[37,3,"1006730"],[40,3,"1004880"],[44,3,"1551790"],[48,1,"1320800"],[50,2,"1375610"],[55,4,"1001850"],[60,4,"1326830"],[64,2,"2255460"],[67,2,"1157170"],[72,3,"1529520"],[77,2,"1589350"],[83,2,"1006970"],[86,1,"1259290"]],[[5,1,"ひ"],[6,1,"さる"],[8,1,"き"],[11,1,"すず"],[20,1,"かき"],[22,2,"みあ"],[48,1,"み"],[60,1,"と"],[77,1,"おも"],[86,1,"み"]]],["「猿さん、ながめていないで、登って取ってくれないか。お礼には柿を少し上げるよ。」",[[1,1,"1177390"],[2,2,"1579350"],[5,3,"1428830"],[9,1,"1577980"],[14,2,"1352570"],[17,2,"1326980"],[20,2,"1269130"],[26,2,"1270810"],[30,1,"1204810"],[32,2,"1348870"],[34,3,"1352320"]],[[1,1,"さる"],[14,1,"のぼ"],[17,1,"と"],[27,1,"れい"],[30,1,"かき"],[32,1,"すこ"],[34,1,"あ"]]],["と言いました。猿は、",[[1,2,"1587040"],[7,1,"1177390"]],[[1,1,"い"],[7,1,"さる"]]],["「しめた。」",[[1,3,"1389450"]],[]],["と言わないばかりの顔をして、",[[1,2,"1587040"],[9,1,"1217730"],[11,1,"1157170"]],[[1,1,"い"],[9,1,"かお"]]],["「よしよし、取って上げるから待っておいで。」",[[1,4,"2152570"],[6,2,"1326980"],[9,3,"1352320"],[14,2,"1410590"],[18,2,"1338240"]],[[6,1,"と"],[9,1,"あ"],[14,1,"ま"]]],["と言いながら、するする木の上に登っていきました。そして枝と枝との間にゆっくり腰をかけて、まず一つ、うまそうな赤い柿をもいで、わざと、「どうもおいしい柿だ。」と言い言い、むしゃむしゃ食べはじめました。かにはうらやましそうに下でながめていましたが、",[[1,2,"1587040"],[7,4,"1006270"],[11,1,"1534520"],[13,1,"1352130"],[15,2,"1352570"],[18,2,"1578850"],[24,3,"1006730"],[27,1,"1310530"],[29,1,"1310530"],[32,1,"1215240"],[34,4,"1013050"],[38,1,"1288340"],[40,2,"1570710"],[44,2,"1387240"],[46,2,"1160820"],[49,2,"1310460"],[51,2,"1241450"],[54,2,"1383240"],[56,1,"1204810"]