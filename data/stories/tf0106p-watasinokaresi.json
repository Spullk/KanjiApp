[["ニノさんは、この町で友だちがほし町の夏祭りで、ニノさんはツネキくんかったので、マッチングアプリを始めと会いました。ました。そして、ツネキくんと仲良くな──かっこいい！──りました。ニノさんは、うれしくなりました。",[[2,2,"1579350"],[6,2,"1582920"],[8,1,"1603990"],[10,3,"1540170"],[14,2,"1603510"],[16,1,"1603990"],[18,3,"1599520"],[25,2,"1579350"],[31,2,"1247260"],[33,2,"1473740"],[39,8,"2834290"],[48,2,"1342540"],[51,2,"1198180"],[61,3,"1006730"],[68,2,"1247260"],[71,3,"1426090"],[77,5,"2822320"],[92,2,"1579350"],[96,4,"1219510"],[100,2,"1375610"]],[[8,1,"まち"],[10,1,"とも"],[16,1,"まち"],[18,2,"なつまつ"],[48,1,"はじ"],[51,1,"あ"],[71,2,"なかよ"]]],["2人で「金魚すくい」をしました。それから、きつねそばを食べました。ツネキくんは、油揚げをおいしそうに食べました。ツネキくんは油揚げが大好きなんだと、ニノさんは思いました。",[[0,2,"1582670"],[4,5,"2085860"],[11,1,"1157170"],[16,2,"1006970"],[21,3,"1267340"],[24,2,"1403830"],[27,2,"1358280"],[36,2,"1247260"],[40,3,"1538730"],[44,5,"2832632"],[50,2,"1358280"],[59,2,"1247260"],[62,3,"1538730"],[66,3,"1413660"],[76,2,"1579350"],[79,2,"1589350"]],[[0,2,"ふたり"],[4,2,"きんぎょ"],[27,1,"た"],[40,2,"あぶらあ"],[50,1,"た"],[62,2,"あぶらあ"],[66,2,"だいす"],[79,1,"おも"]]],["それから「射的」をしました。ニノさバーン！んは狐のおもちゃがほしいと思いましニノさんは鉄砲でおもちゃを撃ちました。た。ツネキくんは、びっくりして、狐になってしまいました。ツネキくんは、本当は狐だったのです。",[[0,2,"1006970"],[5,2,"1322290"],[9,1,"1157170"],[16,1,"1291070"],[17,3,"2318380"],[21,1,"2139720"],[23,1,"1267340"],[25,4,"1217070"],[30,3,"1547330"],[34,2,"1589350"],[40,2,"1579350"],[43,2,"1438010"],[46,4,"1217070"],[51,2,"1253570"],[62,2,"1247260"],[66,4,"1226360"],[70,1,"1157170"],[73,1,"1267340"],[75,2,"1375610"],[78,3,"1305380"],[88,2,"1247260"],[92,2,"1523060"],[95,1,"1267340"]],[[5,2,"しゃてき"],[23,1,"きつね"],[34,1,"おも"],[43,2,"てっぽう"],[51,1,"う"],[73,1,"きつね"],[92,2,"ほんとう"],[95,1,"きつね"]]],["すぐに、ツネキくんは山の方へ逃げてニノさんは電話をしましたが、ツネキ行きました。くんは電話に出ません。でも、ニノさんはツネキくんを忘れることができません。──会いたいな──ツネキくん…。",[[0,2,"1430610"],[7,2,"1247260"],[10,1,"1302680"],[12,1,"1516930"],[14,2,"1450330"],[19,2,"1579350"],[22,2,"1443840"],[25,1,"1157170"],[34,2,"1578850"],[40,2,"1247260"],[43,2,"1443840"],[46,1,"1338240"],[56,2,"1579350"],[62,2,"1247260"],[65,3,"1519210"],[68,2,"1241450"],[71,2,"1340450"],[79,2,"11