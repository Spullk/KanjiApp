[["大きな国と、それよりはすこし小さな国とが隣り合っていました。当座、その二つの国の間には、なにごとも起こらず平和でありました。",[[0,3,"1412890"],[3,1,"1592250"],[6,2,"1006970"],[11,3,"1348870"],[14,3,"2136180"],[17,1,"1592250"],[20,4,"1598830"],[25,1,"1577980"],[30,2,"1449050"],[33,2,"1006830"],[35,2,"1461160"],[38,1,"1592250"],[40,1,"1215240"],[44,4,"1188740"],[49,3,"1223680"],[53,2,"1508070"],[56,2,"1296400"]],[[0,1,"おお"],[3,1,"くに"],[14,1,"ちい"],[17,1,"くに"],[20,1,"とな"],[22,1,"あ"],[30,2,"とうざ"],[35,1,"ふた"],[38,1,"くに"],[40,1,"あいだ"],[49,1,"お"],[53,2,"へいわ"]]],["ここは都から遠い、国境であります。そこには両方の国から、ただ一人ずつの兵隊が派遣されて、国境を定めた石碑を守っていました。大きな国の兵士は老人でありました。そうして、小さな国の兵士は青年でありました。",[[0,2,"1288810"],[3,1,"1621470"],[6,2,"1177800"],[9,2,"1286320"],[12,2,"1296400"],[17,2,"1436050"],[21,2,"1554010"],[24,1,"1592250"],[28,2,"1538900"],[30,2,"1576150"],[35,2,"1506590"],[38,2,"1471130"],[40,1,"1157170"],[44,2,"1286320"],[47,2,"1435380"],[50,2,"1382780"],[53,2,"1327120"],[56,1,"1577980"],[61,3,"1412890"],[64,1,"1592250"],[66,2,"1506420"],[69,2,"1561090"],[72,2,"1296400"],[78,3,"1925750"],[83,3,"2136180"],[86,1,"1592250"],[88,2,"1506420"],[91,2,"1381750"],[94,2,"1296400"]],[[3,1,"みやこ"],[6,1,"とお"],[9,2,"こっきょう"],[21,2,"りょうほう"],[24,1,"くに"],[30,2,"ひとり"],[35,2,"へいたい"],[38,2,"はけん"],[44,2,"こっきょう"],[47,1,"さだ"],[50,2,"せきひ"],[53,1,"まも"],[61,1,"おお"],[64,1,"くに"],[66,2,"へいし"],[69,2,"ろうじん"],[83,1,"ちい"],[86,1,"くに"],[88,2,"へいし"],[91,2,"せいねん"]]],["二人は、石碑の建っている右と左に番をしていました。いたってさびしい山でありました。そして、まれにしかその辺を旅する人影は見られなかったのです。",[[0,2,"1582670"],[4,2,"1382780"],[7,2,"1597045"],[10,2,"1577980"],[12,1,"1171010"],[14,1,"1290800"],[16,1,"2022640"],[18,1,"1157170"],[20,1,"1577980"],[25,4,"1311850"],[29,4,"1579720"],[33,1,"1302680"],[35,2,"1296400"],[41,3,"1006730"],[45,2,"1604280"],[50,3,"2600500"],[54,3,"1854270"],[57,2,"1580660"],[60,1,"1259290"]],[[0,2,"ふたり"],[4,2,"せきひ"],[7,1,"た"],[12,1,"みぎ"],[14,1,"ひだり"],[16,1,"ばん"],[33,1,"やま"],[52,1,"へん"],[54,1,"たび"],[57,2,"ひとかげ"],[60,1,"み"]]],["初め、たがいに顔を知り合わない間は、二人は敵か味方かというような感じがして、ろくろくものもいいませんでしたけれど、いつしか二人は仲よしになってしまいました。二人は、ほかに話をする相手もなく退屈であったからであります。そ