],[45,2,"ことし"],[48,2,"いちにち"],[51,2,"たう"],[55,1,"お"],[59,1,"かんが"]]],["その日の昼、近くの山からサルが来ました。お母さんのサルと子どものサルでした。一人の女の人がサルを見つけました。そして「サルだ、サルだ」と大きい声で言いました。",[[0,3,"2002320"],[4,1,"1426250"],[6,2,"1242160"],[9,1,"1302680"],[12,2,"1177390"],[15,1,"1547720"],[20,4,"1002650"],[25,2,"1177390"],[28,3,"1307850"],[32,2,"1177390"],[38,2,"1576150"],[41,1,"1344930"],[43,1,"1580640"],[45,2,"1177390"],[48,3,"1604570"],[55,3,"1006730"],[59,2,"1177390"],[63,2,"1177390"],[68,3,"1588880"],[71,1,"1380440"],[73,2,"1587040"]],[[2,1,"ひ"],[4,1,"ひる"],[6,1,"ちか"],[9,1,"やま"],[15,1,"き"],[21,1,"かあ"],[28,1,"こ"],[38,2,"ひとり"],[41,1,"おんな"],[43,1,"ひと"],[48,1,"み"],[68,1,"おお"],[71,1,"こえ"],[73,1,"い"]]],["サルはびっくりして走り始めました。みんなは、サルが遠くの山に帰るまで見ていました。サルを見たのは少しの時間でした。しかし、仕事は大きく遅れました。",[[0,2,"1177390"],[3,4,"1226360"],[7,1,"1157170"],[9,2,"1402540"],[11,2,"1307550"],[17,3,"1202150"],[22,2,"1177390"],[25,2,"1177820"],[28,1,"1302680"],[30,2,"1221270"],[34,1,"1259290"],[36,1,"1577980"],[41,2,"1177390"],[44,1,"1259290"],[48,2,"1348870"],[51,2,"1315920"],[57,3,"1505990"],[61,2,"1304970"],[64,3,"1588880"],[67,2,"1589040"]],[[9,1,"はし"],[11,1,"はじ"],[25,1,"とお"],[28,1,"やま"],[30,1,"かえ"],[34,1,"み"],[44,1,"み"],[48,1,"すこ"],[51,2,"じかん"],[61,2,"しごと"],[64,1,"おお"],[67,1,"おく"]]],["夕方、長者が田んぼに来たとき、田植えは、まだ終わっていませんでした。長者は青くなりました。「家の決まりは一日で田植えを終えること。これでは今年は田植えが終わらない」",[[0,2,"1542790"],[3,2,"1430000"],[6,3,"1442840"],[10,1,"1547720"],[12,2,"1315840"],[15,3,"1442810"],[20,2,"1527110"],[22,3,"1589600"],[26,1,"1577980"],[34,2,"1430000"],[37,4,"2119570"],[46,1,"1191730"],[48,3,"1609660"],[52,2,"1576260"],[55,3,"1442810"],[59,3,"1332760"],[62,2,"1241450"],[65,2,"1628530"],[69,2,"1579130"],[72,3,"1442810"],[76,3,"1589600"]],[[0,2,"ゆうがた"],[3,2,"ちょうじゃ"],[6,1,"た"],[10,1,"き"],[15,2,"たう"],[22,1,"お"],[34,2,"ちょうじゃ"],[37,1,"あお"],[46,1,"いえ"],[48,1,"き"],[52,2,"いちにち"],[55,2,"たう"],[59,1,"お"],[69,2,"ことし"],[72,2,"たう"],[76,1,"お"]]],["「よし、お日さまをもどして、夜になるのを遅くしよう」と言いました。長者は家から金のおうぎを持ってきました。",[[1,2,"1541760"],[4,4,"1270570"],[9,3,"1535850"],[14,1,"1536350"],[16,2,"1