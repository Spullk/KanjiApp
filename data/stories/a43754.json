[["二人の若い紳士が、すっかりイギリスの兵隊のかたちをして、ぴかぴかする鉄砲をかついで、白熊のような犬を二疋つれて、だいぶ山奥の、木の葉のかさかさしたとこを、こんなことを云いながら、あるいておりました。",[[0,2,"1582670"],[3,2,"1324300"],[5,2,"1364950"],[9,4,"1006110"],[18,2,"1506590"],[21,3,"1250220"],[25,1,"1157170"],[28,4,"1010830"],[32,2,"1157170"],[34,2,"1438010"],[37,3,"1418140"],[42,2,"1841670"],[45,2,"1605845"],[48,1,"1258330"],[51,1,"1583370"],[52,2,"1559290"],[56,3,"1414920"],[59,2,"1302750"],[63,3,"1534560"],[67,4,"1037130"],[71,1,"1157170"],[73,2,"1349370"],[77,3,"1004880"],[80,2,"1241450"],[83,2,"1587040"],[89,3,"1514320"],[93,2,"1577985"]],[[0,2,"ふたり"],[3,1,"わか"],[5,2,"しんし"],[18,2,"へいたい"],[34,2,"てっぽう"],[42,2,"しろくま"],[48,1,"いぬ"],[50,1,"に"],[51,1,"ひき"],[59,2,"やまおく"],[63,3,"このは"],[83,1,"い"]]],["「ぜんたい、ここらの山は怪しからんね。鳥も獣も一疋も居やがらん。なんでも構わないから、早くタンタアーンと、やって見たいもんだなあ。」",[[1,4,"1395660"],[6,3,"1631880"],[10,1,"1302680"],[12,4,"1586700"],[19,1,"1430250"],[21,1,"1335590"],[23,2,"1166060"],[26,1,"1577980"],[32,2,"2846738"],[36,2,"1279680"],[43,2,"1404975"],[53,2,"1012980"],[56,1,"1259290"],[59,2,"1584800"]],[[10,1,"やま"],[12,1,"け"],[19,1,"とり"],[21,1,"けもの"],[23,2,"いちひき"],[26,1,"い"],[36,1,"かま"],[43,1,"はや"],[56,1,"み"]]],["「鹿の黄いろな横っ腹なんぞに、二三発お見舞もうしたら、ずいぶん痛快だろうねえ。くるくるまわって、それからどたっと倒れるだろうねえ。」",[[1,1,"1319030"],[3,3,"1576760"],[7,3,"1180600"],[17,1,"1477120"],[18,3,"1001870"],[21,2,"1012480"],[23,1,"1157170"],[27,4,"1372800"],[31,2,"1432750"],[39,4,"1003960"],[43,3,"1604300"],[48,2,"1006970"],[52,3,"2869537"],[56,3,"1445790"]],[[1,1,"しか"],[3,1,"き"],[7,3,"よこっぱら"],[15,2,"にさん"],[17,1,"はつ"],[19,2,"みまい"],[31,2,"つうかい"],[56,1,"たお"]]],["それはだいぶの山奥でした。案内してきた専門の鉄砲打ちも、ちょっとまごついて、どこかへ行ってしまったくらいの山奥でした。",[[0,2,"1006970"],[3,3,"1414920"],[7,2,"1302750"],[13,2,"1154860"],[15,1,"1157170"],[17,1,"1547720"],[19,2,"1389880"],[22,2,"1438010"],[24,2,"2859852"],[28,4,"1163940"],[32,4,"1012100"],[38,2,"1577140"],[42,2,"1578850"],[45,3,"1305380"],[53,2,"1302750"]],[[7,2,"やまおく"],[13,2,"あんない"],[19,2,"せんもん"],[22,2,"てっぽう"],[24,1,"う"],[42,1,"い"],[53,2,"やまおく"]]],["それに、あんまり山が物凄いので、その白熊のような犬が、二疋いっしょにめまいを起こして、しばらく吠って、それから泡を吐いて死んでしまいました。",[[0,2,"1006970"],[4,4,"1584930"],[8,1,"1302680"],[10,3,"1502630"],[16,2,"1006830"],[18,2,"1841670"],[21,2,"1605845"],[24,1,"1258330"],[28,1,"1583370"],[29,4,"1163400"],[34,3,"1569810"],[38,3,"1223660"],[43,4,"1304420"],[51,2,"1006970"],[55,1,"1517510"],[57,2,"2646460"],[60,2,"1310730"],[63,3,"1305380"]],[[8,1,"やま"],[10,2,"ものすご"],[18,2,"しろくま"],[24,1,"いぬ"],[27,1,"に"],[28,1,"ひき"],[38,1,"お"],[47,1,"うな"],[55,1,"あわ"],[57,1,"は"],[60,1,"し"]]],["「じつにぼくは、二千四百円の損害だ」と一人の紳士が、その犬の眼ぶたを、ちょっとかえしてみて言いました。",[[1,2,"1320800"],[4,2,"1521400"],[12,1,"1175570"],[14,2,"1406710"],[19,2,"1576150"],[22,2,"1364950"],[26,2,"1006830"],[28,1,"1258330"],[30,3,"1569920"],[35,4,"1163940"],[39,3,"1512130"],[43,1,"1259290"],[45,2,"1587040"]],[[8,4,"にせんよんひゃく"],[12,1,"えん"],[14,2,"そんがい"],[19,2,"ひとり"],[22,2,"しんし"],[28,1,"いぬ"],[30,1,"ま"],[45,1,"い"]]],["「ぼくは二千八百円の損害だ。」と、もひとりが、くやしそうに、あたまをまげて言いました。",[[1,2,"1521400"],[8,1,"1175570"],[10,2,"1406710"],[18,3,"1576150"],[23,3,"1592350"],[26,2,"1241450"],[30,3,"1582310"],[37,2,"1587040"]],[[4,4,"にせんはちひゃく"],[8,1,"えん"],[10,2,"そんがい"],[37,1,"い"]]],["はじめの紳士は、すこし顔いろを悪くして、じっと、もひとりの紳士の、顔つきを見ながら云いました。",[[0,3,"1342540"],[4,2,"1364950"],[8,3,"1348870"],[11,3,"1217820"],[15,2,"1151260"],[17,1,"1157170"],[20,3,"1005870"],[25,3,"1576150"],[29,2,"1364950"],[33,3,"1217850"],[37,1,"1259290"],[41,2,"1587040"]],[[4,2,"しんし"],[11,1,"かお"],[15,1,"わる"],[29,2,"しんし"],[33,1,"かお"],[37,1,"み"],[41,1,"い"]]],["「ぼくはもう戻ろうとおもう。」",[[1,2,"1521400"],[4,2,"1012480"],[6,3,"1535880"],[10,3,"1589350"]],[[6,1,"もど"]]],["「さあ、ぼくもちょうど寒くはなったし腹は空いてきたし戻ろうとおもう。」",[[1,2,"1005110"],[4,2,"1521400"],[7,4,"1427340"],[11,2,"1210360"],[14,2,"1375610"],[18,1,"1501110"],[20,2,"1586270"],[23,1,"1547720"],[26,3,"1535880"],[30,3,"1589350"]],[[11,1,"さむ"],[18,1,"はら"],[20,1,"す"],[26,1,"もど"]]],["「そいじゃ、これで切りあげよう。なあに戻りに、昨日の宿屋で、山鳥を拾円も買って帰ればいい。」",[[1,2,"1006970"],[6,2,"1628530"],[9,6,"1384300"],[16,3,"1577100"],[19,2,"1535880"],[23,2,"1579260"],[26,2,"1337230"],[30,2,"1755480"],[34,1,"1175570"],[36,2,"1473740"],[39,2,"1221270"],[42,2,"1605820"]],[[9,1,"き"],[19,1,"もど"],[23,2,"きのう"],[26,2,"やどや"],[30,2,"やまどり"],[33,2,"じゅうえん"],[36,1,"か"],[39,1,"かえ"]]],["「兎もでていたねえ。そうすれば結局おんなじこった。では帰ろうじゃないか」",[[1,1,"1443970"],[3,1,"1338240"],[5,1,"1577980"],[10,4,"1925750"],[15,2,"1254730"],[17,4,"1451750"],[21,2,"1239070"],[27,3,"1221270"],[32,2,"1529520"]],[[1,1,"うさぎ"],[15,2,"けっきょく"],[27,1,"かえ"]]],["ところがどうも困ったことは、どっちへ行けば戻れるのか、いっこうに見当がつかなくなっていました。",[[0,3,"1343100"],[4,2,"1451160"],[7,2,"1289590"],[10,2,"1241450"],[14,3,"1189360"],[18,2,"1578850"],[21,3,"1535880"],[27,4,"1162410"],[32,2,"1259930"],[35,2,"1495740"],[39,2,"1375610"],[42,1,"1577980"]],[[7,1,"こま"],[18,1,"い"],[21,1,"もど"],[32,2,"けんとう"]]],["風がどうと吹いてきて、草はざわざわ、木の葉はかさかさ、木はごとんごとんと鳴りました。",[[0,1,"1499720"],[2,2,"1451160"],[5,2,"1370760"],[8,1,"1547720"],[11,1,"1401910"],[13,4,"1005430"],[18,3,"1534560"],[22,4,"1037130"],[27,1,"1534520"],[29,3,"2845354"],[32,3,"2845354"],[36,2,"1532910"]],[[0,1,"かぜ"],[5,1,"ふ"],[11,1,"くさ"],[18,3,"このは"],[27,1,"き"],[36,1,"な"]]],["「どうも腹が空いた。さっきから横っ腹が痛くてたまらないんだ。」",[[1,2,"1451160"],[4,1,"1501110"],[6,2,"1586270"],[10,3,"1005180"],[15,3,"1180600"],[19,2,"1432680"],[22,3,"1552650"]],[[4,1,"はら"],[6,1,"あ"],[15,3,"よこっぱら"],[19,1,"いた"]]],["「ぼくもそうだ。もうあんまりあるきたくないな。」",[[1,2,"1521400"],[4,2,"1241450"],[8,2,"1012480"],[10,4,"1584930"],[14,3,"1514320"],[19,2,"1529520"]],[]],["「あるきたくないよ。ああ困ったなあ、何かたべたいなあ。」",[[1,3,"1514320"],[6,2,"1529520"],[10,2,"1565440"],[12,2,"1289590"],[18,1,"2846738"],[20,2,"1358280"]],[[12,1,"こま"],[18,1,"なん"]]],["「喰べたいもんだなあ」",[[1,2,"1358280"],[5,2,"1584800"]],[[1,1,"た"]]],["二人の紳士は、ざわざわ鳴るすすきの中で、こんなことを云いました。",[[0,2,"1582670"],[3,2,"1364950"],[7,4,"1005430"],[11,2,"1532910"],[13,3,"1475470"],[17,1,"1423310"],[20,3,"1004880"],[23,2,"1241450"],[26,2,"1587040"]],[[0,2,"ふたり"],[3,2,"しんし"],[11,1,"な"],[17,1,"なか"],[26,1,"い"]]],["その時ふとうしろを見ますと、立派な一軒の西洋造りの家がありました。",[[0,3,"2002300"],[3,2,"1493240"],[5,3,"1269410"],[9,1,"1259290"],[14,2,"1551790"],[17,2,"1162190"],[20,2,"1381100"],[22,2,"1297250"],[25,1,"1191730"],[27,2,"1296400"]],[[2,1,"とき"],[9,1,"み"],[14,2,"りっぱ"],[17,2,"いっけん"],[20,2,"せいよう"],[22,1,"つく"],[25,1,"いえ"]]],["そして玄関には",[[0,3,"1006730"],[3,2,"1263400"]],[[3,2,"げんかん"]]],["RESTAURANT",[[0,10,"1145310"]],[]],["西洋料理店",[[0,2,"1381100"],[2,3,"1554330"]],[[0,2,"せいよう"],[2,3,"りょうりてん"]]],["WILDCAT HOUSE",[[8,5,"1095670"]],[]],["山猫軒",[[0,2,"1303100"],[2,1,"1260330"]],[[0,2,"やまねこ"],[2,1,"けん"]]],["という札がでていました。",[[1,2,"1587040"],[3,1,"1298960"],[5,1,"1338240"],[7,1,"1577980"]],[[3,1,"さつ"]]],["「君、ちょうどいい。ここはこれでなかなか開けてるんだ。入ろうじゃないか」",[[1,1,"1247250"],[3,6,"2276090"],[10,2,"1288810"],[13,2,"1628530"],[16,4,"1599420"],[20,2,"1202450"],[27,3,"1465590"],[32,2,"1529520"]],[[1,1,"きみ"],[20,1,"あ"],[27,1,"はい"]]],["「おや、こんなとこにおかしいね。しかしとにかく何か食事ができるんだろう」",[[1,2,"1365040"],[4,3,"1004880"],[7,2,"1349370"],[10,4,"1190860"],[16,3,"1505990"],[19,4,"1443990"],[23,1,"2846738"],[25,2,"1358490"],[28,3,"1340450"]],[[23,1,"なん"],[25,2,"しょくじ"]]],["「もちろんできるさ。看板にそう書いてあるじゃないか」",[[1,4,"1535780"],[5,3,"1340450"],[10,2,"1213990"],[13,2,"1241450"],[15,2,"1343950"],[18,2,"1296400"],[22,2,"1529520"]],[[10,2,"かんばん"],[15,1,"か"]]],["「はいろうじゃないか。ぼくはもう何か喰べたくて倒れそうなんだ。」",[[1,4,"1465590"],[7,2,"1529520"],[11,2,"1521400"],[14,2,"1012480"],[16,1,"2846738"],[18,2,"1358280"],[23,2,"1445790"],[25,2,"1241450"]],[[16,1,"なん"],[18,1,"た"],[23,1,"たお"]]],["二人は玄関に立ちました。玄関は白い瀬戸の煉瓦で組んで、実に立派なもんです。",[[0,2,"1582670"],[3,2,"1263400"],[6,2,"1597040"],[12,2,"1263400"],[15,2,"1474910"],[20,2,"1559090"],[23,2,"1397590"],[27,1,"1320800"],[29,2,"1551790"],[32,2,"1584800"]],[[0,2,"ふたり"],[3,2,"げんかん"],[6,1,"た"],[12,2,"げんかん"],[15,1,"しろ"],[17,2,"せと"],[20,2,"れんが"],[23,1,"く"],[27,1,"じつ"],[29,2,"りっぱ"]]],["そして硝子の開き戸がたって、そこに金文字でこう書いてありました。",[[0,3,"1006730"],[3,2,"1040380"],[6,3,"1632940"],[10,2,"1629170"],[14,2,"1436050"],[17,3,"1681960"],[21,2,"1578760"],[23,2,"1343950"],[26,2,"1296400"]],[[3,2,"がらす"],[6,3,"ひらきど"],[17,3,"きんもじ"],[23,1,"か"]]],["「どなたもどうかお入りください。決してご遠慮はありません」",[[1,3,"1189370"],[5,2,"1451160"],[9,2,"1465590"],[11,4,"1184280"],[16,3,"1254130"],[20,2,"1178450"],[23,2,"1296400"]],[[9,1,"はい"],[16,1,"けっ"],[20,2,"えんりょ"]]],["二人はそこで、ひどくよろこんで言いました。",[[0,2,"1582670"],[3,2,"1436050"],[7,3,"1602060"],[10,4,"1218760"],[15,2,"1587040"]],[[0,2,"ふたり"],[15,1,"い"]]],["「こいつはどうだ、やっぱり世の中はうまくできてるねえ、きょう一日なんぎしたけれど、こんどはこんないいこともある。このうちは料理店だけれどもただでご馳走するんだぜ。」",[[1,3,"1579070"],[5,2,"1451160"],[9,4,"2772770"],[13,3,"1373850"],[17,3,"1310460"],[20,2,"1340450"],[27,3,"1579110"],[30,2,"1576260"],[32,3,"1460910"],[35,1,"1157170"],[41,3,"1289370"],[45,3,"1004880"],[48,4,"2823360"],[53,2,"1296400"],[56,4,"2232980"],[61,3,"1554330"],[69,2,"1538900"],[72,3,"1593590"],[75,2,"1157170"]],[[13,3,"よのなか"],[30,2,"いちにち"],[61,3,"りょうりてん"],[73,2,"ちそう"]]],["「どうもそうらしい。決してご遠慮はありませんというのはその意味だ。」",[[1,2,"1451160"],[4,2,"1241450"],[10,3,"1254130"],[14,2,"1178450"],[17,2,"1296400"],[23,2,"1587040"],[27,2,"1006830"],[29,2,"1156800"]],[[10,1,"けっ"],[14,2,"えんりょ"],[29,2,"いみ"]]],["二人は戸を押して、なかへ入りました。そこはすぐ廊下になっていました。その硝子戸の裏側には、金文字でこうなっていました。",[[0,2,"1582670"],[3,1,"1266970"],[5,2,"1180470"],[9,2,"1423310"],[12,2,"1465590"],[18,2,"1436050"],[21,2,"1430610"],[23,2,"1560670"],[26,2,"1375610"],[29,1,"1577980"],[34,2,"1006830"],[36,3,"1610800"],[40,2,"1550410"],[45,3,"1681960"],[49,2,"1578760"],[51,2,"1375610"],[54,1,"1577980"]],[[0,2,"ふたり"],[3,1,"と"],[5,1,"お"],[12,1,"はい"],[23,2,"ろうか"],[36,3,"がらすど"],[40,2,"うらがわ"],[45,3,"きんもじ"]]],["「ことに肥ったお方や若いお方は、大歓迎いたします」",[[1,2,"1241450"],[4,2,"1408220"],[7,2,"2060470"],[10,2,"1324300"],[12,2,"2060470"],[16,3,"1892230"],[19,3,"1421900"]],[[4,1,"ふと"],[8,1,"かた"],[10,1,"わか"],[13,1,"かた"],[16,3,"だいかんげい"]]],["二人は大歓迎というので、もう大よろこびです。",[[0,2,"1582670"],[3,3,"1892230"],[7,2,"1587040"],[12,2,"1012480"],[14,5,"1413310"]],[[0,2,"ふたり"],[3,3,"だいかんげい"],[14,1,"おお"]]],["「君、ぼくらは大歓迎にあたっているのだ。」",[[1,1,"1247250"],[3,3,"1521410"],[7,3,"1892230"],[11,3,"1448810"],[15,2,"1577980"]],[[1,1,"きみ"],[7,3,"だいかんげい"]]],["「ぼくらは両方兼ねてるから」",[[1,3,"1521410"],[5,2,"1554010"],[7,2,"1256520"]],[[5,2,"りょうほう"],[7,1,"か"]]],["ずんずん廊下を進んで行きますと、こんどは水いろのペンキ塗りの扉がありました。",[[0,4,"1006470"],[4,2,"1560670"],[7,2,"1365980"],[10,2,"1578850"],[16,3,"1289370"],[20,3,"1371670"],[24,5,"2080930"],[30,1,"1483380"],[32,2,"1296400"]],[[4,2,"ろうか"],[7,1,"すす"],[10,1,"い"],[20,1,"みず"],[27,1,"ぬ"],[30,1,"と"]]],["「どうも変な家だ。どうしてこんなにたくさん戸があるのだろう。」",[[1,2,"1451160"],[4,1,"1510640"],[6,1,"1191730"],[9,2,"1451160"],[11,1,"1157170"],[13,3,"1004880"],[17,4,"1415870"],[21,1,"1266970"],[23,2,"1296400"]],[[4,1,"へん"],[6,1,"うち"],[21,1,"と"]]],["「これはロシア式だ。寒いとこや山の中はみんなこうさ。」",[[1,2,"1628530"],[7,1,"1319060"],[10,2,"1210360"],[12,2,"1349370"],[15,1,"1302680"],[17,1,"1423310"],[19,3,"1202150"],[22,2,"1578760"]],[[7,1,"しき"],[10,1,"さむ"],[15,1,"やま"],[17,1,"なか"]]],["そして二人はその扉をあけようとしますと、上に黄いろな字でこう書いてありました。",[[0,3,"1006730"],[3,2,"1582670"],[6,2,"1006830"],[8,1,"1483380"],[10,4,"1202450"],[15,1,"1157170"],[20,1,"1352130"],[22,3,"1576760"],[26,1,"1315130"],[28,2,"1578760"],[30,2,"1343950"],[33,2,"1296400"]],[[3,2,"ふたり"],[8,1,"とびら"],[20,1,"うえ"],[22,1,"き"],[26,1,"じ"],[30,1,"か"]]],["「当軒は注文の多い料理店ですからどうかそこはご承知ください」",[[1,1,"2081170"],[2,1,"1260330"],[4,2,"1426650"],[7,2,"1407460"],[9,3,"1554330"],[16,2,"1451160"],[19,2,"1436050"],[25,4,"1184280"]],[[1,1,"とう"],[2,1,"けん"],[4,2,"ちゅうもん"],[7,1,"おお"],[9,3,"りょうりてん"],[23,2,"しょうち"]]],["「なかなかはやってるんだ。こんな山の中で。」",[[1,4,"1599420"],[5,3,"1552310"],[13,3,"1004880"],[16,1,"1302680"],[18,1,"1423310"]],[[16,1,"やま"],[18,1,"なか"]]],["「それあそうだ。見たまえ、東京の大きな料理屋だって大通りにはすくないだろう」",[[1,2,"1006970"],[3,1,"1565440"],[4,2,"1241450"],[8,1,"1259290"],[10,2,"1392580"],[16,3,"1412890"],[19,3,"1554320"],[25,3,"1414570"],[30,4,"1348910"]],[[8,1,"み"],[13,2,"とうきょう"],[16,1,"おお"],[19,3,"りょうりや"],[25,2,"おおどお"]]],["二人は云いながら、その扉をあけました。するとその裏側に、",[[0,2,"1582670"],[3,2,"1587040"],[9,2,"1006830"],[11,1,"1483380"],[13,2,"1202450"],[19,2,"1157170"],[22,2,"1006830"],[24,2,"1550410"]],[[0,2,"ふたり"],[3,1,"い"],[11,1,"とびら"],[24,2,"うらがわ"]]],["「注文はずいぶん多いでしょうがどうか一々こらえて下さい。」",[[1,2,"1426650"],[4,4,"1372800"],[8,2,"1407460"],[15,2,"1451160"],[18,2,"1587320"],[20,3,"2827352"],[24,3,"1184280"]],[[1,2,"ちゅうもん"],[8,1,"おお"],[18,2,"いちいち"],[24,1,"くだ"]]],["「これはぜんたいどういうんだ。」ひとりの紳士は顔をしかめました。",[[1,2,"1628530"],[4,4,"1395660"],[8,4,"1008920"],[16,3,"1576150"],[20,2,"1364950"],[23,1,"1217730"],[25,3,"1574340"]],[[20,2,"しんし"],[23,1,"かお"]]],["「うん、これはきっと注文があまり多くて支度が手間取るけれどもごめん下さいと斯ういうことだ。」",[[1,2,"1172610"],[4,2,"1628530"],[7,3,"1003430"],[10,2,"1426650"],[13,3,"1584930"],[16,2,"1407460"],[19,2,"1310260"],[22,4,"1327420"],[30,3,"1270670"],[33,3,"1184280"],[37,2,"1004310"],[39,2,"1587040"],[41,2,"1241450"]],[[10,2,"ちゅうもん"],[16,1,"おお"],[19,2,"したく"],[22,3,"てまど"],[33,1,"くだ"],[37,1,"こ"]]],["「そうだろう。早くどこか室の中にはいりたいもんだな。」",[[1,2,"1241450"],[7,2,"1404975"],[9,2,"1577140"],[12,1,"1320310"],[14,1,"1423310"],[16,3,"1465590"],[21,2,"1584800"]],[[7,1,"はや"],[12,1,"へや"],[14,1,"なか"]]],["「そしてテーブルに座りたいもんだな。」",[[1,3,"1006730"],[4,4,"1078630"],[9,2,"1291800"],[13,2,"1584800"]],[[9,1,"すわ"]]],["ところがどうもうるさいことは、また扉が一つありました。そしてそのわきに鏡がかかって、その下には長い柄のついたブラシが置いてあったのです。",[[0,3,"1343100"],[4,2,"1451160"],[7,4,"1481920"],[11,2,"1241450"],[15,2,"1524930"],[17,1,"1483380"],[19,2,"1160820"],[21,2,"1296400"],[27,3,"1006730"],[30,2,"1006830"],[32,2,"1562530"],[35,1,"1238550"],[37,3,"1207590"],[42,2,"1006830"],[44,1,"1184140"],[47,2,"1429750"],[49,1,"1508300"],[51,2,"1495740"],[54,3,"1611450"],[58,2,"1421850"],[61,2,"1296400"]],[[17,1,"とびら"],[19,1,"ひと"],[35,1,"かがみ"],[44,1,"した"],[47,1,"なが"],[49,1,"え"],[58,1,"お"]]],["扉には赤い字で、",[[0,1,"1483380"],[3,2,"1383240"],[5,1,"1315130"]],[[0,1,"とびら"],[3,1,"あか"],[5,1,"じ"]]],["「お客さまがた、ここで髪をきちんとして、それからはきもの",[[1,4,"1001770"],[5,2,"2253290"],[8,2,"1288810"],[11,1,"1477950"],[13,4,"1003400"],[17,1,"1157170"],[20,2,"1006970"],[24,4,"1600680"]],[[2,1,"きゃく"],[11,1,"かみ"]]],["の泥を落してください。」",[[1,1,"1436900"],[3,2,"1589260"],[6,4,"1184280"]],[[1,1,"どろ"],[3,1,"おと"]]],["と書いてありました。",[[1,2,"1343950"],[4,2,"1296400"]],[[1,1,"か"]]],["「これはどうも尤もだ。僕もさっき玄関で、山のなかだとおもって見くびったんだよ」",[[1,2,"1628530"],[4,2,"1451160"],[7,2,"1293700"],[11,1,"1521400"],[13,3,"1005180"],[16,2,"1263400"],[20,1,"1302680"],[22,2,"1423310"],[26,3,"1589350"],[30,4,"1259170"]],[[7,1,"もっと"],[11,1,"ぼく"],[16,2,"げんかん"],[20,1,"やま"],[30,1,"み"]]],["「作法の厳しい家だ。きっとよほど偉い人たちが、たびたび来るんだ。」",[[1,2,"1297980"],[4,3,"1262530"],[7,1,"1191730"],[10,3,"1003430"],[13,3,"1605980"],[16,3,"1155800"],[19,2,"1416220"],[23,4,"1597160"],[27,2,"1547720"]],[[1,2,"さほう"],[4,1,"きび"],[7,1,"いえ"],[16,1,"えら"],[27,1,"く"]]],["そこで二人は、きれいに髪をけずって、靴の泥を落しました。",[[0,2,"1436050"],[3,2,"1582670"],[7,3,"1591900"],[11,1,"1477950"],[13,3,"1298090"],[18,1,"1246700"],[20,1,"1436900"],[22,2,"1589260"]],[[3,2,"ふたり"],[11,1,"かみ"],[18,1,"くつ"],[20,1,"どろ"],[22,1,"おと"]]],["そしたら、どうです。ブラシを板の上に置くや否や、そいつがぼうっとかすんで無くなって、風がどうっと室の中に入ってきました。",[[0,1,"1241450"],[1,1,"1157170"],[5,2,"1451160"],[10,3,"1611450"],[14,1,"1481350"],[16,1,"1352130"],[18,2,"1421850"],[21,1,"2857381"],[24,3,"1006600"],[28,4,"1011760"],[32,3,"1196520"],[36,4,"1529550"],[42,1,"1499720"],[44,4,"1009210"],[48,1,"1320310"],[50,1,"1423310"],[52,2,"1465590"],[55,1,"1547720"]],[[14,1,"いた"],[16,1,"うえ"],[18,1,"お"],[21,1,"いな"],[36,1,"な"],[42,1,"かぜ"],[48,1,"むろ"],[50,1,"なか"],[52,1,"はい"]]],["二人はびっくりして、互によりそって、扉をがたんと開けて、次の室へ入って行きました。早く何か暖いものでもたべて、元気をつけて置かないと、もう途方もないことになってしまうと、二人とも思ったのでした。",[[0,2,"1582670"],[3,4,"1226360"],[7,1,"1157170"],[10,1,"1268770"],[12,4,"1219640"],[18,1,"1483380"],[20,3,"2101860"],[24,2,"1202450"],[28,1,"1316380"],[30,1,"1320310"],[32,2,"1465590"],[35,2,"1578850"],[41,2,"1404975"],[43,1,"2846738"],[45,2,"1586420"],[47,2,"1502390"],[51,2,"1358280"],[55,2,"1260720"],[58,2,"1433680"],[61,2,"1421850"],[67,2,"1012480"],[69,2,"1444930"],[72,2,"1529520"],[74,2,"1241450"],[77,2,"1375610"],[80,3,"1305380"],[85,2,"1582670"],[89,2,"1589350"]],[[0,2,"ふたり"],[10,1,"たがい"],[18,1,"とびら"],[24,1,"あ"],[28,1,"つぎ"],[30,1,"むろ"],[32,1,"はい"],[35,1,"い"],[41,1,"はや"],[43,1,"なん"],[45,1,"あたたか"],[55,2,"げんき"],[61,1,"お"],[69,2,"とほう"],[85,2,"ふたり"],[89,1,"おも"]]],["扉の内側に、また変なことが書いてありました。",[[0,1,"1483380"],[2,2,"1458770"],[6,2,"1524930"],[8,1,"1510640"],[10,2,"1241450"],[13,2,"1343950"],[16,2,"1296400"]],[[0,1,"とびら"],[2,2,"うちがわ"],[8,1,"へん"],[13,1,"か"]]],["「鉄砲と弾丸をここへ置いてください。」",[[1,2,"1438010"],[4,2,"1419440"],[7,2,"1288810"],[10,2,"1421850"],[13,4,"1184280"]],[[1,2,"てっぽう"],[4,2,"たま"],[10,1,"お"]]],["見るとすぐ横に黒い台がありました。",[[0,2,"1259290"],[3,2,"1430610"],[5,1,"1180570"],[7,2,"1287420"],[9,1,"1412560"],[11,2,"1296400"]],[[0,1,"み"],[5,1,"よこ"],[7,1,"くろ"],[9,1,"だい"]]],["「なるほど、鉄砲を持ってものを食うという法はない。」",[[1,4,"1375820"],[6,2,"1438010"],[9,2,"1315720"],[12,2,"1502390"],[15,2,"1592100"],[18,2,"1587040"],[20,1,"1517150"],[22,2,"1529520"]],[[6,2,"てっぽう"],[9,1,"も"],[15,1,"く"],[20,1,"ほう"]]],["「いや、よほど偉いひとが始終来ているんだ。」",[[1,2,"2857380"],[4,3,"1605980"],[7,2,"1155780"],[9,2,"1580640"],[12,2,"1307570"],[14,1,"1547720"],[16,2,"1577980"]],[[7,1,"えら"],[12,2,"しじゅう"],[14,1,"き"]]],["二人は鉄砲をはずし、帯皮を解いて、それを台の上に置きました。",[[0,2,"1582670"],[3,2,"1438010"],[6,3,"1203270"],[10,2,"1608690"],[13,2,"1198890"],[17,2,"1006970"],[20,1,"1412560"],[22,1,"1352130"],[24,2,"1421850"]],[[0,2,"ふたり"],[3,2,"てっぽう"],[10,2,"おびかわ"],[13,1,"と"],[20,1,"だい"],[22,1,"うえ"],[24,1,"お"]]],["また黒い扉がありました。",[[0,2,"1524930"],[2,2,"1287420"],[4,1,"1483380"],[6,2,"1296400"]],[[2,1,"くろ"],[4,1,"とびら"]]],["「どうか帽子と外套と靴をおとり下さい。」",[[1,2,"1451160"],[4,2,"1519170"],[7,2,"1632950"],[10,1,"1246700"],[12,3,"1558400"],[15,3,"1184280"]],[[4,2,"ぼうし"],[7,2,"がいとう"],[10,1,"くつ"],[15,1,"くだ"]]],["「どうだ、とるか。」",[[1,2,"1451160"],[5,2,"1326980"]],[]],["「仕方ない、とろう。たしかによっぽどえらいひとなんだ。奥に来ているのは」",[[1,4,"1305440"],[6,3,"1326980"],[10,3,"1596930"],[14,4,"1605980"],[18,5,"1155800"],[27,1,"1179320"],[29,1,"1547720"],[31,2,"1577980"]],[[1,2,"しかた"],[27,1,"おく"],[29,1,"き"]]],["二人は帽子とオーバーコートを釘にかけ、靴をぬいでぺたぺたあるいて扉の中にはいりました。",[[0,2,"1582670"],[3,2,"1519170"],[6,7,"1032880"],[14,1,"1436840"],[16,2,"1570710"],[19,1,"1246700"],[21,2,"1416400"],[24,4,"2121730"],[28,3,"1514320"],[32,1,"1483380"],[34,1,"1423310"],[36,3,"1465590"]],[[0,2,"ふたり"],[3,2,"ぼうし"],[14,1,"くぎ"],[19,1,"くつ"],[32,1,"とびら"],[34,1,"なか"]]],["扉の裏側には、",[[0,1,"1483380"],[2,2,"1550410"]],[[0,1,"とびら"],[2,2,"うらがわ"]]],["「ネクタイピン、カフスボタン、眼鏡、財布、その他金物類、",[[1,6,"1092830"],[8,6,"1038180"],[15,2,"1577670"],[18,2,"1296970"],[21,3,"1006900"],[24,2,"1243160"],[26,1,"1556040"]],[[15,2,"めがね"],[18,2,"さいふ"],[23,1,"た"],[24,2,"かなもの"],[26,1,"るい"]]],["ことに尖ったものは、みんなここに置いてください」",[[0,2,"1241450"],[3,2,"1389970"],[6,2,"1502390"],[10,3,"1202150"],[13,2,"1288810"],[16,2,"1421850"],[19,4,"1184280"]],[[3,1,"とが"],[16,1,"お"]]],["と書いてありました。扉のすぐ横には黒塗りの立派な金庫も、ちゃんと口を開けて置いてありました。鍵まで添えてあったのです。",[[1,2,"1343950"],[4,2,"1296400"],[10,1,"1483380"],[12,2,"1430610"],[14,1,"1180570"],[17,3,"1288000"],[21,2,"1551790"],[24,2,"1242850"],[28,4,"1007720"],[32,1,"1275640"],[34,2,"1202450"],[37,2,"1421850"],[40,2,"1296400"],[46,1,"1260490"],[49,2,"1596490"],[52,2,"1296400"]],[[1,1,"か"],[10,1,"とびら"],[14,1,"よこ"],[17,2,"くろぬ"],[21,2,"りっぱ"],[24,2,"きんこ"],[32,1,"くち"],[34,1,"あ"],[37,1,"お"],[46,1,"かぎ"],[49,1,"そ"]]],["「ははあ、何かの料理に電気をつかうと見えるね。金気のものはあぶない。ことに尖ったものはあぶないと斯う云うんだろう。」",[[1,3,"2096970"],[5,1,"2846738"],[8,2,"1554310"],[11,2,"1443000"],[14,3,"1305990"],[18,3,"1259140"],[23,2,"1633100"],[26,2,"1502390"],[29,4,"1218380"],[34,2,"1241450"],[37,2,"1389970"],[40,2,"1502390"],[43,4,"1218380"],[48,2,"1004310"],[50,2,"1587040"]],[[5,1,"なん"],[8,2,"りょうり"],[11,2,"でんき"],[18,1,"み"],[23,2,"かなけ"],[37,1,"とが"],[48,1,"こ"],[50,1,"い"]]],["「そうだろう。して見ると勘定は帰りにここで払うのだろうか。」",[[1,2,"1241450"],[7,1,"1157170"],[9,2,"1259290"],[12,2,"1210750"],[15,2,"1221250"],[18,2,"1288810"],[21,2,"1501620"]],[[9,1,"み"],[12,2,"かんじょう"],[15,1,"かえ"],[21,1,"はら"]]],["「どうもそうらしい。」",[[1,2,"1451160"],[4,2,"1241450"]],[]],["「そうだ。きっと。」",[[1,2,"1241450"],[5,3,"1003430"]],[]],["二人はめがねをはずしたり、カフスボタンをとったり、みんな金庫のなかに入れて、ぱちんと錠をかけました。",[[0,2,"1582670"],[3,3,"1577670"],[7,3,"1203270"],[13,6,"1038180"],[20,2,"1326980"],[25,3,"1202150"],[28,2,"1242850"],[31,2,"1423310"],[34,2,"1465610"],[38,3,"2523860"],[42,1,"1633480"],[44,2,"1570710"]],[[0,2,"ふたり"],[28,2,"きんこ"],[34,1,"い"],[42,1,"じょう"]]],["すこし行きますとまた扉があって、その前に硝子の壺が一つありました。扉には斯う書いてありました。",[[0,3,"1348870"],[3,2,"1578850"],[8,2,"1524930"],[10,1,"1483380"],[12,2,"1296400"],[16,2,"1006830"],[18,1,"1392580"],[20,2,"1040380"],[23,1,"1433870"],[25,2,"1160820"],[27,2,"1296400"],[33,1,"1483380"],[36,2,"1004310"],[38,2,"1343950"],[41,2,"1296400"]],[[3,1,"い"],[10,1,"と"],[18,1,"まえ"],[20,2,"がらす"],[23,1,"つぼ"],[25,1,"ひと"],[33,1,"とびら"],[36,1,"こ"],[38,1,"か"]]],["「壺のなかのクリームを顔や手足にすっかり塗ってください。」",[[1,1,"1433870"],[3,2,"1423310"],[6,4,"1044480"],[11,1,"1217730"],[13,2,"1328080"],[16,4,"1006110"],[20,2,"1444270"],[23,4,"1184280"]],[[1,1,"つぼ"],[11,1,"かお"],[13,2,"てあし"],[20,1,"ぬ"]]],["みるとたしかに壺のなかのものは牛乳のクリームでした。",[[0,2,"1259290"],[3,3,"1596930"],[7,1,"1433870"],[9,2,"1423310"],[12,2,"1502390"],[15,2,"1231590"],[18,4,"1044480"]],[[7,1,"つぼ"],[15,2,"ぎゅうにゅう"]]],["「クリームをぬれというのはどういうんだ。」",[[1,4,"1044480"],[6,2,"2847182"],[9,2,"1587040"],[13,4,"1008920"]],[]],["「これはね、外がひじょうに寒いだろう。室のなかがあんまり暖いとひびがきれるから、その予防なんだ。どうも奥には、よほどえらいひとがきている。こんなとこで、案外ぼくらは、貴族とちかづきになるかも知れないよ。」",[[1,2,"1628530"],[6,1,"1203250"],[8,4,"1484920"],[13,2,"1210360"],[19,1,"1320310"],[21,2,"1423310"],[24,4,"1584930"],[28,2,"1586420"],[31,2,"2856672"],[34,3,"1384860"],[40,2,"1006830"],[42,2,"1543660"],[48,2,"1451160"],[51,1,"1179320"],[55,3,"1605980"],[58,5,"1155800"],[64,1,"1547720"],[66,2,"1577980"],[69,3,"1004880"],[72,2,"1349370"],[76,2,"1154820"],[78,3,"1521410"],[83,2,"1223550"],[86,4,"1242170"],[91,2,"1375610"],[95,2,"1420490"]],[[6,1,"そと"],[13,1,"さむ"],[19,1,"へや"],[28,1,"あたたか"],[42,2,"よぼう"],[51,1,"おく"],[76,2,"あんがい"],[83,2,"きぞく"],[95,1,"し"]]],["二人は壺のクリームを、顔に塗って手に塗ってそれから靴下をぬいで足に塗りました。それでもまだ残っていましたから、それは二人ともめいめいこっそり顔へ塗るふりをしながら喰べました。",[[0,2,"1582670"],[3,1,"1433870"],[5,4,"1044480"],[11,1,"1217730"],[13,2,"1444270"],[16,1,"1327190"],[18,2,"1444270"],[21,2,"1006970"],[25,2,"1246740"],[28,2,"1416400"],[31,1,"1404630"],[33,2,"1444270"],[39,2,"1006970"],[43,2,"1527110"],[45,2,"1304510"],[48,1,"1577980"],[55,2,"1006970"],[58,4,"1462470"],[62,4,"1532810"],[66,4,"1004520"],[70,1,"1217730"],[72,2,"1444270"],[74,2,"1361130"],[77,1,"1157170"],[81,2,"1358280"]],[[0,2,"ふたり"],[3,1,"つぼ"],[11,1,"かお"],[13,1,"ぬ"],[16,1,"て"],[18,1,"ぬ"],[25,2,"くつした"],[31,1,"あし"],[33,1,"ぬ"],[45,1,"のこ"],[58,2,"ふたり"],[70,1,"かお"],[72,1,"ぬ"],[81,1,"た"]]],["それから大急ぎで扉をあけますと、その裏側には、",[[0,2,"1006970"],[4,3,"1413420"],[8,1,"1483380"],[10,2,"1202450"],[16,2,"1006830"],[18,2,"1550410"]],[[4,2,"おおいそ"],[8,1,"とびら"],[18,2,"うらがわ"]]],["「クリームをよく塗りましたか、耳にもよく塗りましたか、」",[[1,4,"1044480"],[6,2,"1605870"],[8,2,"1444270"],[15,1,"1317170"],[18,2,"1605870"],[20,2,"1444270"]],[[8,1,"ぬ"],[15,1,"みみ"],[20,1,"ぬ"]]],["と書いてあって、ちいさなクリームの壺がここにも置いてありました。",[[1,2,"1343950"],[4,2,"1296400"],[8,4,"2136180"],[12,4,"1044480"],[17,1,"1433870"],[19,2,"1288810"],[23,2,"1421850"],[26,2,"1296400"]],[[1,1,"か"],[17,1,"つぼ"],[23,1,"お"]]],["「そうそう、ぼくは耳には塗らなかった。あぶなく耳にひびを切らすとこだった。ここの主人はじつに用意周到だね。」",[[1,4,"1006640"],[6,2,"1521400"],[9,1,"1317170"],[12,2,"1444270"],[19,4,"1218380"],[23,1,"1317170"],[25,2,"2856672"],[28,3,"1383780"],[31,2,"1349370"],[37,2,"1288810"],[40,2,"1579780"],[43,2,"1320800"],[46,4,"1546230"]],[[9,1,"みみ"],[12,1,"ぬ"],[23,1,"みみ"],[28,1,"き"],[40,2,"しゅじん"],[48,2,"しゅうとう"]]],["「ああ、細かいとこまでよく気がつくよ。ところでぼくは早く何か喰べたいんだが、どうも斯うどこまでも廊下じゃ仕方ないね。」",[[1,2,"1565440"],[4,3,"1295530"],[7,2,"1349370"],[11,2,"1605870"],[13,1,"1221520"],[15,2,"1495740"],[19,3,"1343100"],[23,2,"1521400"],[26,2,"1404975"],[28,1,"2846738"],[30,2,"1358280"],[38,2,"1451160"],[41,2,"1004310"],[43,2,"1577140"],[48,2,"1560670"],[52,4,"1305440"]],[[4,1,"こま"],[13,1,"き"],[26,1,"はや"],[28,1,"なん"],[30,1,"た"],[41,1,"こ"],[48,2,"ろうか"],[52,2,"しかた"]]],["するとすぐその前に次の戸がありました。",[[0,2,"1157170"],[3,2,"1430610"],[5,2,"1006830"],[7,1,"1392580"],[9,1,"1316380"],[11,1,"1266970"],[13,2,"1296400"]],[[7,1,"まえ"],[9,1,"つぎ"],[11,1,"と"]]],["「料理はもうすぐできます。",[[1,2,"1554310"],[4,4,"2015610"],[8,2,"1340450"]],[[1,2,"りょうり"]]],["十五分とお待たせはいたしません。",[[2,1,"1502860"],[5,2,"1410590"],[9,3,"1421900"]],[[0,2,"じゅうご"],[2,1,"ふん"],[5,1,"ま"]]],["すぐたべられます。",[[0,2,"1430610"],[2,2,"1358280"]],[]],["早くあなたの頭に瓶の中の香水をよく振りかけてください。」",[[0,2,"1404975"],[2,3,"1223615"],[6,1,"1582310"],[8,1,"1491120"],[10,1,"1423310"],[12,2,"1283060"],[15,2,"1605870"],[17,4,"1361180"],[22,4,"1184280"]],[[0,1,"はや"],[6,1,"あたま"],[8,1,"びん"],[10,1,"なか"],[12,2,"こうすい"],[17,1,"ふ"]]],["そして戸の前には金ピカの香水の瓶が置いてありました。",[[0,3,"1006730"],[3,1,"1266970"],[5,1,"1392580"],[8,3,"1633090"],[12,2,"1283060"],[15,1,"1491120"],[17,2,"1421850"],[20,2,"1296400"]],[[3,1,"と"],[5,1,"まえ"],[8,1,"きん"],[12,2,"こうすい"],[15,1,"びん"],[17,1,"お"]]],["二人はその香水を、頭へぱちゃぱちゃ振りかけました。",[[0,2,"1582670"],[3,2,"1006830"],[5,2,"1283060"],[9,1,"1582310"],[11,6,"2755540"],[17,4,"1361180"]],[[0,2,"ふたり"],[5,2,"こうすい"],[9,1,"あたま"],[17,1,"ふ"]]],["ところがその香水は、どうも酢のような匂がするのでした。",[[0,3,"1343100"],[4,2,"1006830"],[6,2,"1283060"],[10,2,"1451160"],[13,1,"1370270"],[15,2,"1605845"],[18,1,"1599760"],[20,2,"1157170"]],[[6,2,"こうすい"],[13,1,"す"],[18,1,"におい"]]],["「この香水はへんに酢くさい。どうしたんだろう。」",[[1,2,"1582920"],[3,2,"1283060"],[6,2,"1512070"],[9,1,"1370270"],[10,3,"1333150"],[14,2,"1451160"],[16,1,"1157170"]],[[3,2,"こうすい"],[9,1,"す"]]],["「まちがえたんだ。下女が風邪でも引いてまちがえて入れたんだ。」",[[1,4,"1215330"],[9,2,"1185380"],[12,2,"1583720"],[16,2,"1169250"],[19,4,"1215330"],[24,2,"1465610"]],[[9,2,"げじょ"],[12,2,"かぜ"],[16,1,"ひ"],[24,1,"い"]]],["二人は扉をあけて中にはいりました。",[[0,2,"1582670"],[3,1,"1483380"],[5,2,"1202450"],[8,1,"1423310"],[10,3,"1465590"]],[[0,2,"ふたり"],[3,1,"とびら"],[8,1,"なか"]]],["扉の裏側には、大きな字で斯う書いてありました。",[[0,1,"1483380"],[2,2,"1550410"],[7,3,"1412890"],[10,1,"1315130"],[12,2,"1004310"],[14,2,"1343950"],[17,2,"1296400"]],[[0,1,"とびら"],[2,2,"うらがわ"],[7,1,"おお"],[10,1,"じ"],[12,1,"こ"],[14,1,"か"]]],["「いろいろ注文が多くてうるさかったでしょう。お気の毒でした。",[[1,4,"1587850"],[5,2,"1426650"],[8,2,"1407460"],[11,5,"1481920"],[22,4,"1001750"]],[[5,2,"ちゅうもん"],[8,1,"おお"],[23,3,"きのどく"]]],["もうこれだけです。どうかからだ中に、壺の中の塩をたくさん",[[0,2,"1012480"],[2,2,"1628530"],[9,2,"1451160"],[11,3,"1207590"],[15,1,"1423310"],[18,1,"1433870"],[20,1,"1423310"],[22,1,"1576630"],[24,4,"1415870"]],[[15,1,"なか"],[18,1,"つぼ"],[20,1,"なか"],[22,1,"しお"]]],["よくもみ込んでください。」",[[0,2,"1605870"],[2,4,"2176270"],[7,4,"1184280"]],[[4,1,"こ"]]],["なるほど立派な青い瀬戸の塩壺は置いてありましたが、こんどというこんどは二人ともぎょっとしてお互にクリームをたくさん塗った顔を見合せました。",[[0,4,"1375820"],[4,2,"1551790"],[7,2,"1381390"],[15,2,"1421850"],[18,2,"1296400"],[25,3,"1289370"],[29,2,"1587040"],[31,3,"1289370"],[35,4,"1462470"],[39,4,"1003630"],[43,1,"1157170"],[46,1,"1268770"],[48,4,"1044480"],[53,4,"1415870"],[57,2,"1444270"],[60,1,"1217730"],[62,3,"1259570"]],[[4,2,"りっぱ"],[7,1,"あお"],[9,2,"せと"],[12,2,"しおつぼ"],[15,1,"お"],[35,2,"ふたり"],[46,1,"たがい"],[57,1,"ぬ"],[60,1,"かお"],[62,2,"みあわ"]]],["「どうもおかしいぜ。」",[[1,2,"1451160"],[4,4,"1190860"]],[]],["「ぼくもおかしいとおもう。」",[[1,2,"1521400"],[4,4,"1190860"],[9,3,"1589350"]],[]],["「沢山の注文というのは、向うがこっちへ注文してるんだよ。」",[[1,2,"1415870"],[4,2,"1426650"],[7,2,"1587040"],[12,2,"1277140"],[15,3,"1004500"],[19,2,"1426650"],[21,1,"1157170"]],[[1,2,"たくさん"],[4,2,"ちゅうもん"],[12,1,"むこ"],[19,2,"ちゅうもん"]]],["「だからさ、西洋料理店というのは、ぼくの考えるところでは、西洋料理を、来た人にたべさせるのではなくて、来た人を西洋料理にして、食べてやる家とこういうことなんだ。これは、その、つ、つ、つ、つまり、ぼ、ぼ、ぼくらが……。」がたがたがたがた、ふるえだしてもうものが言えませんでした。",[[6,2,"1381100"],[8,3,"1554330"],[12,2,"1587040"],[17,2,"1521400"],[20,3,"1281020"],[23,3,"1343100"],[29,4,"2266440"],[35,1,"1547720"],[37,1,"1580640"],[39,2,"1358280"],[47,2,"1529520"],[51,1,"1547720"],[53,1,"1580640"],[55,4,"2266440"],[60,1,"1157170"],[63,2,"1358280"],[66,2,"1012980"],[68,1,"1191730"],[70,4,"1004320"],[74,2,"1241450"],[80,2,"1628530"],[84,2,"1006830"],[93,3,"1610430"],[97,1,"1584050"],[99,1,"1584050"],[101,3,"1521410"],[109,2,"1250090"],[118,5,"1633520"],[124,2,"1012480"],[126,2,"1502390"],[129,2,"1008860"]],[[6,2,"せいよう"],[8,3,"りょうりてん"],[20,1,"かんが"],[29,4,"せいようりょうり"],[35,1,"き"],[37,1,"ひと"],[51,1,"き"],[53,1,"ひと"],[55,4,"せいようりょうり"],[63,1,"た"],[68,1,"うち"],[129,1,"い"]]],["「その、ぼ、ぼくらが、……うわあ。」がたがたがたがたふるえだして、もうものが言えませんでした。",[[1,2,"1006830"],[4,1,"1584050"],[6,3,"1521410"],[13,3,"2061250"],[18,2,"1250090"],[26,5,"1633520"],[33,2,"1012480"],[35,2,"1502390"],[38,2,"1008860"]],[[38,1,"い"]]],["「遁げ……。」がたがたしながら一人の紳士はうしろの戸を押そうとしましたが、どうです、戸はもう一分も動きませんでした。",[[1,2,"1450330"],[7,4,"1003100"],[11,1,"1157170"],[15,2,"1576150"],[18,2,"1364950"],[21,3,"1269410"],[25,1,"1266970"],[27,3,"1180470"],[31,1,"1157170"],[37,2,"1451160"],[42,1,"