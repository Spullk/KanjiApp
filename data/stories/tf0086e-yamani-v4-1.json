[["この犬はウィンリーくんです。山が大好きです。ある日、ウィンリーくんは言いました。「山に行きたい！キャンプがしたい！」",[[0,2,"1582920"],[2,1,"1258330"],[9,2,"1247260"],[14,1,"1302680"],[16,3,"1413660"],[22,3,"1153630"],[31,2,"1247260"],[34,2,"1587040"],[41,1,"1302680"],[43,2,"1578850"],[48,4,"1042200"],[53,1,"1157170"]],[[2,1,"いぬ"],[14,1,"やま"],[16,2,"だいす"],[24,1,"ひ"],[34,1,"い"],[41,1,"やま"],[43,1,"い"]]],["2020年10月の土曜日の朝、車でシエラネバダの山に行きました。山はとても大きいです。きれいです。",[[4,1,"2084840"],[7,1,"1255430"],[9,3,"1445590"],[13,1,"1428280"],[15,1,"1323080"],[24,1,"1302680"],[26,2,"1578850"],[32,1,"1302680"],[34,3,"1008630"],[37,3,"1588880"],[43,3,"1591900"]],[[4,1,"ねん"],[7,1,"がつ"],[9,3,"どようび"],[13,1,"あさ"],[15,1,"くるま"],[24,1,"やま"],[26,1,"い"],[32,1,"やま"],[37,1,"おお"]]],["山の上に来ました。",[[0,1,"1302680"],[2,1,"1352130"],[4,1,"1547720"]],[[0,1,"やま"],[2,1,"うえ"],[4,1,"き"]]],["きれいな湖があります。魚がたくさんいます。「ここでキャンプしよう」",[[0,3,"1591900"],[4,1,"1267280"],[6,2,"1296400"],[11,1,"1578010"],[13,4,"1415870"],[17,1,"1577980"],[22,2,"1288810"],[25,4,"1042200"],[29,3,"1157170"]],[[4,1,"みずうみ"],[11,1,"さかな"]]],["夜はホットドッグを食べました。「ああ、おいしい！」とても寒いから、すぐ寝ました。",[[0,1,"1536350"],[2,6,"1122520"],[9,2,"1358280"],[16,2,"1565440"],[19,4,"1486650"],[25,3,"1008630"],[28,2,"1210360"],[33,2,"1430610"],[35,1,"1360010"]],[[0,1,"よる"],[9,1,"た"],[28,1,"さむ"],[35,1,"ね"]]],["次の日、ハイキングをしました。「あっ、けむり!山火事？でも、遠いから、だいじょうぶだよね？」",[[0,1,"1316380"],[2,1,"1463770"],[4,5,"1095040"],[10,1,"1157170"],[16,2,"2394370"],[19,3,"1177180"],[23,3,"1302770"],[30,2,"1177800"],[35,6,"1414150"]],[[0,1,"つぎ"],[2,1,"ひ"],[23,3,"やまかじ"],[30,1,"とお"]]],["夜、月がオレンジ色でした。山火事の色です。灰がふりました。山火事の灰です。",[[0,1,"1536350"],[2,1,"1255430"],[4,5,"1629570"],[13,3,"1302770"],[17,1,"1357600"],[21,1,"1201860"],[23,2,"1282790"],[29,3,"1302770"],[33,1,"1201860"]],[[0,1,"よる"],[2,1,"つき"],[8,1,"しょく"],[13,3,"やまかじ"],[17,1,"いろ"],[21,1,"はい"],[29,3,"やまかじ"],[33,1,"はい"]]],["次の朝、山を下りました。山の下まで3時間歩きました。",[[0,1,"1316380"],[2,1,"1428280"],[4,1,"1302680"],[6,2,"1589500"],[12,1,"1302680"],[14,1,"1184140"],[18,2,"1315920"],[20,2,"1514320"]],[[0,1,"つぎ"],[2,1,"あさ"],[4,1,"やま"],[6,1,"お"],[12,1,"やま"],[14,1,"した"],[18,2,"じかん"],[20,1,"ある"]]],["車に乗りました。車の中でラジオが言いました。「たいへんです!とても大きい山火事です！」",[[0,1,"1323080"],[2,2,"1355120"],[8,1,"1323080"],[10,1,"1423310"],[12,3,"1138860"],[16,2,"1587040"],[23,4,"1415000"],[30,3,"1008630"],[33,3,"1588880"],[36,3,"1302770"]],[[0,1,"くるま"],[2,1,"の"],[8,1,"くるま"],[10,1,"なか"],[16,1,"い"],[33,1,"おお"],[36,3,"やまかじ"]]],["ウィンリーくんは家に帰りました。山はとても楽しかったです。でも、山火事はこわかったです。とても疲れました。だから、ウィンリーくんはたくさん寝ました。",[[5,2,"1247260"],[8,1,"1191730"],[10,2,"1221270"],[16,1,"1302680"],[18,3,"1008630"],[21,4,"1207240"],[32,3,"1302770"],[36,4,"1593480"],[44,3,"1008630"],[47,2,"1483740"],[62,2,"1247260"],[65,4,"1415870"],[69,1,"1360010"]],[[8,1,"いえ"],[10,1,"かえ"],[16,1,"やま"],[21,1,"たの"],[32,3,"やまかじ"],[47,1,"つか"],[69,1,"ね"]]]]