[["山田さんは、大学の図書館で働いています。ある夜、仕事をしていると、カウンターから声が聞こえました。「すみません」でも、カウンターに、誰もいませんでした。「変だなあ」？",[[2,2,"1579350"],[6,2,"1413240"],[9,3,"1370420"],[13,2,"1451150"],[16,1,"1577980"],[20,2,"1586840"],[22,1,"1536350"],[24,2,"1304970"],[27,1,"1157170"],[29,2,"1577980"],[33,5,"1036930"],[40,1,"1380440"],[42,3,"1591150"],[50,2,"1887210"],[59,5,"1036930"],[66,1,"1416830"],[68,1,"1577980"],[77,1,"1510640"]],[[0,2,"やまだ"],[6,2,"だいがく"],[9,3,"としょかん"],[13,1,"はたら"],[22,1,"よる"],[24,2,"しごと"],[40,1,"こえ"],[42,1,"き"],[66,1,"だれ"],[77,1,"へん"]]],["次の夜も、山田さんは仕事をしていました。また、声が聞こえました。「すみません」誰もいませんでしたが、黒い本がありました。「だれかが返した本かな？手続きをしよう」",[[0,1,"1316380"],[2,1,"1536350"],[7,2,"1579350"],[10,2,"1304970"],[13,1,"1157170"],[15,1,"1577980"],[20,2,"1524930"],[23,1,"1380440"],[25,3,"1591150"],[33,2,"1887210"],[39,1,"1416830"],[41,1,"1577980"],[50,2,"1287420"],[52,1,"1522150"],[54,2,"1296400"],[61,2,"1416830"],[65,2,"1512130"],[68,1,"1522150"],[72,3,"1598350"],[76,3,"1157170"]],[[0,1,"つぎ"],[2,1,"よる"],[5,2,"やまだ"],[10,2,"しごと"],[23,1,"こえ"],[25,1,"き"],[39,1,"だれ"],[50,1,"くろ"],[52,1,"ほん"],[65,1,"かえ"],[68,1,"ほん"],[72,2,"てつづ"]]],["山田さんはパソコンをつけました。「あれ？」本がありません。「変だなあ」あれ？",[[2,2,"1579350"],[5,4,"1101570"],[10,2,"1433680"],[17,2,"1196670"],[21,1,"1522150"],[23,2,"1296400"],[30,1,"1510640"],[35,2,"1196670"]],[[0,2,"やまだ"],[21,1,"ほん"],[30,1,"へん"]]],["山田さんはパソコンをつけました。「あれ？」本がありません。「変だなあ」あれ？",[[2,2,"1579350"],[5,4,"1101570"],[10,2,"1433680"],[17,2,"1196670"],[21,1,"1522150"],[23,2,"1296400"],[30,1,"1510640"],[35,2,"1196670"]],[[0,2,"やまだ"],[21,1,"ほん"],[30,1,"へん"]]],["次の週の夜、山田さんは仕事をしていました。また、声が聞こえました。「すみません」誰もいませんでしたが、また、黒い本がありました。",[[0,1,"1316380"],[2,1,"1333450"],[4,1,"1536350"],[8,2,"1579350"],[11,2,"1304970"],[14,1,"1157170"],[16,1,"1577980"],[21,2,"1524930"],[24,1,"1380440"],[26,3,"1591150"],[34,2,"1887210"],[40,1,"1416830"],[42,1,"1577980"],[51,2,"1524930"],[54,2,"1287420"],[56,1,"1522150"],[58,2,"1296400"]],[[0,1,"つぎ"],[2,1,"しゅう"],[4,1,"よる"],[6,2,"やまだ"],[11,2,"しごと"],[24,1,"こえ"],[26,1,"き"],[40,1,"だれ"],[54,1,"くろ"],[56,1,"ほん"]]],[