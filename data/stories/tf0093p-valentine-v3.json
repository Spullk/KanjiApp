[["バレンタインデーに渡すチョコレートは、渡す相手に大学生の健太さんのバレンタインデーを見てみましょう。よって呼び方が変わります。本当に好きな男性にあげるチョコレートを「本命チョ健太さんは留学生のアンナさんと付き合っています。コ」といいます。付き合いたい男性に告白する女性もい日本では、女性が男性にチョコレートを贈ります。ます。健太さんは日本で育った男性なので、アンナさんからチョ手作りのチョコレートを用意する女性も多いです。コレートをもらえると思っていました。一方、アンナさんはイギリスで育ったので、健太さんか男性も女性からチョコレートをもらえるのを楽しみにしています。らプレゼントをもらえると思っていました。",[[0,8,"1100020"],[9,2,"1444610"],[11,6,"1078270"],[19,2,"1444610"],[21,2,"1401000"],[24,3,"1413260"],[30,2,"1579350"],[33,8,"1100020"],[42,1,"1259290"],[44,1,"1259290"],[50,2,"1536350"],[53,3,"2033730"],[57,3,"1510790"],[63,2,"1523060"],[66,2,"1277450"],[69,2,"1420160"],[72,3,"1352320"],[75,6,"1078270"],[83,2,"1523250"],[89,2,"1579350"],[92,3,"1552750"],[99,2,"1579350"],[102,4,"1597790"],[107,1,"1577980"],[111,1,"1307770"],[114,2,"1587040"],[119,4,"1597790"],[125,2,"1420160"],[128,2,"1286060"],[130,2,"1157170"],[132,2,"1345250"],[135,1,"1577980"],[141,2,"1345250"],[144,2,"1420160"],[147,6,"1078270"],[154,2,"1403550"],[164,2,"1579350"],[170,2,"1160540"],[173,2,"1420160"],[182,2,"1579350"],[188,3,"1598360"],[192,6,"1078270"],[199,2,"1546220"],[201,2,"1157170"],[203,2,"1345250"],[206,2,"1407460"],[216,4,"1535910"],[221,2,"1589350"],[224,1,"1577980"],[229,2,"1166510"],[235,2,"1579350"],[243,2,"1160540"],[251,2,"1579350"],[254,2,"1420160"],[257,2,"1345250"],[261,6,"1078270"],[268,4,"1535910"],[274,3,"1207250"],[278,1,"1157170"],[280,1,"1577980"],[284,1,"2067770"],[285,5,"1116840"],[291,4,"1535910"],[296,2,"1589350"],[299,1,"1577980"]],[[9,1,"わた"],[19,1,"わた"],[21,2,"あいて"],[24,3,"だいがくせい"],[28,2,"けんた"],[42,1,"み"],[53,3,"よびかた"],[57,1,"か"],[63,2,"ほんとう"],[66,1,"す"],[69,2,"だんせい"],[83,2,"ほんめい"],[87,2,"けんた"],[92,3,"りゅうがくせい"],[102,3,"つきあ"],[119,3,"つきあ"],[125,2,"だんせい"],[128,2,"こくはく"],[132,2,"じょせい"],[136,2,"にっぽん"],[141,2,"じょせい"],[144,2,"だんせい"],[154,1,"おく"],[162,2,"けんた"],[167,2,"にっぽん"],[170,1,"そだ"],[173,2,"だんせい"],[188,2,"てづく"],[199,2,"ようい"],[203,2,"じょせい"],[206,1,"おお"],[221,1,"おも"],[229,2,"いっぽう"],[243,1,"そだ"],[249,2,"けんた"],[254,2,"だんせい"],[257,2,"じょせい"],[274,1,"たの"],[296,1,"おも"]]],[