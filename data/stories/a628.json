38"]],[[1,1,"なん"]]],["「おっ母が死んでからは、だれだか知らんが、おれに栗やまつたけなんかを、まいにちまいにちくれるんだよ」",[[1,3,"2872015"],[5,2,"1310730"],[12,2,"1416830"],[16,2,"1420470"],[21,2,"1576870"],[24,1,"1246880"],[26,4,"1349910"],[35,8,"2038450"],[43,3,"1269130"]],[[3,1,"はは"],[5,1,"し"],[16,1,"し"],[24,1,"くり"]]],["「ふうん、だれが？」",[[1,3,"1632520"],[5,2,"1416830"]],[]],["「それがわからんのだよ。おれの知らんうちに、おいていくんだ」",[[1,2,"1006970"],[4,3,"1606560"],[12,2,"1576870"],[15,2,"1420470"],[18,2,"1457730"],[22,2,"1179320"],[25,2,"1578850"]],[[15,1,"し"]]],["ごんは、ふたりのあとをつけていきました。",[[4,3,"1582670"],[8,2,"1269320"],[11,2,"1433680"],[14,2,"1578850"]],[]],["「ほんとかい？」",[[1,3,"1523060"]],[]],["「ほんとだとも。うそと思うなら、あした見に来いよ。その栗を見せてやるよ」",[[1,3,"1523060"],[8,2,"1172400"],[11,2,"1589350"],[16,3,"1584660"],[19,1,"1259290"],[21,2,"1547720"],[25,2,"1006830"],[27,1,"1246880"],[29,2,"1259210"],[32,2,"1012980"]],[[11,1,"おも"],[19,1,"み"],[21,1,"こ"],[27,1,"くり"],[29,1,"み"]]],["「へえ、へんなこともあるもんだなア」",[[1,2,"2019590"],[4,2,"1510640"],[7,2,"1241450"],[10,2,"1296400"],[12,2,"1584800"]],[]],["それなり、二人はだまって歩いていきました。",[[0,2,"1006970"],[5,2,"1582670"],[8,3,"1534930"],[12,2,"1514320"],[15,2,"1578850"]],[[5,2,"ふたり"],[12,1,"ある"]]],["加助がひょいと、後を見ました。ごんはびくっとして、小さくなってたちどまりました。加助は、ごんには気がつかないで、そのままさっさとあるきました。吉兵衛というお百姓の家まで来ると、二人はそこへはいっていきました。ポンポンポンポンと木魚の音がしています。窓の障子にあかりがさしていて、大きな坊主頭がうつって動いていました。ごんは、",[[8,1,"1269320"],[10,1,"1259290"],[18,3,"1621910"],[22,1,"1157170"],[25,3,"1347750"],[28,2,"1375610"],[31,5,"1551350"],[48,1,"1221520"],[50,2,"1495740"],[56,4,"1406030"],[60,4,"1005190"],[64,3,"1514320"],[75,2,"1587040"],[78,2,"1488250"],[81,1,"1191730"],[84,2,"1547720"],[88,2,"1582670"],[91,2,"1436050"],[94,3,"1465590"],[98,2,"1578850"],[104,4,"1126050"],[108,4,"1126050"],[113,2,"1807430"],[116,1,"1576900"],[118,1,"1157170"],[120,1,"1577980"],[124,1,"1401400"],[126,2,"1352090"],[129,3,"1586210"],[133,2,"1306470"],[136,1,"1577980"],[139,3,"1412890"],[142,3,"1519100"],[146,3,"1321820"],[150,2,"1451210"],[153,1,"1577980"]],[[0,2,"かすけ"],[8,1,"うしろ"],[10,1,"み"],[25,1,"ちい"],[40,2,"かすけ"],[48,1,"き"],[71,3,"きちべえ"],[78,2,"ひゃくしょう"],[81,1,"いえ"],[84,1,"く"],[88,2,"ふたり"],[113,2,"もくぎょ"],[116,1,"おと"],[124,1,"まど"],[126,2,"しょうじ"],[139,1,"おお"],[142,3,"ぼうずあたま"],[150,1,"うご"]]],["「おねんぶつがあるんだな」と思いながら井戸のそばにしゃがんでいました。しばらくすると、また三人ほど、人がつれだって吉兵衛の家へはいっていきました。お経を読む声がきこえて来ました。",[[2,4,"1469470"],[7,2,"1296400"],[14,2,"1589350"],[19,2,"1160330"],[22,2,"1403830"],[25,4,"1005630"],[30,1,"1577980"],[35,4,"1304420"],[39,2,"1157170"],[43,2,"1524930"],[45,2,"1301000"],[50,1,"1580640"],[52,4,"1559360"],[61,1,"1191730"],[63,3,"1465590"],[67,2,"1578850"],[73,2,"2518450"],[76,2,"1456360"],[78,1,"1380440"],[80,3,"1591150"],[84,1,"1547720"]],[[14,1,"おも"],[19,2,"いど"],[45,2,"さんにん"],[50,1,"ひと"],[57,3,"きちべえ"],[61,1,"いえ"],[74,1,"きょう"],[76,1,"よ"],[78,1,"こえ"],[84,1,"き"]]],["五",[],[[0,1,"ご"]]],["ごんは、おねんぶつがすむまで、井戸のそばにしゃがんでいました。兵十と加助は、また一しょにかえっていきます。ごんは、二人の話をきこうと思って、ついていきました。兵十の影法師をふみふみいきました。",[[5,4,"1469470"],[10,2,"1295070"],[15,2,"1160330"],[18,2,"1403830"],[21,4,"1005630"],[26,1,"1577980"],[38,2,"1524930"],[40,3,"1163400"],[44,3,"1589780"],[48,2,"1578850"],[57,2,"1582670"],[60,1,"1600900"],[62,3,"1226210"],[66,2,"1589350"],[70,2,"1495740"],[73,2,"1578850"],[82,3,"1173700"],[86,2,"1450270"],[88,2,"1450270"],[90,2,"1578850"]],[[15,2,"いど"],[31,2,"へいじゅう"],[34,2,"かすけ"],[40,1,"いっ"],[57,2,"ふたり"],[60,1,"はなし"],[66,1,"おも"],[79,2,"へいじゅう"],[82,3,"かげぼうし"]]],["お城の前まで来たとき、加助が言い出しました。",[[1,1,"1355710"],[3,1,"1392580"],[6,1,"1547720"],[8,2,"1315840"],[14,4,"1264080"]],[[1,1,"しろ"],[3,1,"まえ"],[6,1,"き"],[11,2,"かすけ"],[14,3,"いいだ"]]],["「さっきの話は、きっと、そりゃあ、神さまのしわざだぞ」",[[1,3,"1005180"],[5,1,"1600900"],[8,3,"1003430"],[12,4,"1006970"],[17,3,"1364920"],[21,3,"1304870"]],[[5,1,"はなし"],[17,1,"かみ"]]],["「えっ？」と、兵十はびっくりして、加助の顔を見ました。",[[1,2,"2194050"],[10,4,"1226360"],[14,1,"1157170"],[20,1,"1217730"],[22,1,"1259290"]],[[7,2,"へいじゅう"],[17,2,"かすけ"],[20,1,"かお"],[22,1,"み"]]],["「おれは、あれからずっと考えていたが、どうも、そりゃ、人間じゃない、神さまだ、神さまが、お前がたった一人になったのをあわれに思わっしゃって、いろんなものをめぐんで下さるんだよ」",[[1,2,"1576870"],[5,2,"1000580"],[9,3,"1006380"],[12,2,"1281020"],[15,1,"1577980"],[19,2,"1451160"],[23,3,"1006970"],[27,2,"1366770"],[31,2,"1529520"],[34,3,"1364920"],[39,3,"1364920"],[44,2,"1002290"],[47,5,"2251030"],[53,2,"1375610"],[58,3,"1150110"],[62,2,"1589350"],[70,4,"1609270"],[74,2,"1502390"],[77,3,"1250480"],[81,3,"1184280"]],[[12,1,"かんが"],[27,2,"にんげん"],[34,1,"かみ"],[39,1,"かみ"],[45,1,"まえ"],[50,2,"ひとり"],[62,1,"おも"],[81,1,"くだ"]]],["「そうかなあ」",[[1,2,"1241450"]],[]],["「そうだとも。だから、まいにち神さまにお礼を言うがいいよ」",[[1,2,"1241450"],[11,4,"1524720"],[15,3,"1364920"],[19,2,"1270810"],[22,2,"1587040"],[25,2,"1605820"]],[[15,1,"かみ"],[20,1,"れい"],[22,1,"ゆ"]]],["「うん」",[[1,2,"1172610"]],[]],["ごんは、へえ、こいつはつまらないなと思いました。おれが、栗や松たけを持っていってやるのに、そのおれにはお礼をいわないで、神さまにお礼をいうんじゃア、おれは、引き合わないなあ。",[[4,2,"2019590"],[7,3,"1579070"],[11,3,"1226480"],[18,2,"1589350"],[24,2,"1576870"],[28,1,"1246880"],[30,3,"1349910"],[34,2,"1315720"],[37,2,"1578850"],[40,2,"1012980"],[45,2,"1006830"],[47,2,"1576870"],[51,2,"1270810"],[54,2,"1587040"],[60,3,"1364920"],[64,2,"1270810"],[67,2,"1587040"],[74,2,"1576870"],[78,4,"1168930"]],[[18,1,"おも"],[28,1,"くり"],[30,1,"まつ"],[34,1,"も"],[52,1,"れい"],[60,1,"かみ"],[65,1,"れい"],[78,3,"ひきあ"]]],["六",[],[[0,1,"ろく"]]],["そのあくる日もごんは、栗をもって、兵十の家へ出かけました。兵十は物置で縄をなっていました。それでごんは家の裏口から、こっそり中へはいりました。",[[0,2,"1006830"],[2,4,"1532260"],[11,1,"1246880"],[13,2,"1315720"],[20,1,"1191730"],[22,3,"1598550"],[32,2,"1502690"],[35,1,"1459830"],[37,2,"1375610"],[40,1,"1577980"],[45,2,"1006970"],[51,1,"1191730"],[53,2,"1550270"],[58,4,"1004520"],[62,1,"1423310"],[64,3,"1465590"]],[[5,1,"ひ"],[11,1,"くり"],[17,2,"へいじゅう"],[20,1,"いえ"],[22,1,"で"],[29,2,"へいじゅう"],[32,2,"ものおき"],[35,1,"なわ"],[51,1,"いえ"],[53,2,"うらぐち"],[62,1,"なか"]]],["そのとき兵十は、ふと顔をあげました。と狐が家の中へはいったではありませんか。こないだうなぎをぬすみやがったあのごん狐めが、またいたずらをしに来たな。",[[0,4,"2002300"],[8,2,"1493240"],[10,1,"1217730"],[12,2,"1352320"],[19,1,"1267340"],[21,1,"1191730"],[23,1,"1423310"],[25,3,"1465590"],[31,2,"1296400"],[38,4,"1004690"],[42,3,"1172500"],[46,3,"1448440"],[53,2,"1000420"],[55,2,"2064450"],[57,1,"1267340"],[58,1,"1197710"],[61,2,"1524930"],[63,4,"1151580"],[68,1,"1157170"],[70,1,"1547720"]],[[4,2,"へいじゅう"],[10,1,"かお"],[19,1,"きつね"],[21,1,"いえ"],[23,1,"なか"],[57,1,"きつね"],[70,1,"き"]]],["「ようし。」",[[1,3,"2607690"]],[]],["兵十は立ちあがって、納屋にかけてある火縄銃をとって、火薬をつめました。",[[3,5,"1551370"],[10,2,"1470020"],[13,2,"1570710"],[16,2,"1296400"],[18,3,"1194160"],[22,2,"1326980"],[26,2,"1194260"],[29,2,"1226510"]],[[0,2,"へいじゅう"],[3,1,"た"],[10,2,"なや"],[18,3,"ひなわじゅう"],[26,2,"かやく"]]],["そして足音をしのばせてちかよって、今戸口を出ようとするごんを、ドンと、うちました。ごんは、ばたりとたおれました。兵十はかけよって来ました。家の中を見ると、土間に栗が、かためておいてあるのが目につきました。",[[0,3,"1006730"],[3,2,"1404770"],[6,3,"1467450"],[11,4,"1242230"],[18,2,"1267000"],[21,3,"1338240"],[25,2,"1157170"],[27,2,"2064450"],[31,2,"1562970"],[35,2,"1408810"],[45,3,"1632430"],[49,3,"1445790"],[59,4,"1570710"],[64,1,"1547720"],[69,1,"1191730"],[71,1,"1423310"],[73,2,"1259290"],[77,2,"1445300"],[80,1,"1246880"],[83,3,"1266570"],[87,2,"1179320"],[90,2,"1296400"],[94,1,"1604890"],[96,2,"1331530"]],[[3,2,"あしおと"],[17,1,"こん"],[18,2,"ここう"],[21,1,"で"],[56,2,"へいじゅう"],[64,1,"き"],[69,1,"いえ"],[71,1,"なか"],[73,1,"み"],[77,2,"どま"],[80,1,"くり"],[94,1,"め"]]],["「おや」と兵十は、びっくりしてごんに目を落しました。",[[1,2,"1365040"],[9,4,"1226360"],[13,1,"1157170"],[18,1,"1604890"],[20,2,"1589260"]],[[5,2,"へいじゅう"],[18,1,"め"],[20,1,"おと"]]],["「ごん、お前だったのか。いつも栗をくれたのは」",[[1,2,"2064450"],[4,2,"1002290"],[12,3,"1188890"],[15,1,"1246880"],[17,2,"1269130"]],[[5,1,"まい"],[15,1,"くり"]]],["ごんは、ぐったりと目をつぶったまま、うなずきました。",[[4,4,"1004070"],[9,1,"1604890"],[11,3,"1585820"],[15,2,"1585410"],[18,4,"1574310"]],[[9,1,"め"]]],["兵十は火縄銃をばたりと、とり落しました。青い煙が、まだ筒口から細く出ていました。",[[3,3,"1194160"],[7,3,"1632430"],[12,4,"1707830"],[20,2,"1381390"],[22,1,"1177180"],[25,2,"1527110"],[31,2,"1295510"],[33,1,"1338240"],[35,1,"1577980"]],[[0,2,"へいじゅう"],[3,3,"ひなわじゅう"],[14,1,"おと"],[20,1,"あお"],[22,1,"けむり"],[27,2,"つつぐち"],[31,1,"ほそ"],[33,1,"で"]]]]