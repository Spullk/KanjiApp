[["ケニア私は、ケニアから来た留学生です。現在、九州の大分県にある大学で勉強しています。日本の地図九州",[[3,1,"2842390"],[11,1,"1547720"],[13,3,"1552750"],[19,2,"1263650"],[29,2,"1296400"],[31,2,"1413240"],[34,2,"1512670"],[36,1,"1157170"],[38,1,"1577980"],[45,2,"1421290"]],[[3,1,"わたくし"],[11,1,"き"],[13,3,"りゅうがくせい"],[19,2,"げんざい"],[22,2,"きゅうしゅう"],[25,3,"おおいたけん"],[31,2,"だいがく"],[34,2,"べんきょう"],[42,2,"にっぽん"],[45,2,"ちず"],[47,2,"きゅうしゅう"]]],["今日は日本語の先生の家で、パーティーがあります。先生が、日本の料理を作ってくださいます。私たちも料理を作るのを手伝います。",[[0,2,"1579110"],[3,3,"1464530"],[7,2,"1387990"],[10,1,"1191730"],[13,5,"1100760"],[19,2,"1296400"],[24,2,"1387990"],[31,2,"1554310"],[34,2,"1597890"],[37,4,"1184280"],[44,3,"1311300"],[48,2,"1554310"],[51,2,"1597890"],[55,3,"1328190"]],[[0,2,"きょう"],[3,3,"にほんご"],[7,2,"せんせい"],[10,1,"いえ"],[24,2,"せんせい"],[28,2,"にっぽん"],[31,2,"りょうり"],[34,1,"つく"],[44,1,"わたし"],[48,2,"りょうり"],[51,1,"つく"],[55,2,"てつだ"]]],["先生の家の台所にまるくて、茶色いものがありました。固くて、木のようです。おもちゃでしょうか。アクセサリーでしょうか。クッキーでしょうか。",[[0,2,"1387990"],[3,1,"1191730"],[5,2,"1412640"],[8,3,"1604230"],[13,3,"1983730"],[16,2,"1502390"],[19,2,"1296400"],[25,2,"1257110"],[29,1,"1534520"],[31,2,"1250220"],[36,4,"1217070"],[46,6,"1015220"],[58,4,"1043760"]],[[0,2,"せんせい"],[3,1,"いえ"],[5,2,"だいどころ"],[13,2,"ちゃいろ"],[25,1,"かた"],[29,1,"き"]]],["友だちに聞いてみました。インドから来た友だちは「見たことはあります。でも、名前はわかりません」と言いました。ウズベキスタンから来た友だちも「見たことはあります。でも、食べたことはないです」と言いました。",[[0,3,"1540170"],[4,2,"1591110"],[7,1,"1259290"],[17,1,"1547720"],[19,3,"1540170"],[24,1,"1259290"],[26,2,"1241450"],[29,2,"1296400"],[37,2,"1531710"],[40,3,"1606560"],[48,2,"1587040"],[63,1,"1547720"],[65,3,"1540170"],[70,1,"1259290"],[72,2,"1241450"],[75,2,"1296400"],[83,2,"1358280"],[86,2,"1241450"],[89,2,"1529520"],[95,2,"1587040"]],[[0,1,"とも"],[4,1,"き"],[17,1,"き"],[19,1,"とも"],[24,1,"み"],[37,2,"なまえ"],[48,1,"い"],[63,1,"き"],[65,1,"とも"],[70,1,"み"],[83,1,"た"],[95,1,"い"]]],["私は先生に「これは何ですか」と聞きました。先生は「これは、ほししいたけです。ほししいたけは、しいたけをほしたものです。大分県では、しいたけをたくさん作っているので、今日はみなさんに、しいたけの料理を食べてほしいです」とおっしゃって、料理を作り始めました。",[[0,1,"2842390"],[2,2,"1387990"],[6,2,"1628530"],[9,1,"2846738"],[15,2,