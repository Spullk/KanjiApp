160"],[23,1,"1569660"],[25,2,"1326980"],[29,2,"1605820"],[35,1,"1569660"],[37,1,"1501020"],[39,2,"1296400"],[41,2,"1502390"],[47,4,"2231000"],[52,4,"1165970"],[56,3,"1413940"],[60,2,"1502390"],[63,4,"1610740"]],[[4,1,"なに"],[23,1,"こぶ"],[25,1,"と"],[35,1,"こぶ"],[37,1,"ふく"],[63,1,"ちが"]]],["といいました。",[[1,2,"1587040"]],[]],["おじいさんは心の中では、「しめた。」と思いながら、わざとびっくりした風をして、",[[0,5,"1002320"],[6,1,"1360480"],[8,1,"1423310"],[13,3,"1389450"],[19,2,"1589350"],[25,3,"1410760"],[28,4,"1226360"],[32,1,"1157170"],[34,1,"1499720"],[36,1,"1157170"]],[[6,1,"こころ"],[8,1,"なか"],[19,1,"おも"],[34,1,"ふう"]]],["「おやおや、とんでもないことをおっしゃいます。目玉を抜かれましても、鼻を切られましても、この瘤を取ることだけはどうかごかんべん下さいまし。長年の間、わたくしが宝のようにしてぶら下げている、だいじなだいじな瘤でございますから、これを取り上げられましては、ほんとうに困ってしまいます。」",[[1,4,"1001570"],[6,6,"1008790"],[12,2,"1241450"],[15,5,"1238840"],[23,2,"1535370"],[26,2,"1478190"],[34,1,"1486720"],[36,2,"1384830"],[44,2,"1582920"],[46,1,"1569660"],[48,2,"1326980"],[50,2,"1241450"],[55,2,"1451160"],[59,4,"1210870"],[63,3,"1184280"],[69,2,"1430100"],[72,1,"1215240"],[74,4,"2842390"],[79,1,"1516160"],[81,2,"1250220"],[84,1,"1157170"],[86,4,"1011250"],[91,2,"1577980"],[94,3,"1413940"],[98,3,"1413940"],[102,1,"1569660"],[104,3,"1270350"],[112,2,"1628530"],[115,4,"1326800"],[126,4,"1523060"],[131,2,"1289590"],[134,3,"1305380"]],[[23,2,"めだま"],[26,1,"ぬ"],[34,1,"はな"],[36,1,"き"],[46,1,"こぶ"],[48,1,"と"],[63,1,"くだ"],[69,2,"ながねん"],[72,1,"あいだ"],[79,1,"たから"],[88,1,"さ"],[102,1,"こぶ"],[115,1,"と"],[117,1,"あ"],[131,1,"こま"]]],["といいました。",[[1,2,"1587040"]],[]],["鬼のおかしらはこれを聞くと、",[[0,1,"1224190"],[7,2,"1628530"],[10,2,"1591110"]],[[0,1,"おに"],[10,1,"き"]]],["「それ見ろ。あのとおり惜しがっている瘤だ。あれに限る、取り上げておけ。」",[[1,2,"1006970"],[3,2,"1259290"],[6,2,"1000420"],[8,3,"1432920"],[11,4,"2132830"],[16,2,"1577980"],[18,1,"1569660"],[21,2,"1000580"],[24,2,"1264640"],[27,4,"1326800"],[32,2,"1179320"]],[[3,1,"み"],[11,1,"お"],[18,1,"こぶ"],[24,1,"かぎ"],[27,1,"と"],[29,1,"あ"]]],["といいました。",[[1,2,"1587040"]],[]],["手下の鬼はすぐそばへ寄ってきて、",[[0,2,"1653500"],[3,1,"1224190"],[5,4,"1430630"],[10,2,"1219680"],[13,1,"1547720"]],[[0,2,"てした"],[3,1,"おに"],[10,1,"よ"]]],["「それ、とるぞ。」",[[1,2,"1006970"],[4,2,"1326980"]],[]],["といいながら、ぽきりと瘤をねじ切ってしまいました。でも少しも痛くはありませんでした。",[[1,2,"1587040"],[7,3,"2735380"],[11,1,"1569660"],[13,4,"1567520"],[18,3,"1305380"],[27,2,"1348870"],[30,2,"1432680"],[33,2,"1296400"]],[[11,1,"こぶ"],[15,1,"き"],[27,1,"すこ"],[30,1,"いた"]]],["ちょうどその時、夜が明けて、からすがかあかあ鳴きました。",[[0,4,"1427340"],[4,3,"2002300"],[8,1,"1536350"],[10,2,"1202450"],[14,3,"1171450"],[18,4,"2039560"],[22,2,"1532870"]],[[6,1,"とき"],[8,1,"よ"],[10,1,"あ"],[22,1,"な"]]],["「やあ、大へん。」",[[1,2,"2089490"],[4,3,"1415000"]],[[4,1,"たい"]]],["鬼どもはびっくりして、立ち上がりました。",[[0,1,"1224190"],[1,2,"1234250"],[4,4,"1226360"],[8,1,"1157170"],[11,5,"1551370"]],[[0,1,"おに"],[11,1,"た"],[13,1,"あ"]]],["「明日の晩はきっと来い、瘤を返してやるから。」",[[1,2,"1584660"],[4,1,"1482110"],[6,3,"1003430"],[9,2,"1547720"],[12,1,"1569660"],[14,2,"1512130"],[17,2,"1012980"]],[[1,2,"あす"],[4,1,"ばん"],[9,1,"こ"],[12,1,"こぶ"],[14,1,"かえ"]]],["こういいながら、みんなあわててどこかへ消えていきました。",[[0,4,"1004320"],[8,3,"1202150"],[11,3,"1278830"],[15,2,"1577140"],[19,2,"1350040"],[22,2,"1578850"]],[[19,1,"き"]]],["おじいさんはその後で、そっと顔をなでてみました。そうすると、長年じゃまにしていた大きな瘤がきれいに無くなって、後はふいて取ったようにつるつるしていました。",[[0,5,"1002320"],[6,3,"1006860"],[11,3,"1006810"],[14,1,"1217730"],[16,2,"1498290"],[19,1,"1259290"],[24,4,"1925750"],[30,2,"1430100"],[32,3,"1323500"],[36,1,"1157170"],[38,1,"1577980"],[40,3,"1412890"],[43,1,"1569660"],[45,3,"1591900"],[49,4,"1529550"],[55,1,"1269320"],[57,2,"1500940"],[60,2,"1326980"],[63,2,"1250220"],[66,4,"1008220"],[70,1,"1157170"],[72,1,"1577980"]],[[8,1,"あと"],[14,1,"かお"],[30,2,"ながねん"],[40,1,"おお"],[43,1,"こぶ"],[49,1,"な"],[55,1,"あと"],[60,1,"と"]]],["「これは有り難い。ふしぎなこともあるものだ。」",[[1,2,"1628530"],[4,4,"1541560"],[9,3,"1492570"],[13,2,"1241450"],[16,2,"1296400"],[18,2,"1502390"]],[[4,1,"あ"],[6,1,"がた"]]],["おじいさんはうれしくってたまらないので、早くおばあさんに見せてよろこばしてやろうと、首を振り振り、急いでうちまで駆けて帰りました。",[[0,5,"1002320"],[6,4,"1219510"],[12,3,"1552650"],[20,2,"1404975"],[22,5,"1002330"],[28,2,"1259210"],[31,4,"1218760"],[35,1,"1157170"],