[["これは、アグアスカリエンテスの伝説です。昔々、フェリパという若い女性が、メキシコのアグアスカリエンテスに住んでいました。フェリパは結婚していました。",[[0,2,"1628530"],[15,2,"1442100"],[20,2,"1604810"],[28,2,"1587040"],[30,2,"1324300"],[32,2,"1345250"],[52,2,"1334040"],[55,1,"1577980"],[65,2,"1254790"],[67,1,"1157170"],[69,1,"1577980"]],[[15,2,"でんせつ"],[20,2,"むかしむかし"],[30,1,"わか"],[32,2,"じょせい"],[52,1,"す"],[65,2,"けっこん"]]],["フェリパの夫は、貧乏な闘牛士でした。フェリパは、夫を支えるために、毎日サンマルコス庭園で一生懸命働いていました。薬草を売っていました。",[[5,1,"1496480"],[8,2,"1490900"],[11,3,"1692430"],[24,1,"1496480"],[26,3,"1310090"],[29,2,"1157080"],[33,2,"1524720"],[41,2,"1436140"],[44,4,"1164010"],[48,2,"1451150"],[51,1,"1577980"],[56,2,"1538260"],[59,2,"1473950"],[62,1,"1577980"]],[[5,1,"おっと"],[8,2,"びんぼう"],[11,3,"とうぎゅうし"],[24,1,"おっと"],[26,1,"ささ"],[33,2,"まいにち"],[41,2,"ていえん"],[44,4,"いっしょうけんめい"],[48,1,"はたら"],[56,2,"やくそう"],[59,1,"う"]]],["フェリパの夫は、働くことが嫌いで、すぐ仕事を辞めてしまいます。ある日、鉱山の仕事を見つけました。でも、すぐ重い病気になりました。",[[5,1,"1496480"],[8,2,"1451150"],[10,2,"1241450"],[13,2,"1257240"],[17,2,"1430610"],[19,2,"1304970"],[22,2,"1318950"],[25,3,"1305380"],[31,3,"1153630"],[35,2,"1282570"],[38,2,"1304970"],[41,3,"1604570"],[51,2,"1430610"],[53,2,"1335750"],[55,2,"1490230"],[58,2,"1375610"]],[[5,1,"おっと"],[8,1,"はたら"],[13,1,"きら"],[19,2,"しごと"],[22,1,"や"],[33,1,"ひ"],[35,2,"こうざん"],[38,2,"しごと"],[41,1,"み"],[53,1,"おも"],[55,2,"びょうき"]]],["フェリパはとても不安になり、助けを求めて町へ行きました。すると、ある小道で、不思議な男に出会いました。男はフェリパに数珠をわたしました。",[[5,3,"1008630"],[8,2,"1491150"],[11,2,"1375610"],[14,2,"1344390"],[17,2,"1229350"],[20,1,"1603990"],[22,2,"1578850"],[28,2,"1157170"],[32,2,"1586840"],[34,2,"1660240"],[38,3,"1492570"],[42,1,"1419990"],[44,3,"1598530"],[51,1,"1419990"],[58,2,"1373080"],[61,3,"1444610"]],[[8,2,"ふあん"],[14,1,"たす"],[17,1,"もと"],[20,1,"まち"],[22,1,"い"],[34,2,"こみち"],[38,3,"ふしぎ"],[42,1,"おとこ"],[44,2,"であ"],[51,1,"おとこ"],[58,2,"じゅず"]]],["「この数珠に願い事をしたら、何でも願いがかなう。でも、願いがかなったら、おまえはその代価を払わなければならない」",[[1,2,"1582920"],[3,2,"1373080"],[6,3,"1600050"],[10,1,"1157170"],[14,1,"2846738"],[17,2,"1217900"],[20,3,"1208870"],[27,2,"1217900"],[30,3,"1208870"],[36,3,"1002290"],[40,2,"1006830"],[42,2,"1411660"],[45,2,"1501620"],[51,2,"1375610"]],[[3,2,"じゅず"],[6,3,"ねがいごと"],[14,1,"なん"],[17,1,"ねが"],[27,1,"ねが"],[42,2,"だいか"],[45,1,"はら"]]],["フェリパは、「わかりました。夫の病気を治してください」と、答えました。",[[7,3,"1606560"],[14,1,"1496480"],[16,2,"1490230"],[19,2,"1599390"],[22,4,"1184280"],[29,2,"1449540"]],[[14,1,"おっと"],[16,2,"びょうき"],[19,1,"なお"],[29,1,"こた"]]],["急いでうちに帰ると、夫が元気になっていました。フェリパは嬉しくなりました。",[[0,2,"1228650"],[3,2,"1457730"],[6,2,"1221270"],[10,1,"1496480"],[12,2,"1260720"],[15,2,"1375610"],[18,1,"1577980"],[28,3,"1219510"],[31,2,"1375610"]],[[0,1,"いそ"],[6,1,"かえ"],[10,1,"おっと"],[12,2,"げんき"],[28,1,"うれ"]]],["フェリパの夫は、元気になっただけでなく、もっとよい闘牛士になりました。フェリパの夫は有名になって、フェリパと離婚して、他の女性と結婚しました。",[[5,1,"1496480"],[8,2,"1260720"],[11,2,"1375610"],[17,2,"1529520"],[20,3,"1012620"],[23,2,"1605820"],[25,3,"1692430"],[29,2,"1375610"],[40,1,"1496480"],[42,2,"1541620"],[45,2,"1375610"],[54,2,"1550880"],[56,1,"1157170"],[59,1,"1203260"],[61,2,"1345250"],[64,2,"1254790"],[66,1,"1157170"]],[[5,1,"おっと"],[8,2,"げんき"],[25,3,"とうぎゅうし"],[40,1,"おっと"],[42,2,"ゆうめい"],[54,2,"りこん"],[59,1,"た"],[61,2,"じょせい"],[64,2,"けっこん"]]],["ある寂しい夜、フェリパはもう一度、あの不思議な男に出会いました。フェリパは男に文句を言いました。",[[0,2,"1586840"],[2,3,"1579720"],[5,1,"1536350"],[12,4,"2005860"],[17,2,"1000420"],[19,3,"1492570"],[23,1,"1419990"],[25,3,"1598530"],[37,1,"1419990"],[39,2,"1505260"],[42,2,"1587040"]],[[2,1,"さび"],[5,1,"よる"],[14,2,"いちど"],[19,3,"ふしぎ"],[23,1,"おとこ"],[25,2,"であ"],[37,1,"おとこ"],[39,2,"もんく"],[42,1,"い"]]],["すると、その男は急に悪魔に変わりました。「フェリパ、おまえの願いは、夫が元気になることだった。願いがかなったので、おまえはその代価を払わなければいけない」と悪魔は言いました。",[[0,2,"1157170"],[4,2,"1006830"],[6,1,"1419990"],[8,1,"1228560"],[10,2,"1152510"],[13,3,"1510790"],[26,3,"1002290"],[30,2,"1217900"],[34,1,"1496480"],[36,2,"1260720"],[39,2,"1375610"],[41,2,"1241450"],[47,2,"1217900"],[50,3,"1208870"],[57,3,"1002290"],[61,2,"1006830"],[63,2,"1411660"],[66,2,"1501620"],[72,2,"1578850"],[81,2,"1587040"]],[[6,1,"おとこ"],[8,1,"きゅう"],[10,2,"あくま"],[13,1,"か"],[30,1,"ねが"],[34,1,"おっと"],[36,2,"げんき"],[47,1,"ねが"],[63,2,"だいか"],[66,1,"はら"],[78,2,"あくま"],[81,1,"い"]]],["「代価？」とフェリパは聞きました。「おまえは夫の人生を自分のために変えた」と、悪魔は答えました。その時から、誰もフェリパを見ていません。",[[1,2,"1411660"],[11,2,"1591110"],[18,3,"1002290"],[22,1,"1496480"],[24,2,"1368370"],[27,2,"1318610"],[30,2,"1157080"],[33,2,"1510650"],[39,2,"1152510"],[42,2,"1449540"],[48,3,"2002300"],[54,1,"1416830"],[61,1,"1259290"],[63,1,"1577980"]],[[1,2,"だいか"],[11,1,"き"],[22,1,"おっと"],[24,2,"じんせい"],[27,2,"じぶん"],[33,1,"か"],[39,2,"あくま"],[42,1,"こた"],[50,1,"とき"],[54,1,"だれ"],[61,1,"み"]]],["今日も、サンマルコス庭園にフェリパの魂が、さまよっています。数珠を売っています。だれかが数珠を買ってくれたら、フェリパの魂は自由になります。",[[0,2,"1579110"],[10,2,"1436140"],[18,1,"1579170"],[21,4,"1566730"],[26,1,"1577980"],[30,2,"1373080"],[33,2,"1473950"],[36,1,"1577980"],[40,2,"1416830"],[44,2,"1373080"],[47,2,"1473740"],[50,2,"1269130"],[60,1,"1579170"],[62,2,"1318720"],[65,2,"1375610"]],[[0,2,"きょう"],[10,2,"ていえん"],[18,1,"たましい"],[30,2,"じゅず"],[33,1,"う"],[44,2,"じゅず"],[47,1,"か"],[60,1,"たましい"],[62,2,"じゆう"]]]]