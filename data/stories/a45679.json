[["雪渡り　その一（小狐の紺三郎）",[[4,2,"1006830"],[8,2,"2253000"]],[[0,2,"ゆきわた"],[6,1,"いち"],[8,2,"こぎつね"],[11,3,"こんざぶろう"]]],["雪がすっかり凍って大理石よりも堅くなり、空も冷たい滑らかな青い石の板で出来ているらしいのです。",[[0,1,"1386500"],[2,4,"1006110"],[6,2,"1593100"],[9,3,"1415140"],[15,2,"1257110"],[17,2,"1375610"],[20,1,"1245290"],[22,3,"1556730"],[25,3,"1208560"],[29,2,"1381390"],[31,1,"1382440"],[33,1,"1481350"],[35,2,"1340450"],[38,2,"1577980"]],[[0,1,"ゆき"],[6,1,"こお"],[9,3,"だいりせき"],[15,1,"かた"],[20,1,"そら"],[22,1,"つめ"],[25,1,"なめ"],[29,1,"あお"],[31,1,"いし"],[33,1,"いた"],[35,2,"でき"]]],["「堅雪かんこ、しみ雪しんこ。」",[[1,2,"2569330"],[3,3,"1212980"],[10,3,"1649780"]],[[1,2,"かたゆき"],[9,1,"ゆき"]]],["お日様がまっ白に燃えて百合の匂を撒きちらし又雪をぎらぎら照らしました。",[[0,3,"1270570"],[4,3,"1580620"],[8,2,"1469570"],[11,2,"1488160"],[14,1,"1599760"],[16,5,"1303390"],[22,1,"1386500"],[24,4,"1003650"],[28,3,"1350840"]],[[1,2,"ひさま"],[6,1,"しろ"],[8,1,"も"],[11,2,"ゆり"],[14,1,"におい"],[16,1,"ま"],[21,1,"また"],[22,1,"ゆき"],[28,1,"て"]]],["木なんかみんなザラメを掛けたように霜でぴかぴかしています。",[[0,1,"1534520"],[4,3,"1202150"],[7,3,"1397110"],[11,2,"1207610"],[14,2,"1605845"],[17,1,"1402930"],[19,4,"1010830"],[23,1,"1157170"],[25,1,"1577980"]],[[0,1,"き"],[11,1,"か"],[17,1,"しも"]]],["「堅雪かんこ、凍み雪しんこ。」",[[1,2,"2569330"],[3,3,"1212980"],[9,1,"1386500"],[10,3,"1649780"]],[[1,2,"かたゆき"],[7,1,"し"],[9,1,"ゆき"]]],["四郎とかん子とは小さな雪沓をはいてキックキックキック、野原に出ました。",[[3,3,"1573770"],[8,3,"2136180"],[11,2,"1842310"],[14,2,"1488000"],[23,3,"1041080"],[27,2,"1537360"],[30,1,"1338240"]],[[0,2,"しろう"],[5,1,"し"],[8,1,"ちい"],[11,2,"ゆきぐつ"],[27,2,"のはら"],[30,1,"で"]]],["こんな面白い日が、またとあるでしょうか。いつもは歩けない黍の畑の中でも、すすきで一杯だった野原の上でも、すきな方へどこ迄でも行けるのです。平らなことはまるで一枚の板です。そしてそれが沢山の小さな小さな鏡のようにキラキラキラキラ光るのです。",[[0,3,"1004880"],[3,3,"1533580"],[6,1,"1463770"],[9,2,"1524930"],[12,2,"1296400"],[20,3,"1188890"],[24,2,"1514320"],[28,1,"1226580"],[30,1,"1476520"],[32,1,"1423310"],[36,3,"1475470"],[40,2,"1165670"],[45,2,"1537360"],[48,1,"1352130"],[52,2,"1277450"],[55,1,"1516930"],[57,2,"1577140"],[62,3,"1631370"],[69,2,"1506930"],[72,2,"1241450"],[75,3,"1216280"],[78,2,"1166710"],[81,1,"1481350"],[85,3,"1006730"],[88,2,"1006970"],[91,2,"1415870"],[94,3,"2136180"],[97,3,"2136180"],[100,1,"1238550"],[102,2,"1605845"],[105,4,"1003500"],[109,4,"1003500"],[113,2,"1272820"]],[[3,2,"おもしろ"],[6,1,"ひ"],[24,1,"ある"],[28,1,"きび"],[30,1,"はたけ"],[32,1,"なか"],[40,2,"いっぱい"],[45,2,"のはら"],[48,1,"うえ"],[55,1,"ほう"],[59,1,"まで"],[62,1,"い"],[69,1,"たい"],[78,2,"いちまい"],[81,1,"いた"],[91,2,"たくさん"],[94,1,"ちい"],[97,1,"ちい"],[100,1,"かがみ"],[113,1,"ひか"]]],["「堅雪かんこ、凍み雪しんこ。」",[[1,2,"2569330"],[3,3,"1212980"],[9,1,"1386500"],[10,3,"1649780"]],[[1,2,"かたゆき"],[7,1,"し"],[9,1,"ゆき"]]],["二人は森の近くまで来ました。大きな柏の木は枝も埋まるくらい立派な透きとおった氷柱を下げて重そうに身体を曲げて居りました。",[[0,2,"1582670"],[3,1,"1362490"],[5,2,"1242160"],[9,1,"1547720"],[14,3,"1412890"],[17,1,"1583040"],[19,1,"1534520"],[21,1,"1310530"],[23,3,"1584340"],[29,2,"1551790"],[32,5,"1450510"],[38,2,"1583430"],[41,2,"1184170"],[44,1,"1335750"],[45,2,"1241450"],[48,2,"2830705"],[51,2,"1239740"],[54,2,"1577980"]],[[0,2,"ふたり"],[3,1,"もり"],[5,1,"ちか"],[9,1,"き"],[14,1,"おお"],[17,1,"かしわ"],[19,1,"き"],[21,1,"えだ"],[23,1,"うず"],[29,2,"りっぱ"],[32,1,"す"],[38,2,"つらら"],[41,1,"さ"],[44,1,"おも"],[48,2,"からだ"],[51,1,"ま"],[54,1,"お"]]],["「堅雪かんこ、凍み雪しんこ。狐の子ぁ、嫁ほしい、ほしい。」と二人は森へ向いて高く叫びました。",[[1,2,"2569330"],[3,3,"1212980"],[9,1,"1386500"],[10,3,"1649780"],[14,1,"1267340"],[16,1,"1307770"],[19,1,"1191680"],[20,3,"1547330"],[24,3,"1547330"],[30,2,"1582670"],[33,1,"1362490"],[35,2,"1277080"],[38,2,"1283190"],[40,2,"1235910"]],[[1,2,"かたゆき"],[7,1,"し"],[9,1,"ゆき"],[14,1,"きつね"],[16,1,"こ"],[19,1,"よめい"],[30,2,"ふたり"],[33,1,"もり"],[35,1,"む"],[38,1,"たか"],[40,1,"さけ"]]],["しばらくしいんとしましたので二人はも一度叫ぼうとして息をのみこんだとき森の中から",[[0,4,"1304420"],[4,4,"1359470"],[8,1,"1157170"],[14,2,"1582670"],[18,2,"1576250"],[20,3,"1235910"],[24,1,"1157170"],[26,1,"1404320"],[28,4,"1600400"],[33,2,"1315840"],[35,1,"1362490"],[37,1,"1423310"]],[[14,2,"ふたり"],[18,2,"いちど"],[20,1,"さけ"],[26,1,"いき"],[35,1,"もり"],[37,1,"なか"]]],["「凍み雪しんしん、堅雪かんかん。」と云いながら、キシリキシリ雪をふんで白い狐の子が出て来ました。",[[3,1,"1386500"],[4,4,"1769080"],[9,2,"2569330"],[11,4,"1213790"],[18,2,"1587040"],[30,1,"1386500"],[32,2,"1450270"],[35,2,"1474910"],[37,1,"1267340"],[39,1,"1307770"],[41,1,"1338240"],[43,1,"1547720"]],[[1,1,"し"],[3,1,"ゆき"],[9,2,"かたゆき"],[18,1,"い"],[30,1,"ゆき"],[35,1,"しろ"],[37,1,"きつね"],[39,1,"こ"],[41,1,"で"],[43,1,"き"]]],["四郎は少しぎょっとしてかん子をうしろにかばって、しっかり足をふんばって叫びました。",[[3,2,"1348870"],[5,4,"1003630"],[9,1,"1157170"],[11,3,"1573770"],[15,3,"1269410"],[19,3,"1483060"],[24,4,"1594400"],[28,1,"1404630"],[30,4,"1450280"],[35,2,"1235910"]],[[0,2,"しろう"],[3,1,"すこ"],[13,1,"し"],[28,1,"あし"],[35,1,"さけ"]]],["「狐こんこん白狐、お嫁ほしけりゃ、とってやろよ。」",[[1,1,"1267340"],[2,4,"1004870"],[6,2,"1475140"],[10,1,"1191680"],[11,5,"1547330"],[17,2,"1326980"],[20,2,"1012980"]],[[1,1,"きつね"],[6,2,"びゃっこ"],[10,1,"よめ"]]],["すると狐がまだまるで小さいくせに銀の針のようなおひげをピンと一つひねって云いました。",[[0,2,"1157170"],[3,1,"1267340"],[5,2,"1527110"],[7,3,"1216280"],[10,3,"1347750"],[13,2,"1509350"],[16,1,"1595090"],[18,1,"1366210"],[20,2,"1605845"],[24,2,"1601810"],[27,2,"1107060"],[30,2,"1160820"],[32,3,"1469530"],[36,2,"1587040"]],[[3,1,"きつね"],[10,1,"ちい"],[16,1,"ぎん"],[18,1,"はり"],[30,1,"ひと"],[36,1,"い"]]],["「四郎はしんこ、かん子はかんこ、おらはお嫁はいらないよ。」",[[4,3,"1649780"],[8,3,"1573770"],[12,3,"1212980"],[16,2,"2080360"],[20,1,"1191680"],[22,2,"1465580"]],[[1,2,"しろう"],[10,1,"し"],[20,1,"よめ"]]],["四郎が笑って云いました。",[[3,2,"1351360"],[6,2,"1587040"]],[[0,2,"しろう"],[3,1,"わら"],[6,1,"い"]]],["「狐こんこん、狐の子、お嫁がいらなきゃ餅やろか。」",[[1,1,"1267340"],[2,4,"1004870"],[7,1,"1267340"],[9,1,"1307770"],[12,1,"1191680"],[14,2,"1465580"],[19,1,"1535790"]],[[1,1,"きつね"],[7,1,"きつね"],[9,1,"こ"],[12,1,"よめ"],[19,1,"もち"]]],["すると狐の子も頭を二つ三つ振って面白そうに云いました。",[[0,2,"1157170"],[3,1,"1267340"],[5,1,"1307770"],[7,1,"1582310"],[9,2,"1461160"],[11,2,"1299740"],[13,2,"1361330"],[16,2,"1533580"],[18,2,"1241450"],[21,2,"1587040"]],[[3,1,"きつね"],[5,1,"こ"],[7,1,"あたま"],[9,1,"ふた"],[11,1,"みっ"],[13,1,"ふ"],[16,2,"おもしろ"],[21,1,"い"]]],["「四郎はしんこ、かん子はかんこ、黍の団子をおれやろか。」",[[4,3,"1649780"],[8,3,"1573770"],[12,3,"1212980"],[16,1,"1226580"],[18,2,"1419240"],[21,2,"1577985"]],[[1,2,"しろう"],[10,1,"し"],[16,1,"きび"],[18,2,"だんご"]]],["かん子もあんまり面白いので四郎のうしろにかくれたままそっと歌いました。",[[0,3,"1573770"],[4,4,"1584930"],[8,3,"1533580"],[16,3,"1269410"],[20,3,"1170660"],[24,2,"1585410"],[26,3,"1006810"],[29,2,"1588120"]],[[2,1,"し"],[8,2,"おもしろ"],[13,2,"しろう"],[29,1,"うた"]]],["「狐こんこん狐の子、狐の団子は兎のくそ。」",[[1,1,"1267340"],[2,4,"1004870"],[6,1,"1267340"],[8,1,"1307770"],[10,1,"1267340"],[12,2,"1419240"],[15,1,"1443970"],[17,2,"1504900"]],[[1,1,"きつね"],[6,1,"きつね"],[8,1,"こ"],[10,1,"きつね"],[12,2,"だんご"],[15,1,"うさ"]]],["すると小狐紺三郎が笑って云いました。",[[0,2,"1157170"],[3,2,"2253000"],[9,2,"1351360"],[12,2,"1587040"]],[[3,2,"こぎつね"],[5,1,"こん"],[6,2,"さぶろう"],[9,1,"わら"],[12,1,"い"]]],["「いいえ、決してそんなことはありません。あなた方のような立派なお方が兎の茶色の団子なんか召しあがるもんですか。私らは全体いままで人をだますなんてあんまりむじつの罪をきせられていたのです。」",[[1,3,"1583250"],[5,3,"1254130"],[8,3,"1007130"],[11,2,"1241450"],[14,2,"1296400"],[20,4,"1586560"],[25,2,"1605845"],[28,2,"1551790"],[31,2,"2060470"],[34,1,"1443970"],[36,2,"1422720"],[39,2,"1419240"],[44,5,"1346370"],[49,2,"1584800"],[55,1,"2842390"],[56,1,"2067770"],[58,2,"1395660"],[60,2,"1288850"],[64,1,"1580640"],[66,3,"1574550"],[72,4,"1584930"],[76,3,"1530070"],[80,1,"1296680"],[82,2,"1422990"],[87,1,"1577980"]],[[5,1,"けっ"],[23,1,"かた"],[28,2,"りっぱ"],[32,1,"かた"],[34,1,"うさぎ"],[36,2,"ちゃいろ"],[39,2,"だんご"],[44,1,"め"],[55,1,"わたくし"],[58,2,"ぜんたい"],[64,1,"ひと"],[80,1,"つみ"]]],["四郎がおどろいて尋ねました。",[[3,4,"1238680"],[8,2,"1369940"]],[[0,2,"しろう"],[8,1,"たず"]]],["「そいじゃきつねが人をだますなんて偽かしら。」",[[1,2,"1006970"],[5,3,"1267340"],[9,1,"1580640"],[11,3,"1574550"],[17,1,"1224340"]],[[9,1,"ひと"],[17,1,"うそ"]]],["紺三郎が熱心に云いました。",[[4,2,"1467910"],[7,2,"1587040"]],[[0,1,"こん"],[1,2,"さぶろう"],[4,2,"ねっしん"],[7,1,"い"]]],["「偽ですとも。けだし最もひどい偽です。だまされたという人は大抵お酒に酔ったり、臆病でくるくるしたりした人です。面白いですよ。甚兵衛さんがこの前、月夜の晩私たちのお家の前に坐って一晩じょうるりをやりましたよ。私らはみんな出て見たのです。」",[[1,1,"1224340"],[7,3,"1204550"],[10,2,"1293700"],[12,3,"1602060"],[15,1,"1224340"],[19,3,"1574550"],[25,2,"1587040"],[27,1,"1580640"],[29,2,"1414580"],[31,2,"1329015"],[34,2,"1372650"],[39,2,"1182790"],[42,4,"1003960"],[46,1,"1157170"],[49,1,"1157170"],[51,1,