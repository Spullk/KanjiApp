8710"],[44,3,"1228170"],[48,3,"1157170"]],[[1,1,"こん"],[2,2,"さぶろう"],[7,1,"ぼく"],[10,2,"ちょうど"],[17,1,"もち"],[22,1,"き"],[32,1,"へ"],[42,1,"つぎ"]]],["子狐の紺三郎が嬉しがってみじかい腕をばたばたして云いました。",[[0,2,"2253000"],[7,4,"1219520"],[12,4,"1418620"],[16,1,"1562850"],[18,4,"1098660"],[22,1,"1157170"],[24,2,"1587040"]],[[0,2,"こぎつね"],[3,1,"こん"],[4,2,"さぶろう"],[7,1,"うれ"],[16,1,"うで"],[24,1,"い"]]],["「そうですか。そんなら今度幻燈会のときさしあげましょう。幻燈会にはきっといらっしゃい。この次の雪の凍った月夜の晩です。八時からはじめますから、入場券をあげて置きましょう。何枚あげましょうか。」",[[1,2,"1241450"],[7,2,"1006970"],[11,2,"1289370"],[13,2,"1262990"],[15,1,"1198170"],[17,2,"1315840"],[19,4,"1291270"],[28,2,"1262990"],[30,1,"1198170"],[33,3,"1003430"],[36,6,"1000940"],[43,3,"2398710"],[47,1,"1386500"],[49,2,"1593100"],[52,2,"1255870"],[55,1,"1482110"],[59,2,"2845368"],[63,3,"1307550"],[71,3,"1466380"],[75,2,"1352320"],[78,2,"1421850"],[87,2,"1352320"]],[[11,2,"こんど"],[13,3,"げんとうかい"],[28,2,"げんとう"],[30,1,"かい"],[45,1,"つぎ"],[47,1,"ゆき"],[49,1,"こお"],[52,2,"つきよ"],[55,1,"ばん"],[59,2,"はちじ"],[71,3,"にゅうじょうけん"],[78,1,"お"],[85,2,"なんまい"]]],["「そんなら五枚お呉れ。」と四郎が云いました。",[[1,2,"1006970"],[6,1,"1524610"],[8,2,"1269130"],[16,2,"1587040"]],[[5,1,"ご"],[6,1,"まい"],[8,1,"く"],[13,2,"しろう"],[16,1,"い"]]],["「五枚ですか。あなた方が二枚にあとの三枚はどなたですか。」と紺三郎が云いました。",[[2,1,"1524610"],[7,4,"1586560"],[12,2,"1954200"],[15,2,"1269320"],[18,2,"1301680"],[21,3,"1189370"],[34,2,"1587040"]],[[1,1,"ご"],[2,1,"まい"],[10,1,"かた"],[12,2,"にまい"],[18,2,"さんまい"],[30,1,"こん"],[31,2,"さぶろう"],[34,1,"い"]]],["「兄さんたちだ。」と四郎が答えますと、",[[1,3,"1249910"],[4,2,"1416220"],[13,2,"1449540"]],[[1,1,"にい"],[10,2,"しろう"],[13,1,"こた"]]],["「兄さんたちは十一歳以下ですか。」と紺三郎が又尋ねました。",[[1,3,"1249910"],[4,2,"1416220"],[9,1,"1468060"],[10,2,"1155060"],[22,1,"1524930"],[23,2,"1369940"]],[[1,1,"にい"],[7,2,"じゅういち"],[9,1,"さい"],[10,2,"いか"],[18,1,"こん"],[19,2,"さぶろう"],[22,1,"また"],[23,1,"たず"]]],["「いや小兄さんは四年生だからね、八つの四つで十二歳。」と四郎が云いました。",[[1,2,"2857380"],[4,3,"1249910"],[8,3,"1951920"],[16,2,"1583095"],[19,2,"1307040"],[24,1,"1468060"],[31,2,"1587040"]],[[3,2,"ちいにい"],[8,3,"よんねんせい"],[16,1,"よう"],[19,1,"よん"],[22,2,"じゅう