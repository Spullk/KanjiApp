[["春のあたたかい日のこと、わたし舟にふたりの小さな子どもをつれた女の旅人がのりました。",[[0,1,"1341000"],[2,5,"1586420"],[7,1,"1463770"],[9,2,"1241450"],[12,3,"1311110","私",3],[15,1,"1602800"],[17,3,"1582670","二人",3],[21,3,"2136180"],[24,3,"1307850"],[28,2,"1559290"],[31,1,"1344930"],[33,2,"1553210"],[36,2,"1355120","乗",1]],[[0,1,"はる"],[7,1,"ひ"],[15,1,"ぶね"],[21,1,"ちい"],[24,1,"こ"],[31,1,"おんな"],[33,2,"たびびと"]]],["舟が出ようとすると、",[[0,1,"1602800"],[2,3,"1338240"],[6,2,"1157170"]],[[0,1,"ふね"],[2,1,"で"]]],["「おオい、ちょっとまってくれ。」",[[5,4,"1163940"],[9,2,"1410590","待",1],[12,2,"1269130"]],[]],["と、どての向こうから手をふりながら、さむらいがひとり走ってきて、舟にとびこみました。",[[2,2,"1445370"],[5,3,"1277140"],[10,1,"1327190"],[12,2,"1282790"],[18,4,"1314780","侍",4],[23,3,"1576150","一人",3],[26,2,"1402540"],[29,1,"1547720"],[32,1,"1602800"],[34,4,"1598890","飛び込",3]],[[5,1,"む"],[10,1,"て"],[26,1,"はし"],[32,1,"ふね"]]],["舟は出ました。",[[0,1,"1602800"],[2,1,"1338240"]],[[0,1,"ふね"],[2,1,"で"]]],["さむらいは舟のまん中にどっかりすわっていました。ぽかぽかあたたかいので、そのうちにいねむりをはじめました。",[[0,4,"1314780","侍",4],[5,1,"1602800"],[7,3,"1604350"],[11,4,"2078720"],[15,3,"1291800"],[19,1,"1577980"],[24,4,"1011930"],[28,5,"1586420"],[36,4,"1006930"],[41,4,"1231890","居眠",3],[46,3,"1307550","始",2]],[[5,1,"ふね"],[9,1,"なか"]]],["黒いひげをはやして、つよそうなさむらいが、こっくりこっくりするので、子どもたちはおかしくて、ふふふと笑いました。",[[0,2,"1287420"],[2,2,"1601810"],[5,3,"1378760"],[10,2,"1236070","強",2],[12,2,"1006610"],[15,4,"1314780","侍",4],[21,8,"2008090"],[29,2,"1157170"],[34,5,"1307870"],[40,4,"1190860"],[46,3,"1111010"],[50,2,"1351360"]],[[0,1,"くろ"],[34,1,"こ"],[50,1,"わら"]]],["お母さんは口に指をあてて、",[[0,4,"1002650"],[5,1,"1275640"],[7,1,"1309650"],[9,2,"1448860","当",1]],[[1,1,"かあ"],[5,1,"くち"],[7,1,"ゆび"]]],["「だまっておいで。」",[[1,3,"1534930","黙",2],[6,2,"1338240"]],[]],["といいました。さむらいがおこってはたいへんだからです。",[[1,2,"1587040","言",1],[7,4,"1314780","侍",4],[12,3,"1223680"],[17,4,"1415000","大変",4]],[]],["子どもたちはだまりました。",[[0,5,"1307870"],[6,3,"1534930","黙",2]],[[0,1,"こ"]]],["しばらくするとひとりの子どもが、",[[0,4,"1304420"],[4,2,"1157170"],[7,3,"1576150","一人",3],[11,3,"1307850"]],[[11,1,"こ"]]],["「かあちゃん、飴だまちょうだい。」",[[1,5,"2399270","母",2],[7,1,"1153520"],[9,1,"1012050"],[10,5,"1430230","頂戴",5]],[[7,1,"あめ"]]],["と手をさしだしました。",[[1,1,"1327190"],[3,4,"1291230","差し出",3]],[[1,1,"て"]]],["すると、もうひとりの子どもも、",[[0,2,"1157170"],[4,5,"2267340","もう一人",5],[10,3,"1307850"]],[[10,1,"こ"]]],["「かあちゃん、あたしにも。」",[[1,5,"2399270","母",2],[7,3,"1311125"]],[]],["といいました。",[[1,2,"1587040","言",1]],[]],["お母さんはふところから、紙のふくろをとりだしました。ところが、飴だまはもう一つしかありませんでした。",[[0,4,"1002650"],[5,4,"1200480","懐",4],[12,1,"1311530"],[14,3,"1411070","袋",3],[18,4,"1326770","取り出",3],[26,3,"1343100","所",3],[31,1,"1153520"],[32,2,"2835187"],[35,4,"2070970"],[41,2,"1296400"]],[[1,1,"かあ"],[12,1,"かみ"],[31,1,"あめ"],[37,1,"ひと"]]],["「あたしにちょうだい。」",[[1,3,"1311125"],[5,5,"1430230","頂戴",5]],[]],["「あたしにちょうだい。」",[[1,3,"1311125"],[5,5,"1430230","頂戴",5]],[]],["ふたりの子どもは、りょうほうからせがみました。飴だまは一つしかないので、お母さんはこまってしまいました。",[[0,3,"1582670","二人",3],[4,3,"1307850"],[9,5,"1554010"],[16,3,"1006490"],[23,1,"1153520"],[24,2,"2835187"],[27,2,"1160820"],[31,2,"1529520"],[36,4,"1002650"],[41,3,"1289590","困",2],[45,3,"1305380"]],[[4,1,"こ"],[23,1,"あめ"],[27,1,"ひと"],[37,1,"かあ"]]],["「いい子たちだから待っておいで、向こうへついたら買ってあげるからね。」",[[1,3,"1835640"],[4,2,"1416220"],[9,2,"1410590"],[13,2,"1338240"],[16,3,"1277140"],[20,2,"1495740","付",1],[24,2,"1473740"],[27,3,"1352320"]],[[3,1,"こ"],[9,1,"ま"],[16,1,"む"],[24,1,"か"]]],["といってきかせても、子どもたちは、ちょうだいよオ、ちょうだいよオ、とだだをこねました。",[[1,2,"1587040","言",1],[4,2,"1591100"],[10,5,"1307870"],[17,5,"1430230","頂戴",5],[25,5,"1430230","頂戴",5],[34,2,"2431160","駄々",2],[37,2,"1567410"]],[[10,1,"こ"]]],["いねむりをしていたはずのさむらいは、ぱっちり眼をあけて、子どもたちがせがむのをみていました。",[[0,4,"1231890","居眠",3],[5,1,"1157170"],[7,1,"1577980"],[9,2,"1476430"],[12,4,"1314780","侍",4],[18,4,"1010430"],[22,1,"1604890"],[24,2,"1202450"],[28,5,"1307870"],[34,3,"1006490"],[39,1,"1259290","見",1],[41,1,"1577980"]],[[22,1,"め"],[28,1,"こ"]]],["お母さんはおどろきました。いねむりをじゃまされたので、このおさむらいはおこっているのにちがいない、と思いました。",[[0,4,"1002650"],[5,4,"1238680","驚",3],[13,4,"1231890","居眠",3],[18,3,"1323500","邪魔",3],[21,1,"1157170"],[27,2,"1582920"],[30,4,"1314780","侍",4],[35,3,"1223680"],[39,2,"1577980"],[43,5,"1610740","違",2],[50,2,"1589350"]],[[1,1,"かあ"],[50,1,"おも"]]],["「おとなしくしておいで。」",[[1,5,"1414190"],[6,1,"1157170"],[9,2,"1338240"]],[]],["と、お母さんは子どもたちをなだめました。",[[2,4,"1002650"],[7,5,"1307870"],[13,3,"1540250"]],[[3,1,"かあ"],[7,1,"こ"]]],["けれど子どもたちはききませんでした。",[[0,3,"2853889"],[3,5,"1307870"],[9,2,"1591100"]],[[3,1,"こ"]]],["するとさむらいが、すらりと刀をぬいて、お母さんと子どもたちのまえにやってきました。",[[0,2,"1157170"],[3,4,"1314780","侍",4],[9,3,"1006250"],[13,1,"1446420"],[15,2,"1478190","抜",1],[19,4,"1002650"],[24,5,"1307870"],[30,2,"1392580","前",2],[33,2,"1012980"],[36,1,"1547720"]],[[13,1,"かたな"],[20,1,"かあ"],[24,1,"こ"]]],["お母さんはまっさおになって、子どもたちをかばいました。いねむりのじゃまをした子どもたちを、さむらいがきりころすと思ったのです。",[[0,4,"1002650"],[5,4,"1604080","真っ青",4],[10,2,"1375610"],[14,5,"1307870"],[20,3,"1483060"],[27,4,"1231890","居眠",3],[32,3,"1323500","邪魔",3],[36,1,"1157170"],[38,5,"1307870"],[45,4,"1314780","侍",4],[52,3,"1299030","殺",2],[56,2,"1589350"]],[[1,1,"かあ"],[14,1,"こ"],[38,1,"こ"],[56,1,"おも"]]],["「飴だまを出せ。」",[[1,1,"1153520"],[2,2,"2835187"],[5,2,"1338180"]],[[1,1,"あめ"],[5,1,"だ"]]],["とさむらいはいいました。",[[1,4,"1314780","侍",4],[6,2,"1587040","言",1]],[]],["お母さんはおそるおそる飴だまをさしだしました。",[[0,4,"1002650"],[5,6,"1609410","恐る恐",5],[11,1,"1153520"],[12,2,"2835187"],[15,4,"1291230","差し出",3]],[[1,1,"かあ"],[11,1,"あめ"]]],["さむらいはそれを舟のへりにのせ、刀でぱちんと二つにわりました。",[[0,4,"1314780","侍",4],[5,2,"1006970"],[8,1,"1602800"],[10,2,"2056370"],[13,2,"1600270","乗",1],[16,1,"1446420"],[18,3,"2523860"],[22,2,"1461160"],[25,2,"1208000","割",1]],[[8,1,"ふね"],[16,1,"かたな"],[22,1,"ふた"]]],["そして、",[[0,3,"1006730"]],[]],["「そオれ。」",[[1,1,"2137720"]],[]],["とふたりの子どもにわけてやりました。",[[0,1,"1579840"],[1,3,"1582670","二人",3],[5,3,"1307850"],[9,2,"1503000","分",1],[12,2,"1012980"]],[[5,1,"こ"]]],["それから、またもとのところにかえって、こっくりこっくりねむりはじめました。",[[0,2,"1006970"],[5,2,"1524930"],[7,2,"1260670"],[10,3,"1343100","所",3],[14,3,"1589780"],[19,8,"2008090"],[27,3,"1529390","眠",2],[30,3,"1307550","始",2]],[]]]