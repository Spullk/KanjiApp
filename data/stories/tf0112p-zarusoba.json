[["①大きいなべに、水を入れます。③そばを入れます。②火をつけます。④３分～４分くらいゆでます。",[[1,3,"1588880"],[4,2,"1459720"],[8,1,"1371260"],[10,2,"1465610"],[16,2,"1403830"],[19,2,"1465610"],[25,1,"1193610"],[27,2,"1433680"],[34,1,"1502860"],[37,1,"1502860"],[41,2,"1571470"]],[[1,1,"おお"],[8,1,"みず"],[10,1,"い"],[19,1,"い"],[25,1,"か"],[34,1,"ふん"],[37,1,"ふん"]]],["⑤お湯を捨てます。⑦水をきります。⑥そばを冷たい水で洗います。",[[1,2,"1002510"],[4,2,"1322320"],[10,1,"1371260"],[12,2,"1384830"],[18,2,"1403830"],[21,3,"1556730"],[24,1,"1371260"],[26,2,"1390930"]],[[2,1,"ゆ"],[4,1,"す"],[10,1,"すい"],[21,1,"つめ"],[24,1,"みず"],[26,1,"あら"]]],["できました!さあ、食べましょう!いただきまーす!のり",[[0,2,"1340450"],[6,2,"1005110"],[9,2,"1358280"],[16,4,"1587290"],[20,2,"1012050"],[24,2,"1354720"]],[[9,1,"た"]]],["ざるそばのおいしい食べ方①わさびとねぎを、少しつゆに入れます。おそば屋さんに、おいしい食べ方を聞きました。おいしい食べ方?",[[0,4,"2105450"],[5,4,"1486650"],[9,3,"1358370"],[13,3,"1302710"],[17,2,"1467630"],[21,2,"1348870"],[23,2,"1335520"],[26,2,"1465610"],[32,3,"1610140"],[35,2,"1579350"],[39,4,"1486650"],[43,3,"1358370"],[47,2,"1591110"],[53,4,"1486650"],[57,3,"1358370"]],[[9,3,"たべかた"],[21,1,"すこ"],[26,1,"い"],[34,1,"や"],[43,3,"たべかた"],[47,1,"き"],[57,3,"たべかた"]]],["②そばを４、５本とります。④そばを、すすって食べます。③半分くらい、つゆに入れます。",[[1,2,"1403830"],[7,1,"1522150"],[8,2,"1326980"],[14,2,"1403830"],[18,3,"1565270"],[22,2,"1358280"],[28,2,"1479890"],[34,2,"1335520"],[37,2,"1465610"]],[[7,1,"ぽん"],[22,1,"た"],[28,2,"はんぶん"],[37,1,"い"]]],["⑤そして、はやく食べます。ごちそうさまおいしかった!!おいしい!でもおいしい!!むずかしい!",[[1,3,"1006730"],[5,3,"1404975"],[8,2,"1358280"],[13,6,"1270520"],[19,5,"1486650"],[27,4,"1486650"],[34,4,"1486650"],[40,5,"1460850"]],[[8,1,"た"]]]]