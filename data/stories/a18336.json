[["一",[],[[0,1,"いち"]]],["むかし、上野国館林に、茂林寺というお寺がありました。このお寺の和尚さんはたいそうお茶の湯がすきで、いろいろとかわったお茶道具を集めてまいにち、それをいじっては楽しみにしていました。",[[0,3,"1382370"],[6,1,"1592250"],[15,2,"1587040"],[17,2,"2271230"],[20,2,"1296400"],[26,2,"1582920"],[28,2,"2271230"],[31,2,"1562120"],[33,2,"1579350"],[36,4,"1414380"],[41,3,"1422610"],[45,2,"1277450"],[49,4,"1587850"],[54,3,"1510790"],[59,3,"1422790"],[63,2,"1333560"],[66,4,"1524720"],[71,2,"1006970"],[74,3,"1560700"],[79,3,"1207250"],[83,1,"1157170"],[85,1,"1577980"]],[[4,3,"こうずけのくに"],[7,2,"たてばやし"],[11,3,"もりんじ"],[18,1,"てら"],[29,1,"てら"],[31,2,"おしょう"],[41,1,"ちゃ"],[43,1,"ゆ"],[59,1,"ちゃ"],[60,2,"どうぐ"],[63,1,"あつ"],[79,1,"たの"]]],["ある日和尚さんは用事があって町へ行った帰りに、一軒の道具屋で、気に入った形の茶がまを見つけました。和尚さんはさっそくそれを買って帰って、自分のお部屋に飾って、",[[0,2,"1586840"],[2,2,"1464950"],[5,2,"1579350"],[8,2,"1546300"],[11,2,"1296400"],[14,1,"1603990"],[16,2,"1578850"],[19,2,"1221250"],[23,2,"1162190"],[26,3,"1770740"],[31,1,"1221520"],[33,2,"1465590"],[36,1,"1250220"],[38,3,"1711500"],[42,3,"1604570"],[49,2,"1562120"],[51,2,"1579350"],[54,4,"1400300"],[58,2,"1006970"],[61,2,"1473740"],[64,2,"1221270"],[68,2,"1318610"],[71,3,"2453580"],[75,2,"1357210"]],[[3,2,"おしょう"],[8,2,"ようじ"],[14,1,"まち"],[16,1,"い"],[19,1,"かえ"],[24,1,"けん"],[26,3,"どうぐや"],[31,1,"き"],[33,1,"い"],[36,1,"かたち"],[38,1,"ちゃ"],[42,1,"み"],[49,2,"おしょう"],[61,1,"か"],[64,1,"かえ"],[68,2,"じぶん"],[72,2,"へや"],[75,1,"かざ"]]],["「どうです、なかなかいい茶がまでしょう。」",[[1,2,"1451160"],[6,4,"1599420"],[10,2,"1605820"],[12,3,"1711500"]],[[12,1,"ちゃ"]]],["と、来る人ごとに見せて、じまんしていました。",[[2,2,"1547720"],[4,3,"1367880"],[8,2,"1259210"],[12,3,"1318680"],[15,1,"1157170"],[17,1,"1577980"]],[[2,1,"く"],[4,1,"ひと"],[8,1,"み"]]],["ある晩和尚さんはいつものとおりお居間に茶がまを飾ったまま、そのそばでうとうと居眠りをしていました。そのうちほんとうにぐっすり、寝込んでしまいました。",[[0,2,"1586840"],[2,1,"1482110"],[3,2,"1562120"],[5,2,"1579350"],[8,3,"1188890"],[12,3,"1432920"],[16,2,"1231720"],[19,3,"1711500"],[23,2,"1357210"],[26,2,"1585410"],[29,2,"1006830"],[31,2,"1403830"],[34,4,"1001030"],[38,3,"1231890"],[42,1,"1157170"],[44,1,"1577980"],[49,4,"1006930"],[53,4,"152