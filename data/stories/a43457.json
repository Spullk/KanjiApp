,"1547720"],[8,4,"1415870"],[12,3,"1551790"],[17,2,"1605460"],[20,4,"1551460"],[25,1,"1423310"],[28,4,"1165970"],[32,1,"1604890"],[34,2,"1629170"],[37,3,"1551790"],[41,3,"1724760"],[46,2,"1605460"],[49,2,"1296400"],[55,4,"1163970"]],[[0,2,"さんじょう"],[4,1,"く"],[17,2,"やしき"],[20,1,"た"],[22,1,"なら"],[25,1,"なか"],[32,1,"め"],[41,2,"もんがま"],[46,2,"やしき"],[55,4,"いっすんぼうし"]]],["「なんでも出世をするには、まずだれかえらい人の家来になって、それからだんだんにし上げなければならない。これこそいちばんえらい人のお屋敷に違いない。」",[[1,2,"2846738"],[5,2,"1339340"],[8,2,"1157170"],[13,2,"1387240"],[15,2,"1416830"],[18,4,"1155800"],[23,2,"1192530"],[26,2,"1375610"],[30,2,"1006970"],[34,4,"1597350"],[39,1,"1157170"],[40,2,"1352320"],[46,2,"1375610"],[51,2,"1628530"],[55,4,"1165970"],[59,4,"1155800"],[65,2,"1605460"],[68,4,"1610740"]],[[5,2,"しゅっせ"],[21,1,"ひと"],[23,2,"けらい"],[40,1,"あ"],[62,1,"ひと"],[65,2,"やしき"],[68,1,"ちが"]]],["と思って、のこのこ門の中に入っていきました。広い砂利道をさんざん歩いて、大きな玄関の前に立ちました。なるほどここは三条の宰相殿といって、羽ぶりのいい大臣のお屋敷でした。",[[1,2,"1589350"],[5,4,"1009920"],[9,1,"1584800"],[11,1,"1423310"],[13,2,"1465590"],[16,2,"1578850"],[22,2,"1278410"],[24,3,"1754470"],[28,4,"1593980"],[32,2,"1514320"],[36,3,"1412890"],[39,2,"1263400"],[42,1,"1392580"],[44,2,"1597040"],[50,4,"1375820"],[54,2,"1288810"],[58,1,"2078550"],[60,2,"1294380"],[62,1,"1442490"],[64,2,"1587040"],[68,3,"1171790"],[72,2,"1605820"],[74,2,"1414160"],[78,2,"1605460"]],[[1,1,"おも"],[9,1,"もん"],[11,1,"なか"],[13,1,"はい"],[22,1,"ひろ"],[24,3,"じゃりみち"],[32,1,"ある"],[36,1,"おお"],[39,2,"げんかん"],[42,1,"まえ"],[44,1,"た"],[57,2,"さんじょう"],[60,3,"さいしょうどの"],[68,1,"は"],[74,2,"だいじん"],[78,2,"やしき"]]],["そのとき一寸法師は、ありったけの大きな声で、",[[0,4,"2002300"],[4,4,"1163970"],[10,5,"2097570"],[16,3,"1412890"],[19,1,"1380440"]],[[4,4,"いっすんぼうし"],[16,1,"おお"],[19,1,"こえ"]]],["「ごめん下さい。」",[[1,3,"1270670"],[4,3,"1184280"]],[[4,1,"くだ"]]],["とどなりました。でも聞こえないとみえて、だれも出てくるものがないので、こんどはいっそう大きな声を出して、",[[0,2,"1201690"],[2,2,"1375610"],[10,3,"1591150"],[16,2,"1259140"],[20,2,"1416830"],[23,1,"1338240"],[25,2,"1547720"],[27,2,"1502390"],[30,2,"1529520"],[35,3,"1289370"],[39,4,"1164340"],[43,3,