[["一",[],[[0,1,"いち"]]],["むかし、摂津国の難波という所に、夫婦の者が住んでおりました。子供が一人も無いものですから、住吉の明神さまに、おまいりをしては、",[[0,3,"1382370"],[6,1,"1592250"],[11,2,"1587040"],[13,1,"1343100"],[16,2,"1583640"],[19,1,"1322990"],[21,2,"1334040"],[24,2,"1577985"],[30,2,"1307850"],[33,2,"1576150"],[36,2,"1529520"],[38,2,"1502390"],[48,2,"2532610"],[50,2,"1545790"],[54,4,"1001950"],[59,1,"1157170"]],[[4,3,"せっつのくに"],[8,2,"なにわ"],[13,1,"ところ"],[16,2,"ふうふ"],[19,1,"もの"],[21,1,"す"],[30,2,"こども"],[33,2,"ひとり"],[36,1,"な"],[45,2,"すみよし"],[48,2,"みょうじん"]]],["「どうぞ子供を一人おさずけ下さいまし。それは指ほどの小さな子でもよろしゅうございますから。」",[[1,3,"1189130"],[4,2,"1307850"],[7,2,"1576150"],[10,3,"1330280"],[13,3,"1184280"],[19,2,"1006970"],[22,1,"1309650"],[26,3,"2136180"],[29,1,"1307770"],[32,5,"1224890"],[37,3,"1270350"]],[[4,2,"こども"],[7,2,"ひとり"],[13,1,"くだ"],[22,1,"ゆび"],[26,1,"ちい"],[29,1,"こ"]]],["と一生懸命にお願い申しました。",[[0,1,"1579840"],[1,4,"1164010"],[6,3,"2036870"],[9,2,"1363090"]],[[1,4,"いっしょうけんめい"],[7,1,"ねが"],[9,1,"もう"]]],["すると間もなく、お上さんは身持ちになりました。",[[0,2,"1157170"],[3,1,"1215240"],[5,2,"1529520"],[8,4,"2453480"],[13,3,"1705950"],[17,2,"1375610"]],[[3,1,"ま"],[9,1,"かみ"],[13,2,"みも"]]],["「わたしどものお願いがかなったのだ。」",[[1,5,"1854980"],[7,3,"2036870"],[11,3,"1208870"]],[[8,1,"ねが"]]],["と夫婦はよろこんで、子供の生まれる日を、今日か明日かと待ちかまえていました。",[[1,2,"1583640"],[4,4,"1218760"],[10,2,"1307850"],[13,4,"1378690"],[17,1,"1463770"],[20,2,"1579110"],[23,2,"1584660"],[27,5,"1410500"],[33,1,"1577980"]],[[1,2,"ふうふ"],[10,2,"こども"],[13,1,"う"],[17,1,"ひ"],[20,2,"きょう"],[23,2,"あす"],[27,1,"ま"]]],["やがてお上さんは小さな男の赤ちゃんを生みました。ところがそれがまた小さいといって、ほんとうに指ほどの大きさしかありませんでした。",[[0,3,"1012730"],[3,4,"2453480"],[8,3,"2136180"],[11,1,"1419990"],[13,4,"1383260"],[18,2,"1588410"],[24,3,"1343100"],[28,2,"1006970"],[31,2,"1524930"],[33,3,"1347750"],[37,2,"1587040"],[41,4,"1523060"],[46,1,"1309650"],[50,3,"1412910"],[55,2,"1296400"]],[[4,1,"かみ"],[8,1,"ちい"],[11,1,"おとこ"],[13,1,"あか"],[18,1,"う"],[33,1,"ちい"],[46,1,"ゆび"],[50,1,"おお"]]],["「指ほどの大きさの子供でも、と申し上げたら、ほんとうに指だけの子供を明神さまが下さった。」",[[1,1,"1309650"],[5,3,"1412910"],[9,2,"1307850"],[15,4,"1362950"],[22,4,"1523060"],[27,1,"1309650"],[31,2,"1307850"],[34,2,"2532610"],[36,2,"1545790"],[39,3,"1184280"]],[[1,1,"ゆび"],[5,1,"おお"],[9,2,"こども"],[15,1,"もう"],[17,1,"あ"],[27,1,"ゆび"],[31,2,"こども"],[34,2,"みょうじん"],[39,1,"くだ"]]],["と夫婦は笑いながら、この子供をだいじにして育てました。ところがこの子は、いつまでたってもやはり指だけより大きくはなりませんでした。夫婦もあきらめて、その子に一寸法師と名前をつけました。一寸法師は五つになっても、やはり背がのびません。七つになっても、同じことでした。十を越しても、やはり一寸法師でした。一寸法師が往来を歩いていると、近所の子供たちが集まってきて、",[[1,2,"1583640"],[4,2,"1351360"],[10,2,"1582920"],[12,2,"1307850"],[15,3,"1413940"],[19,1,"1157170"],[21,2,"1160570"],[27,3,"1343100"],[31,2,"1582920"],[33,1,"1307770"],[36,2,"1268060"],[40,2,"1629170"],[44,3,"2772770"],[47,1,"1309650"],[52,3,"1588880"],[56,2,"1375610"],[65,2,"1583640"],[68,4,"1436730"],[74,2,"1006830"],[76,1,"1307770"],[78,4,"1163970"],[83,2,"1531710"],[86,2,"1433680"],[92,4,"1163970"],[97,2,"1268070"],[100,2,"1375610"],[105,3,"2772770"],[108,1,"2147990"],[110,2,"1358870"],[116,2,"1319220"],[119,2,"1375610"],[124,2,"1451750"],[126,2,"1241450"],[134,2,"1175300"],[139,3,"2772770"],[142,4,"1163970"],[150,4,"1163970"],[155,2,"1179790"],[158,2,"1514320"],[161,2,"1577980"],[165,2,"1242350"],[168,4,"1307870"],[173,3,"1333550"],[177,1,"1547720"]],[[1,2,"ふうふ"],[4,1,"わら"],[12,2,"こども"],[21,1,"そだ"],[33,1,"こ"],[47,1,"ゆび"],[52,1,"おお"],[65,2,"ふうふ"],[76,1,"こ"],[78,4,"いっすんぼうし"],[83,2,"なまえ"],[92,4,"いっすんぼうし"],[97,1,"いつ"],[108,1,"せい"],[116,1,"なな"],[124,1,"おな"],[132,1,"じゅう"],[134,1,"こ"],[142,4,"いっすんぼうし"],[150,4,"いっすんぼうし"],[155,2,"おうらい"],[158,1,"ある"],[165,2,"きんじょ"],[168,2,"こども"],[173,1,"あつ"]]],["「やあ、ちびが歩いている。」",[[1,2,"2089490"],[4,2,"1077750"],[7,2,"1514320"],[10,2,"1577980"]],[[7,1,"ある"]]],["「ふみ殺されるなよ。」",[[1,2,"1450270"],[3,2,"1299030"]],[[3,1,"ころ"]]],["「つまんでかみつぶしてやろうか。」",[[1,3,"1598080"],[5,5,"1848780"],[11,3,"1012980"]],[]],["「ちびやい。ちびやい。」",[[1,2,"1077750"],[3,2,"2648350"],[6,2,"1077750"],[8,2,"2648350"]],[]],["と口々にいって、からかいました。一寸法師はだまって、にこにこしていました。",[[1,2,"1592190"],[4,2,"1578850"],[8,4,"1567650"],[16,4,"1163970"],[21,3,"1534930"],[26,4,"1091130"],[30,1,"1157170"],[32,1,"1577980"]],[[1,2,"くちぐち"],[16,4,"いっすんぼうし"]]],["二",[],[[0,1,"に"]]],["一寸法師は十六になりました。ある日一寸法師は、おとうさんとおかあさんの前へ出て、",[[0,4,"1163970"],[8,2,"1375610"],[14,3,"1153630"],[17,4,"1163970"],[23,5,"1002590"],[29,5,"1002650"],[35,1,"1392580"],[37,1,"1338240"]],[[0,4,"いっすんぼうし"],[5,2,"じゅうろく"],[16,1,"ひ"],[17,4,"いっすんぼうし"],[35,1,"まえ"],[37,1,"で"]]],["「どうかわたくしにお暇を下さい。」",[[1,2,"1451160"],[4,4,"2842390"],[9,2,"2869595"],[12,3,"1184280"]],[[10,1,"ひま"],[12,1,"くだ"]]],["といいました。おとうさんはびっくりして、",[[1,2,"1587040"],[7,5,"1002590"],[13,4,"1226360"],[17,1,"1157170"]],[]],["「なぜそんなことをいうのだ。」",[[1,2,"1577120"],[3,3,"1007130"],[6,2,"1241450"],[9,2,"1587040"]],[]],["と聞きました。一寸法師はとくいらしい顔をして、",[[1,2,"1591110"],[7,4,"1163970"],[12,3,"1454510"],[15,3,"1013240"],[18,1,"1217730"],[20,1,"1157170"]],[[1,1,"き"],[7,4,"いっすんぼうし"],[18,1,"かお"]]],["「これから京都へ上ろうと思います。」",[[1,2,"1628530"],[8,3,"1352570"],[12,2,"1589350"]],[[5,2,"きょうと"],[8,1,"のぼ"],[12,1,"おも"]]],["といいました。",[[1,2,"1587040"]],[]],["「京都へ上ってどうするつもりだ。」",[[4,2,"1352570"],[7,2,"1451160"],[9,2,"1157170"],[11,3,"1382980"]],[[1,2,"きょうと"],[4,1,"のぼ"]]],["「京都は天子さまのいらっしゃる日本一の都ですし、おもしろいしごとがたくさんあります。わたくしはそこへ行って、運だめしをしてみようと思います。」",[[4,2,"1439180"],[6,2,"1545790"],[9,6,"1000940"],[15,3,"1730040"],[19,1,"1621470"],[24,5,"1533580"],[29,3,"1304970"],[33,4,"1415870"],[37,2,"1296400"],[42,4,"2842390"],[47,2,"1436050"],[50,2,"1578850"],[54,4,"1667590"],[59,1,"1157170"],[61,3,"1259290"],[65,2,"1589350"]],[[1,2,"きょうと"],[4,2,"てんし"],[15,3,"にっぽんいち"],[19,1,"みやこ"],[50,1,"い"],[54,1,"うん"],[65,1,"おも"]]],["そう聞くとおとうさんはうなずいて、",[[0,2,"1241450"],[2,2,"1591110"],[5,5,"1002590"],[11,4,"1574310"]],[[2,1,"き"]]],["「よしよし、それなら行っておいで。」",[[1,4,"2152570"],[6,2,"1006970"],[10,2,"1578850"],[14,2,"1338240"]],[[10,1,"い"]]],["と許して下さいました。",[[1,2,"1232870"],[4,3,"1184280"]],[[1,1,"ゆる"],[4,1,"くだ"]]],["一寸法師は大へんよろこんで、さっそく旅の支度にかかりました。まずおかあさんにぬい針を一本頂いて、麦わらで柄とさやをこしらえて、刀にして腰にさしました。それから新しいおわんのお舟に、新しいおはしのかいを添えて、住吉の浜から舟出をしました。おとうさんとおかあさんは浜べまで見送りに立って下さいました。",[[0,4,"1163970"],[5,3,"1415000"],[8,4,"1218760"],[14,4,"1400300"],[18,1,"1553120"],[20,2,"1310260"],[23,3,"1207590"],[30,2,"1387240"],[32,5,"1002650"],[38,3,"1599950"],[42,2,"1166600"],[44,2,"1587290"],[48,3,"1583080"],[52,1,"1508300"],[54,2,"1352120"],[57,4,"1567390"],[63,1,"1446420"],[65,1,"1157170"],[67,1,"1288340"],[69,2,"1306470"],[75,2,"1006970"],[79,3,"1361490"],[82,3,"1002760"],[87,1,"1602800"],[90,3,"1361490"],[94,2,"1237410"],[97,2,"1636070"],[100,2,"1596490"],[107,1,"1490710"],[110,2,"1736050"],[113,1,"1157170"],[118,5,"1002590"],[124,5,"1002650"],[130,2,"1490720"],[134,3,"1259820"],[138,2,"1597040"],[141,3,"1184280"]],[[0,4,"いっすんぼうし"],[5,1,"たい"],[18,1,"たび"],[20,2,"したく"],[40,1,"ばり"],[43,1,"ぽん"],[44,1,"いただ"],[48,1,"むぎ"],[52,1,"え"],[63,1,"かたな"],[67,1,"こし"],[79,1,"あたら"],[87,1,"ふね"],[90,1,"あたら"],[100,1,"そ"],[104,2,"すみよし"],[107,1,"はま"],[110,2,"ふなで"],[130,1,"はま"],[134,2,"みおく"],[138,1,"た"],[141,1,"くだ"]]],["「おとうさん、おかあさん、では行ってまいります。」",[[1,5,"1002590"],[7,5,"1002650"],[15,2,"1578850"],[18,3,"1302070"]],[[15,1,"い"]]],["と一寸法師がいって、舟をこぎ出しますと、おとうさんとおかあさんは、",[[0,1,"1579840"],[1,4,"1163970"],[6,2,"1587040"],[10,1,"1602800"],[12,4,"1850900"],[20,5,"1002590"],[26,5,"1002650"]],[[1,4,"いっすんぼうし"],[10,1,"ふね"],[14,1,"だ"]]],["「どうか達者で、出世をしておくれ。」",[[1,2,"1451160"],[4,2,"1416240"],[8,2,"1339340"],[11,1,"1157170"],[13,3,"1589040"]],[[4,2,"たっしゃ"],[8,2,"しゅっせ"]]],["といいました。",[[1,2,"1587040"]],[]],["「ええ、きっと出世をいたします。」",[[1,2,"1001140"],[4,3,"1003430"],[7,2,"1339340"],[10,3,"1421900"]],[[7,2,"しゅっせ"]]],["と、一寸法師はこたえました。",[[2,4,"1163970"],[7,3,"1179810"]],[[2,4,"いっすんぼうし"]]],["おわんの舟は毎日少しずつ淀川を上って行きました。しかし舟が小さいので、少し風が強く吹いたり、雨が降って水かさが増したりすると、舟はたびたびひっくり返りそうになりました。そういう時には、しかたがないので、石垣の間や、橋ぐいの陰に舟を止めて休みました。",[[0,3,"1002760"],[4,1,"1602800"],[6,2,"1524720"],[8,2,"1348870"],[15,2,"1352570"],[18,2,"1578850"],[24,3,"1505990"],[27,1,"1602800"],[29,3,"1347750"],[35,2,"1348870"],[37,1,"1499720"],[39,2,"1236070"],[41,2,"1370760"],[46,1,"1171900"],[48,2,"1282790"],[51,3,"1371700"],[55,2,"1403120"],[59,2,"1157170"],[63,1,"1602800"],[65,4,"1597160"],[69,6,"1169320"],[75,2,"1241