[["朝です。子うさぎがいます。名前は、ベンジャミンです。",[[0,1,"1428280"],[9,1,"1577980"],[13,2,"1531710"]],[[0,1,"あさ"],[4,1,"こ"],[13,2,"なまえ"]]],["マグレガーさんと奥さんが、町に行きました。ベンジャミンは、ピーターの家に行きます。",[[5,2,"1579350"],[8,3,"1179330"],[13,1,"1603990"],[15,2,"1578850"],[34,1,"1191730"],[36,2,"1578850"]],[[8,1,"おく"],[13,1,"まち"],[15,1,"い"],[34,1,"いえ"],[36,1,"い"]]],["―あれ？―",[[1,2,"1196670"]],[]],["ピーターがいます。ピーターは元気がありません。",[[5,1,"1577980"],[14,2,"1260720"],[17,2,"1296400"]],[[14,2,"げんき"]]],["ピーター、どうしたの？服がないんだふく「服はどこ？」べんじゃみんいベンジャミンは言いました。(cid:8673)",[[5,2,"1451160"],[7,1,"1157170"],[11,1,"1500940"],[13,2,"1529520"],[17,2,"1500940"],[20,1,"1500940"],[22,2,"1577140"],[26,2,"2208060"],[30,2,"1259290"],[40,2,"1587040"]],[[11,1,"ふく"],[20,1,"ふく"],[40,1,"い"]]],["「マグレガーさんの畑にあるんだ･･･」ピーターは言いました。「ねえ、ピーター。今、マグレガーさんは、いないよ」ベンジャミンは言いました。",[[6,2,"1579350"],[9,1,"1476520"],[11,2,"1296400"],[24,2,"1587040"],[31,2,"2029080"],[39,1,"1288850"],[46,2,"1579350"],[50,1,"1577980"],[62,2,"1587040"]],[[9,1,"はたけ"],[24,1,"い"],[39,1,"いま"],[62,1,"い"]]],["ベンジャミンとピーターは、マグレガーさんの畑に行きます。",[[18,2,"1579350"],[21,1,"1476520"],[23,2,"1578850"]],[[21,1,"はたけ"],[23,1,"い"]]],["「あ、あそこ！」二人は言いました。ピーターの青い服と靴がありました。",[[1,1,"2394370"],[3,3,"1000320"],[8,2,"1582670"],[11,2,"1587040"],[22,2,"1381390"],[24,1,"1500940"],[26,1,"1246700"],[28,2,"1296400"]],[[8,2,"ふたり"],[11,1,"い"],[22,1,"あお"],[24,1,"ふく"],[26,1,"くつ"]]],["昨日、雨が降りました。靴の中に水がたくさんあります。青い服も冷たいです。",[[0,2,"1579260"],[3,1,"1171900"],[5,2,"1282790"],[11,1,"1246700"],[13,1,"1423310"],[15,1,"1371260"],[17,4,"1415870"],[21,2,"1296400"],[26,2,"1381390"],[28,1,"1500940"],[30,3,"1556730"]],[[0,2,"きのう"],[3,1,"あめ"],[5,1,"ふ"],[11,1,"くつ"],[13,1,"なか"],[15,1,"みず"],[26,1,"あお"],[28,1,"ふく"],[30,1,"つめ"]]],["ベンジャミンは玉ねぎをとります。「ピーターのお母さんは、玉ねぎが好き？」でも、ピーターは何も言いません。ピーターは、早く家に帰りたいです。マグレガーさんが怖いですから･･･。",[[7,3,"1240670"],[11,2,"1326980"],[22,4,"1002650"],[28,3,"1240670"],[32,2,"1277450"],[44,1,"2846738"],[46,2,"1587040"],[58,2,"1404975"],[60,1,"1191730"],[62,2,"1221270"],[74,2,"1579350"],[77,2,"1593480"]],[[7,1,"たま"],[23,1,"かあ"],[28,1,"たま"],[32,1,"す"],[44,1,"なん"],[46,1,"い"],[58,1,"はや"],[60,1,"いえ"],[62,1,"かえ"],[77,1,"こわ"]]],["「いつも、お父さんとここに来るんだ」ベンジャミンは言いました。ベンジャミンはマグレガーさんのレタスを食べます。でも、ピーターは何も食べません。「ねえ、ベンジャミン。僕は家に帰りたい」",[[1,3,"1188890"],[5,4,"1002590"],[10,2,"1288810"],[13,2,"1547720"],[25,2,"1587040"],[43,2,"1579350"],[46,3,"1145450"],[50,2,"1358280"],[63,1,"2846738"],[65,2,"1358280"],[72,2,"2029080"],[82,1,"1521400"],[84,1,"1191730"],[86,2,"1221270"]],[[6,1,"とう"],[13,1,"く"],[25,1,"い"],[50,1,"た"],[63,1,"なん"],[65,1,"た"],[82,1,"ぼく"],[84,1,"いえ"],[86,1,"かえ"]]],["ピーターは、走ります。",[[6,2,"1402540"]],[[6,1,"はし"]]],["おおねこあっ、大きい猫がいます！猫だ！こわい･･･(cid:8669)(cid:8671)",[[0,2,"2082140"],[2,2,"1467640"],[4,2,"2394370"],[7,3,"1588880"],[10,1,"1467640"],[12,1,"1577980"],[16,1,"1467640"],[19,3,"1593480"]],[[7,1,"おお"],[10,1,"ねこ"],[16,1,"ねこ"]]],["ピーターとベンジャミンは、すぐに、かごの中に入りました。",[[13,2,"1430610"],[17,2,"1590200"],[20,1,"1423310"],[22,2,"1465590"]],[[20,1,"なか"],[22,1,"はい"]]],["猫は、かごの上に座りました。ピーターとベンジャミンは、かごの中で泣きました。猫は、(cid:8673)時間もいました。",[[0,1,"1467640"],[3,2,"1590200"],[6,1,"1352130"],[8,2,"1291800"],[27,2,"1590200"],[30,1,"1423310"],[32,2,"1229840"],[38,1,"1467640"],[51,2,"1315920"],[54,1,"1577980"]],[[0,1,"ねこ"],[6,1,"うえ"],[8,1,"すわ"],[30,1,"なか"],[32,1,"な"],[38,1,"ねこ"],[51,2,"じかん"]]],["猫は上を見ました。―あれは誰？―ベンジャミンのお父さんです。お父さんも、猫を見ました。",[[0,1,"1467640"],[2,1,"1352130"],[4,1,"1259290"],[10,2,"1000580"],[13,1,"1416830"],[23,4,"1002590"],[30,4,"1002590"],[36,1,"1467640"],[38,1,"1259290"]],[[0,1,"ねこ"],[2,1,"うえ"],[4,1,"み"],[13,1,"だれ"],[24,1,"とう"],[31,1,"とう"],[36,1,"ねこ"],[38,1,"み"]]],["あ！ベンジャミンのお父さんが、猫の上に！！猫は、びっくりしました。そして、走りました。",[[0,1,"2394370"],[9,4,"1002590"],[15,1,"1467640"],[17,1,"1352130"],[21,1,"1467640"],[24,4,"1226360"],[28,1,"1157170"],[33,3,"1006730"],[37,2,"1402540"]],[[10,1,"とう"],[15,1,"ねこ"],[17,1,"うえ"],[21,1,"ねこ"],[37,1,"はし"]]],["猫は、もういません。お父さんは、二人をかごから出しました。「マグレガーさんの畑は、子供だけじゃ危ないよ！」痛い！",[[0,1,"1467640"],[3,2,"1012480"],[5,1,"1577980"],[10,4,"1002590"],[16,2,"1582670"],[19,2,"1590200"],[23,2,"1338180"],[35,2,"1579350"],[38,1,"1476520"],[41,2,"1307850"],[47,3,"1218380"],[53,2,"1432680"]],[[0,1,"ねこ"],[11,1,"とう"],[16,2,"ふたり"],[23,1,"だ"],[38,1,"はたけ"],[41,2,"こども"],[47,1,"あぶ"],[53,1,"いた"]]],["ベンジャミンのお父さんは、玉ねぎとレタスを持ちました。そして、ゆっくり畑の外に出ました。",[[7,4,"1002590"],[13,3,"1240670"],[17,3,"1145450"],[21,2,"1315720"],[27,3,"1006730"],[31,4,"1013050"],[35,1,"1476520"],[37,1,"1203250"],[39,1,"1338240"]],[[8,1,"とう"],[13,1,"たま"],[21,1,"も"],[35,1,"はたけ"],[37,1,"そと"],[39,1,"で"]]],["ピーターは家に帰りました。「ただいま」ピーターが言いました。「おかえりなさい」お母さんが言いました。",[[5,1,"1191730"],[7,2,"1221270"],[14,4,"1538960"],[24,2,"1587040"],[31,7,"1001740"],[39,4,"1002650"],[44,2,"1587040"]],[[5,1,"いえ"],[7,1,"かえ"],[24,1,"い"],[40,1,"かあ"],[44,1,"い"]]],["ピーターは、お母さんに玉ねぎをあげました。―あら、ピーター･･･服と靴がある―お母さんは、うれしかったです。",[[6,4,"1002650"],[11,3,"1240670"],[15,2,"1352320"],[22,2,"1000520"],[32,1,"1500940"],[34,1,"1246700"],[36,2,"1296400"],[39,4,"1002650"],[45,5,"1219510"]],[[7,1,"かあ"],[11,1,"たま"],[32,1,"ふく"],[34,1,"くつ"],[40,1,"かあ"]]],["夕方、マグレガーさんは、家に帰りました。そして、畑に行きました。ピーターの青い服と靴がありません。―青い服はどこ？靴はどこ？―～おわり～",[[0,2,"1542790"],[8,2,"1579350"],[12,1,"1191730"],[14,2,"1221270"],[20,3,"1006730"],[24,1,"1476520"],[26,2,"1578850"],[37,2,"1381390"],[39,1,"1500940"],[41,1,"1246700"],[43,2,"1296400"],[50,2,"1381390"],[52,1,"1500940"],[54,2,"1577140"],[57,1,"1246700"],[59,2,"1577140"],[64,3,"1589590"]],[[0,2,"ゆうがた"],[12,1,"いえ"],[14,1,"かえ"],[24,1,"はたけ"],[26,1,"い"],[37,1,"あお"],[39,1,"ふく"],[41,1,"くつ"],[50,1,"あお"],[52,1,"ふく"],[57,1,"くつ"]]]]