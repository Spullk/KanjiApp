[["おかしなはがきが、ある土曜日の夕がた、一郎のうちにきました。",[[0,4,"1612790"],[4,3,"1546590"],[9,2,"1586840"],[11,3,"1445590"],[15,3,"1542790"],[22,2,"1457730"],[25,1,"1547720"]],[[11,3,"どようび"],[15,1,"ゆう"],[19,2,"いちろう"]]],["かねた一郎さま　九月十九日",[[0,2,"1256520"],[5,2,"1545790"],[8,2,"1243660"],[10,3,"2719740"]],[[3,2,"いちろう"],[8,2,"きゅうがつ"],[10,3,"じゅうきゅうにち"]]],["あなたは、ごきげんよろしいほで、けっこです。",[[0,3,"1223615"],[5,4,"1270280"],[9,4,"1224880"],[13,1,"1514780"],[16,1,"1533820"],[17,2,"2255460"]],[]],["あした、めんどなさいばんしますから、おいで",[[0,3,"1584660"],[4,3,"1533550"],[8,4,"1296120"],[12,1,"1157170"],[19,2,"1338240"]],[]],["んなさい。とびどぐもたないでくなさい。",[[0,2,"2835613"],[2,2,"1296300"],[5,2,"1429700"],[8,2,"1173100"],[11,2,"1529520"],[15,3,"1157090"]],[]],["山ねこ　拝",[[0,3,"1303100"],[4,1,"1633870"]],[[0,1,"やま"],[4,1,"はい"]]],["こんなのです。字はまるでへたで、墨もがさがさして指につくくらいでした。けれども一郎はうれしくてうれしくてたまりませんでした。はがきをそっと学校のかばんにしまって、うちじゅうとんだりはねたりしました。",[[0,3,"1004880"],[7,1,"1315130"],[9,3,"1216280"],[12,2,"1185200"],[16,1,"1521510"],[18,4,"1003090"],[22,1,"1157170"],[24,1,"1309650"],[26,2,"1331530"],[35,3,"2853889"],[42,4,"1219510"],[47,4,"1219510"],[52,3,"1552650"],[62,3,"1546590"],[66,3,"1006810"],[69,2,"1206730"],[72,3,"1208910"],[76,3,"1305380"],[81,5,"1192250"],[86,2,"1429700"],[90,2,"1611260"],[94,1,"1157170"]],[[7,1,"じ"],[16,1,"すみ"],[24,1,"ゆび"],[39,2,"いちろう"],[69,2,"がっこう"]]],["ね床にもぐってからも、山猫のにゃあとした顔や、そのめんどうだという裁判のけしきなどを考えて、おそくまでねむりませんでした。",[[1,1,"1349380"],[3,3,"1609715"],[11,2,"1303100"],[14,3,"1632330"],[18,1,"1157170"],[20,1,"1217730"],[23,2,"1006830"],[25,4,"1533550"],[31,2,"1587040"],[33,2,"1296120"],[36,3,"1250870"],[42,2,"1281020"],[46,3,"1421970"],[51,3,"1529390"]],[[1,1,"どこ"],[11,2,"やまねこ"],[20,1,"かお"],[33,2,"さいばん"],[42,1,"かんが"]]],["けれども、一郎が眼をさましたときは、もうすっかり明るくなっていました。おもてにでてみると、まわりの山は、みんなたったいまできたばかりのようにうるうるもりあがって、まっ青なそらのしたにならんでいました。一郎はいそいでごはんをたべて、ひとり谷川に沿ったこみちを、かみの方へのぼって行きました。",[[0,3,"2853889"],[8,1,"1604890"],[10,3,"1556740"],[14,2,"1315840"],[18,6,"2230440"],[24,3,"1532350"],[27,2,"1375610"],[30,1,"1577980"],[35,3,"1489340"],[39,1,"1338240"],[41,2,"1259290"],[45,3,"1604290"],[49,1,"1302680"],[52,3,"1202150"],[55,2,"1629170"],[58,2,"1288850"],[60,2,"1340450"],[67,2,"1605845"],[70,4,"2665500"],[74,5,"1379690"],[81,3,"1604080"],[85,2,"1006970"],[88,2,"1387010"],[91,3,"1508380"],[95,1,"1577980"],[103,3,"1228650"],[107,3,"1270590"],[111,2,"1358280"],[115,3,"1576150"],[121,2,"1176700"],[124,3,"1660240"],[132,1,"1516930"],[134,3,"1352570"],[138,2,"1578850"]],[[5,2,"いちろう"],[8,1,"め"],[24,1,"あか"],[49,1,"やま"],[83,1,"さお"],[100,2,"いちろう"],[118,2,"たにがわ"],[121,1,"そ"],[132,1,"ほう"],[138,1,"い"]]],["すきとおった風がざあっと吹くと、栗の木はばらばらと実をおとしました。一郎は栗の木をみあげて、",[[0,5,"1450510"],[6,1,"1499720"],[8,3,"2717450"],[12,2,"1370760"],[16,1,"1246880"],[18,1,"1534520"],[20,4,"1010320"],[25,1,"1320800"],[27,3,"1589260"],[37,1,"1246880"],[39,1,"1534520"],[41,3,"1259740"]],[[6,1,"かぜ"],[12,1,"ふ"],[16,1,"くり"],[18,1,"き"],[25,1,"じつ"],[34,2,"いちろう"],[37,1,"くり"],[39,1,"き"]]],["「栗の木、栗の木、やまねこがここを通らなかったかい。」とききました。栗の木はちょっとしずかになって、",[[1,1,"1246880"],[3,1,"1534520"],[5,1,"1246880"],[7,1,"1534520"],[9,4,"1303100"],[14,2,"1288810"],[17,2,"1433030"],[28,2,"1226210"],[34,1,"1246880"],[36,1,"1534520"],[38,4,"1163940"],[42,3,"1381820"],[46,2,"1375610"]],[[1,1,"くり"],[3,1,"き"],[5,1,"くり"],[7,1,"き"],[17,1,"とお"],[34,1,"くり"],[36,1,"き"]]],["「やまねこなら、けさはやく、馬車でひがしの方へ飛んで行きましたよ。」と答えました。",[[1,4,"1303100"],[8,2,"1579100"],[10,3,"1404975"],[14,2,"1471780"],[17,3,"1447440"],[21,1,"1516930"],[23,2,"1429700"],[26,2,"1578850"],[35,2,"1449540"]],[[14,2,"ばしゃ"],[21,1,"ほう"],[23,1,"と"],[26,1,"い"],[35,1,"こた"]]],["「東ならぼくのいく方だねえ、おかしいな、とにかくもっといってみよう。栗の木ありがとう。」",[[1,1,"1447440"],[4,2,"1521400"],[7,2,"1578850"],[9,1,"1516930"],[14,4,"1190860"],[20,4,"1443990"],[24,3,"1012620"],[27,2,"1587040"],[30,3,"1259290"],[34,1,"1246880"],[36,1,"1534520"],[37,5,"1586820"]],[[1,1,"ひがし"],[9,1,"ほう"],[34,1,"くり"],[36,1,"き"]]],["栗の木はだまってまた実をばらばらとおとしました。",[[0,1,"1246880"],[2,1,"1534520"],[4,3,"1534930"],[8,2,"1524930"],[10,1,"1320800"],[12,4,"1010320"],[17,3,"1589260"]],[[0,1,"くり"],[2,1,"き"],[10,1,"じつ"]]],["一郎がすこし行きますと、そこはもう笛ふきの滝でした。笛ふきの滝というのは、まっ白な岩の崖のなかほどに、小さな穴があいていて、そこから水が笛のように鳴って飛び出し、すぐ滝になって、ごうごう谷におちているのをいうのでした。",[[3,3,"1348870"],[6,2,"1578850"],[12,2,"1436050"],[15,2,"1012480"],[17,3,"1437320"],[21,1,"1415520"],[26,3,"1437320"],[30,1,"1415520"],[32,2,"1587040"],[37,3,"1580620"],[41,1,"1217270"],[43,1,"1204380"],[45,2,"1423310"],[51,3,"2136180"],[54,1,"1254480"],[56,2,"1151230"],[59,1,"1577980"],[62,2,"1436050"],[66,1,"1371260"],[68,1,"1437310"],[70,2,"1605845"],[73,2,"1532910"],[76,4,"1485350"],[81,2,"1430610"],[83,1,"1415520"],[85,2,"1375610"],[89,4,"1593500"],[93,1,"1581590"],[95,2,"1548550"],[98,2,"1577980"],[102,2,"1587040"]],[[0,2,"いちろう"],[6,1,"い"],[17,1,"ふえ"],[21,1,"たき"],[26,1,"ふえ"],[30,1,"たき"],[39,1,"しろ"],[41,1,"いわ"],[43,1,"がけ"],[51,1,"ちい"],[54,1,"あな"],[66,1,"みず"],[68,1,"ふえ"],[73,1,"な"],[76,3,"とびだ"],[83,1,"たき"],[93,1,"たに"]]],["一郎は滝に向いて叫びました。",[[3,1,"1415520"],[5,2,"1277080"],[8,2,"1235910"]],[[0,2,"いちろう"],[3,1,"たき"],[5,1,"む"],[8,1,"さけ"]]],["「おいおい、笛ふき、やまねこがここを通らなかったかい。」",[[1,4,"1631660"],[6,3,"1437320"],[10,4,"1303100"],[15,2,"1288810"],[18,2,"1433030"]],[[6,1,"ふえ"],[18,1,"とお"]]],["滝がぴーぴー答えました。",[[0,1,"1415520"],[2,4,"2097020"],[6,2,"1449540"]],[[0,1,"たき"],[6,1,"こた"]]],["「やまねこは、さっき、馬車で西の方へ飛んで行きましたよ。」",[[1,4,"1303100"],[7,3,"1005180"],[11,2,"1471780"],[14,1,"1380840"],[16,1,"1516930"],[18,2,"1429700"],[21,2,"1578850"]],[[11,2,"ばしゃ"],[14,1,"にし"],[16,1,"ほう"],[18,1,"と"],[21,1,"い"]]],["「おかしいな、西ならぼくのうちの方だ。けれども、まあも少し行ってみよう。ふえふき、ありがとう。」",[[1,4,"1190860"],[7,1,"1380840"],[10,2,"1521400"],[13,2,"1457730"],[16,1,"1516930"],[19,3,"2853889"],[24,2,"1012050"],[27,2,"1348870"],[29,2,"1578850"],[32,3,"1259290"],[36,4,"1437320"],[41,5,"1586820"]],[[7,1,"にし"],[16,1,"ほう"],[27,1,"すこ"],[29,1,"い"]]],["滝はまたもとのように笛を吹きつづけました。",[[0,1,"1415520"],[2,2,"1524930"],[4,2,"1260670"],[7,2,"1605845"],[10,1,"1437310"],[12,2,"1370760"],[14,3,"1405800"]],[[0,1,"たき"],[10,1,"ふえ"],[12,1,"ふ"]]],["一郎がまたすこし行きますと、一本のぶなの木のしたに、たくさんの白いきのこが、どってこどってこどってこと、変な楽隊をやっていました。",[[3,2,"1524930"],[5,3,"1348870"],[8,2,"1578850"],[14,2,"1166600"],[17,2,"2067320"],[20,1,"1534520"],[22,2,"1387010"],[26,4,"1415870"],[31,2,"1474910"],[33,3,"1416010"],[38,2,"1326980"],[41,1,"1547720"],[49,2,"1241450"],[52,1,"1510640"],[54,2,"1207420"],[57,2,"1012980"],[60,1,"1577980"]],[[0,2,"いちろう"],[8,1,"い"],[14,2,"いちぽん"],[20,1,"き"],[31,1,"しろ"],[52,1,"へん"],[54,2,"がくたい"]]],["一郎はからだをかがめて、",[[3,3,"1409140"],[7,3,"1246560"]],[[0,2,"いちろう"]]],["「おい、きのこ、やまねこが、ここを通らなかったかい。」",[[1,2,"1643510"],[4,3,"1416010"],[8,4,"1303100"],[14,2,"1288810"],[17,2,"1433030"]],[[17,1,"とお"]]],["とききました。するときのこは",[[1,2,"1226210"],[7,2,"1157170"],[10,3,"1416010"]],[]],["「やまねこなら、けさはやく、馬車で南の方へ飛んで行きましたよ。」とこたえました。一郎は首をひねりました。",[[1,4,"1303100"],[8,2,"1579100"],[10,3,"1404975"],[14,2,"1471780"],[17,1,"1459870"],[19,1,"1516930"],[21,2,"1429700"],[24,2,"1578850"],[33,3,"1179810"],[43,1,"1592270"],[45,3,"1469530"]],[[14,2,"ばしゃ"],[17,1,"みなみ"],[19,1,"ほう"],[21,1,"と"],[24,1,"い"],[40,2,"いちろう"],[43,1,"くび"]]],["「みなみならあっちの山のなかだ。おかしいな。まあもすこし行ってみよう。きのこ、ありがとう。」",[[1,3,"1459870"],[6,3,"1483185"],[10,1,"1302680"],[12,2,"1423310"],[16,4,"1190860"],[22,2,"1012050"],[25,3,"1348870"],[28,2,"1578850"],[31,3,"1259290"],[35,3,"1416010"],[39,5,"1586820"]],[[10,1,"やま"],[28,1,"い"]]],["きのこはみんないそがしそうに、どってこどってこと、あのへんな楽隊をつづけました。",[[0,3,"1416010"],[4,3,"1202150"],[7,4,"1519290"],[11,2,"1241450"],[15,2,"1326980"],[18,1,"1547720"],[22,2,"1241450"],[25,2,"1000420"],[27,2,"1510640"],[30,2,"1207420"],[33,3,"1405800"]],[[30,2,"がくたい"]]],["一郎はまたすこし行きました。すると一本のくるみの木の梢を、栗鼠がぴょんととんでいました。一郎はすぐ手まねぎしてそれをとめて、",[[3,2,"1524930"],[5,3,"1348870"],[8,2,"1578850"],[14,2,"1157170"],[17,2,"1166600"],[20,3,"1267550"],[24,1,"1534520"],[26,1,"1349980"],[29,2,"1246890"],[32,3,"2831892"],[36,2,"1429700"],[39,1,"1577980"],[47,2,"1430610"],[49,2,"1327410"],[51,2,"1467630"],[53,1,"1157170"],[55,2,"1006970"],[58,2,"1310670"]],[[0,2,"いちろう"],[8,1,"い"],[17,2,"いちぽん"],[24,1,"き"],[26,1,"こずえ"],[29,2,"りす"],[44,2,"いちろう"],[49,1,"て"]]],["「おい、りす、やまねこがここを通らなかったかい。」とたずねました。するとりすは、木の上から、額に手をかざして、一郎を見ながらこたえました。",[[1,2,"1643510"],[4,2,"1246890"],[7,4,"1303100"],[12,2,"1288810"],[15,2,"1433030"],[26,3,"1518070"],[33,2,"1157170"],[36,2,"1246890"],[40,1,"1534520"],[42,1,"1352130"],[46,1,"1207500"],[48,1,"1327190"],[50,3,"1634190"],[58,1,"1259290"],[62,3,"1179810"]],[[15,1,"とお"],[40,1,"き"],[42,1,"うえ"],[46,1,"がく"],[48,1,"て"],[55,2,"いちろう"],[58,1,"み"]]],["「やまねこなら、けさまだくらいうちに馬車でみなみの方へ飛んで行きましたよ。」",[[1,4,"1303100"],[8,2,"1579100"],[10,2,"1527110"],[15,2,"1457730"],[18,2,"1471780"],[21,3,"1459870"],[25,1,"1516930"],[27,2,"1429700"],[30,2,"1578850"]],[[18,2,"ばしゃ"],[25,1,"ほう"],[27,1,"と"],[30,1,"い"]]],["「みなみへ行ったなんて、二とこでそんなことを言うのはおかしいなあ。けれどもまあもすこし行ってみよう。りす、ありがとう。」りすはもう居ませんでした。ただくるみのいちばん上の枝がゆれ、となりのぶなの葉がちらっとひかっただけでした。",[[1,3,"1459870"],[5,2,"1578850"],[13,2,"1349370"],[16,3,"1007130"],[19,2,"1241450"],[22,2,"1587040"],[26,4,"1190860"],[33,3,"2853889"],[37,2,"1012050"],[40,3,"1348870"],[43,2,"1578850"],[46,3,"1259290"],[50,2,"1246890"],[53,5,"1586820"],[60,2,"1246890"],[63,2,"1012480"],[65,1,"1577980"],[73,2,"1538900"],[75,3,"1267550"],[79,4,"1165970"],[83,1,"1352130"],[85,1,"1310530"],[87,2,"1545710"],[90,3,"1555830"],[94,2,"2067320"],[97,1,"1546550"],[103,3,"1272820"]],[[5,1,"い"],[12,1,"ふた"],[22,1,"い"],[43,1,"い"],[65,1,"い"],[83,1,"うえ"],[85,1,"えだ"],[97,1,"は"]]],["一郎がすこし行きましたら、谷川にそったみちは、もう細くなって消えてしまいました。そして谷川の南の、まっ黒な榧の木の森の方へ、あたらしいちいさなみちがついていました。一郎はそのみちをのぼって行きました。榧の枝はまっくろに重なりあって、青ぞらは一きれも見えず、みちは大へん急な坂になりました。一郎が顔をまっかにして、汗をぽとぽとおとしながら、その坂をのぼりますと、にわかにぱっと明るくなって、眼がちくっとしました。そこはうつくしい黄金いろの草地で、草は風にざわざわ鳴り、まわりは立派なオリーブいろのかやの木のもりでかこまれてありました。",[[3,3,"1348870"],[6,2,"1578850"],[16,2,"1241450"],[19,2,"1454080"],[23,2,"1012480"],[25,2,"1295510"],[27,2,"1375610"],[30,2,"1350040"],[33,3,"1305380"],[40,3,"1006730"],[46,1,"1459870"],[49,3,"1604050"],[53,1,"1634160"],[55,1,"1534520"],[57,1,"1362490"],[59,1,"1516930"],[62,5,"1361490"],[67,4,"2136180"],[71,2,"1454080"],[74,2,"1495740"],[77,1,"1577980"],[85,4,"2002310"],[90,3,"1352570"],[94,2,"1578850"],[100,1,"1634160"],[102,1,"1310530"],[104,4,"1604050"],[109,5,"1335790"],[116,3,"1381470"],[121,2,"1384840"],[124,2,"1259140"],[128,2,"1454080"],[131,3,"1415000"],[134,1,"1228560"],[136,1,"1297110"],[138,2,"1375610"],[147,1,"1217730"],[149,3,"1363250"],[153,1,"1157170"],[156,1,"1213060"],[158,4,"1011960"],[162,3,"1589260"],[169,2,"1006830"],[171,1,"1297110"],[173,3,"1352570"],[180,3,"1599920"],[187,3,"1532350"],[190,2,"1375610"],[194,1,"1604890"],[196,3,"1421020"],[200,1,"1157170"],[205,2,"1436050"],[208,5,"1486360"],[213,1,"1181760"],[214,3,"1578120"],[218,2,"1633620"],[222,1,"1401910"],[224,1,"1499720"],[226,4,"1005430"],[230,2,"1532910"],[233,3,"1604290"],[237,2,"1551790"],[240,6,"1634260"],[247,2,"1209310"],[250,1,"1534520"],[252,2,"1362490"],[255,3,"1155980"],[260,2,"1296400"]],[[0,2,"いちろう"],[6,1,"い"],[13,2,"たにがわ"],[25,1,"ほそ"],[30,1,"き"],[43,2,"たにがわ"],[46,1,"みなみ"],[51,1,"くろ"],[53,1,"かや"],[55,1,"き"],[57,1,"もり"],[59,1,"ほう"],[82,2,"いちろう"],[94,1,"い"],[100,1,"かや"],[102,1,"えだ"],[109,1,"かさ"],[116,1,"あお"],[120,1,"いち"],[124,1,"み"],[131,1,"たい"],[134,1,"きゅう"],[136,1,"さか"],[144,2,"いちろう"],[147,1,"かお"],[156,1,"あせ"],[171,1,"さか"],[187,1,"あか"],[194,1,"め"],[213,2,"きん"],[218,2,"くさち"],[222,1,"くさ"],[224,1,"ふう"],[230,1,"な"],[237,2,"りっぱ"],[250,1,"き"]]],["その草地のまん中に、せいの低いおかしな形の男が、膝を曲げて手に革鞭をもって、だまってこっちをみていたのです。",[[0,2,"1006830"],[2,2,"1633620"],[5,3,"1604350"],[10,2,"1374620"],[13,2,"1434180"],[15,4,"1612790"],[19,1,"1250220"],[21,1,"1419990"],[24,1,"1487320"],[26,2,"1239740"],[29,1,"1327190"],[34,2,"1315720"],[38,3,"1534930"],[42,3,"1004500"],[46,1,"1259290"],[48,1,"1577980"]],[[2,2,"くさち"],[7,1,"なか"],[13,1,"ひく"],[19,1,"かたち"],[21,1,"おとこ"],[24,1,"ひざ"],[26,1,"ま"],[29,1,"て"],[31,2,"かわむち"]]],["一郎はだんだんそばへ行って、びっくりして立ちどまってしまいました。その男は、片眼で、見えない方の眼は、白くびくびくうごき、上着のような半纒のようなへんなものを着て、だいいち足が、ひどくまがって山羊のよう、ことにそのあしさきときたら、ごはんをもるへらのかたちだったのです。一郎は気味が悪かったのですが、なるべく落ちついてたずねました。",[[3,4,"1597350"],[7,2,"1403830"],[10,2,"1578850"],[14,4,"1226360"],[18,1,"1157170"],[20,5,"1551350"],[26,3,"1305380"],[33,2,"1006830"],[35,1,"1419990"],[38,2,"1511830"],[42,2,"1259140"],[46,1,"1516930"],[48,1,"1604890"],[51,2,"1474910"],[53,4,"1010730"],[57,3,"1451210"],[61,2,"1580340"],[64,2,"1605845"],[67,2,"1479740"],[70,2,"1605845"],[73,2,"1510640"],[76,2,"1502390"],[79,1,"1423000"],[82,4,"1415270"],[86,1,"1404630"],[89,3,"1602060"],[92,3,"2009780"],[96,2,"1303200"],[99,2,"1605845"],[102,2,"1241450"],[105,2,"1006830"],[107,4,"2115640"],[112,1,"1547720"],[116,3,"1270590"],[120,2,"1379740"],[122,2,"1510300"],[125,3,"1250220"],[138,2,"1222640"],[141,3,"1151260"],[150,4,"1375620"],[154,4,"1589220"],[159,3,"1518070"]],[[0,2,"いちろう"],[10,1,"い"],[20,1,"た"],[35,1,"おとこ"],[38,2,"かため"],[42,1,"み"],[46,1,"ほう"],[48,1,"め"],[51,1,"しろ"],[61,2,"うわぎ"],[67,2,"はんてん"],[79,1,"き"],[86,1,"あし"],[96,2,"やぎ"],[135,2,"いちろう"],[138,2,"きみ"],[141,1,"わる"],[154,1,"お"]]],["「あなたは山猫をしりませんか。」",[[1,3,"1223615"],[5,2,"1303100"],[8,2,"1420470"]],[[5,2,"やまねこ"]]],["するとその男は、横眼で一郎の顔を見て、口をまげてにやっとわらって言いました。",[[0,2,"1157170"],[3,2,"1006830"],[5,1,"1419990"],[8,2,"1181090"],[14,1,"1217730"],[16,1,"1259290"],[19,1,"1275640"],[24,3,"2734690"],[28,3,"1351360"],[32,2,"1587040"]],[[5,1,"おとこ"],[8,2,"よこめ"],[11,2,"いちろう"],[14,1,"かお"],[16,1,"み"],[19,1,"くち"],[32,1,"い"]]],["「山ねこさまはいますぐに、ここに戻ってお出やるよ。おまえは一郎さんだな。」",[[1,3,"1303100"],[4,2,"1545790"],[7,4,"2026850"],[13,2,"1288810"],[16,2,"1535880"],[20,1,"1338240"],[21,2,"1012980"],[25,3,"1002290"],[31,2,"1579350"]],[[1,1,"やま"],[16,1,"もど"],[20,1,"で"],[29,2,"いちろう"]]],["一郎はぎょっとして、一あしうしろにさがって、",[[3,4,"1003630"],[7,1,"1157170"],[11,3,"2862515"],[14,2,"1157170"],[17,3,"1184160"]],[[0,2,"いちろう"],[10,1,"いち"]]],["「え、ぼく一郎です。けれども、どうしてそれを知ってますか。」と言いました。するとその奇体な男はいよいよにやにやしてしまいました。",[[1,1,"2194050"],[3,2,"1521400"],[10,3,"2853889"],[15,2,"1451160"],[17,1,"1157170"],[19,2,"1006970"],[22,2,"1420470"],[31,2,"1587040"],[37,2,"1157170"],[40,2,"1006830"],[42,2,"1778040"],[45,1,"1419990"],[47,4,"1587670"],[51,4,"1009620"],[55,1,"1157170"],[57,3,"1305380"]],[[5,2,"いちろう"],[22,1,"し"],[31,1,"い"],[42,2,"きたい"],[45,1,"おとこ"]]],["「そんだら、はがき見だべ。」",[[1,2,"1006970"],[6,3,"1546590"],[9,1,"2256270"]],[[9,1,"み"]]],["「見ました。それで来たんです。」",[[1,1,"1259290"],[6,2,"1006970"],[9,1,"1547720"]],[[1,1,"み"],[9,1,"き"]]],["「あのぶんしょうは、ずいぶん下手だべ。」と男は下をむいてかなしそうに言いました。一郎はきのどくになって、",[[1,2,"1000420"],[3,5,"1505470"],[10,4,"1372800"],[14,2,"1185200"],[21,1,"1419990"],[23,1,"1184140"],[25,2,"1277080"],[28,3,"1483190"],[31,2,"1241450"],[34,2,"1587040"],[43,4,"1221770"],[48,2,"1375610"]],[[14,2,"へた"],[21,1,"おとこ"],[23,1,"した"],[34,1,"い"],[40,2,"いちろう"]]],["「さあ、なかなか、ぶんしょうがうまいようでしたよ。」",[[1,2,"1005110"],[4,4,"1599420"],[9,5,"1505470"],[15,3,"1310460"],[18,2,"1605845"]],[]],["と言いますと、男はよろこんで、息をはあはあして、耳のあたりまでまっ赤になり、きもののえりをひろげて、風をからだに入れながら、",[[1,2,"1587040"],[7,1,"1419990"],[9,4,"1218760"],[15,1,"1404320"],[17,4,"1632370"],[21,1,"1157170"],[24,1,"1317170"],[26,3,"1512080"],[31,3,"1363250"],[35,2,"1375610"],[38,3,"1423240"],[42,2,"1588750"],[45,3,"1602370"],[50,1,"1499720"],[52,3,"1409140"],[56,2,"1465610"]],[[1,1,"い"],[7,1,"おとこ"],[15,1,"いき"],[24,1,"みみ"],[33,1,"か"],[50,1,"かぜ"],[56,1,"い"]]],["「あの字もなかなかうまいか。」とききました。一郎は、おもわず笑いだしながら、へんじしました。",[[1,2,"1000420"],[3,1,"1315130"],[5,4,"1599420"],[9,3,"1310460"],[16,2,"1226210"],[26,3,"1589350"],[30,4,"1847730"],[38,3,"1512220"],[41,1,"1157170"]],[[3,1,"じ"],[22,2,"いちろう"],[30,1,"わら"]]],["「うまいですね。五年生だってあのくらいには書けないでしょう。」",[[1,3,"1310460"],[9,2,"1468900"],[14,2,"1000420"],[21,2,"1343950"]],[[8,1,"ご"],[9,2,"ねんせい"],[21,1,"か"]]],["すると男は、急にまたいやな顔をしました。",[[0,2,"1157170"],[3,1,"1419990"],[6,1,"1228560"],[8,2,"1524930"],[10,2,"1587610"],[13,1,"1217730"],[15,1,"1157170"]],[[3,1,"おとこ"],[6,1,"きゅう"],[13,1,"かお"]]],["「五年生っていうのは、尋常五年生だべ。」その声が、あんまり力なくあわれに聞えましたので、一郎はあわてて言いました。",[[2,2,"1468900"],[6,2,"1587040"],[11,2,"1369960"],[14,2,"1468900"],[20,2,"1006830"],[22,1,"1380440"],[25,4,"1584930"],[29,3,"1796070"],[32,3,"1150110"],[36,2,"1591150"],[47,3,"1278830"],[51,2,"1587040"]],[[1,1,"ご"],[2,2,"ねんせい"],[11,2,"じんじょう"],[13,1,"ご"],[14,2,"ねんせい"],[22,1,"こえ"],[29,1,"ちから"],[36,1,"きこ"],[44,2,"いちろう"],[51,1,"い"]]],["「いいえ、大学校の五年生ですよ。」",[[1,3,"1583250"],[5,3,"2138020"],[10,2,"1468900"]],[[5,3,"だいがっこう"],[9,1,"ご"],[10,2,"ねんせい"]]],["すると、男はまたよろこんで、まるで、顔じゅう口のようにして、にたにたにたにた笑って叫びました。",[[0,2,"1157170"],[4,1,"1419990"],[6,2,"1524930"],[8,4,"1218760"],[14,3,"1216280"],[18,4,"2735270"],[22,1,"1275640"],[24,2,"1605845"],[27,1,"1157170"],[30,4,"1632310"],[34,4,"1632310"],[38,2,"1351360"],[41,2,"1235910"]],[[4,1,"おとこ"],[18,1,"かお"],[22,1,"くち"],[38,1,"わら"],[41,1,"さけ"]]],["「あのはがきはわしが書いたのだよ。」",[[1,2,"1000420"],[3,3,"1546590"],[7,2,"1562100"],[10,2,"1343950"]],[[10,1,"か"]]],["一郎はおかしいのをこらえて、",[[3,4,"1190860"],[9,3,"2827352"]],[[0,2,"いちろう"]]],["「ぜんたいあなたはなにですか。」とたずねますと、男は急にまじめになって、",[[1,4,"1395660"],[5,3,"1223615"],[9,2,"1577100"],[17,3,"1518070"],[24,1,"1419990"],[26,1,"1228560"],[28,3,"1364360"],[32,2,"1375610"]],[[24,1,"おとこ"],[26,1,"きゅう"]]],["「わしは山ねこさまの馬車別当だよ。」と言いました。",[[1,2,"1562100"],[4,3,"1303100"],[7,2,"1545790"],[10,2,"1471780"],[12,2,"1510070"],[19,2,"1587040"]],[[4,1,"やま"],[10,2,"ばしゃ"],[12,2,"べっとう"],[19,1,"い"]]],["そのとき、風がどうと吹いてきて、草はいちめん波だち、別当は、急にていねいなおじぎをしました。",[[0,4,"2002300"],[5,1,"1499720"],[7,2,"1451160"],[10,2,"1370760"],[13,1,"1547720"],[16,1,"1401910"],[18,4,"1166870"],[22,3,"1633850"],[26,2,"1510070"],[30,1,"1228560"],[32,4,"1427360"],[37,3,"1002030"],[41,1,"1157170"]],[[5,1,"かぜ"],[10,1,"ふ"],[16,1,"くさ"],[22,1,"なみ"],[26,2,"べっとう"],[30,1,"きゅう"]]],["一郎はおかしいとおもって、ふりかえって見ますと、そこに山猫が、黄いろな陣羽織のようなものを着て、緑いろの眼をまん円にして立っていました。やっぱり山猫の耳は、立って尖っているなと、一郎がおもいましたら、山ねこはぴょこっとおじぎをしました。一郎もていねいに挨拶しました。",[[3,4,"1190860"],[8,3,"1589350"],[13,5,"1361290"],[19,1,"1259290"],[24,2,"1436050"],[27,2,"1303100"],[31,3,"1576760"],[35,3,"1633530"],[39,2,"1605845"],[42,2,"1502390"],[45,1,"1423000"],[48,3,"1555320"],[52,1,"1604890"],[54,1,"1012050"],[56,1,"1175570"],[58,1,"1157170"],[60,2,"1597040"],[63,1,"1577980"],[68,4,"2772770"],[72,2,"1303100"],[75,1,"1317170"],[78,2,"1597040"],[81,2,"1389970"],[84,2,"1577980"],[92,3,"1589350"],[100,3,"1303100"],[109,3,"1002030"],[113,1,"1157170"],[121,4,"1427360"],[126,2,"1151120"],[128,1,"1157170"]],[[0,2,"いちろう"],[19,1,"み"],[27,2,"やまねこ"],[31,1,"き"],[35,3,"じんばおり"],[45,1,"き"],[48,1,"みどり"],[