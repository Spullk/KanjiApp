,"1311110"],[12,2,"1516930"],[15,3,"1605980"],[18,3,"1588880"],[23,3,"1579260"],[27,2,"1478560"],[29,2,"1579350"],[32,5,"1238840"],[40,2,"1529520"]],[[18,1,"おお"],[27,2,"はんじ"]]],["「だめだい、そんなこと。せいの高いのだよ。せいの高いことなんだよ。」",[[1,2,"1409110"],[6,3,"1007130"],[9,2,"1241450"],[12,2,"1374620"],[15,2,"1283190"],[21,2,"1374620"],[24,2,"1283190"],[26,2,"1241450"]],[[15,1,"たか"],[24,1,"たか"]]],["「押しっこのえらいひとだよ。押しっこをしてきめるんだよ。」もうみんな、がやがやがやがや言って、なにがなんだか、まるで蜂の巣をつっついたようで、わけがわからなくなりました。そこでやまねこが叫びました。",[[1,2,"1180130"],[3,2,"2255460"],[6,5,"1155800"],[14,2,"1180130"],[16,2,"2255460"],[19,1,"1157170"],[21,3,"1254180"],[29,2,"1012480"],[31,3,"1202150"],[35,4,"1003280"],[39,4,"1003280"],[43,2,"1587040"],[47,2,"1577100"],[50,2,"2846738"],[55,3,"1216280"],[58,3,"1517850"],[62,4,"1456890"],[67,2,"1605845"],[71,2,"1538330"],[74,3,"1606560"],[79,2,"1375610"],[85,2,"1436050"],[88,4,"1303100"],[93,2,"1235910"]],[[1,1,"お"],[14,1,"お"],[43,1,"い"],[58,1,"はち"],[60,1,"す"],[93,1,"さけ"]]],["「やかましい。ここをなんとこころえる。しずまれ、しずまれ。」",[[1,5,"1211380"],[7,2,"1288810"],[10,2,"2846738"],[13,5,"1360920"],[19,3,"1431670"],[24,3,"1431670"]],[]],["別当がむちをひゅうぱちっとならしましたのでどんぐりどもは、やっとしずまりました。やまねこは、ぴんとひげをひねって言いました。",[[0,2,"1510070"],[3,2,"1633970"],[6,3,"2523940"],[9,3,"1010410"],[13,3,"1212650"],[21,4,"1419200"],[25,2,"1234250"],[29,3,"1012800"],[32,4,"1594270"],[40,4,"1303100"],[49,2,"1601810"],[52,3,"1469530"],[56,2,"1587040"]],[[0,2,"べっとう"],[56,1,"い"]]],["「裁判ももうきょうで三日目だぞ。いい加減に仲なおりしたらどうだ。」",[[1,2,"1296120"],[4,2,"1012480"],[6,3,"1579110"],[10,2,"1301330"],[12,1,"1604890"],[16,4,"1277440"],[21,4,"1426000"],[25,1,"1157170"],[28,2,"1451160"]],[[1,2,"さいばん"],[10,2,"みっか"],[12,1,"め"],[18,2,"かげん"],[21,1,"なか"]]],["すると、もうどんぐりどもが、くちぐちに云いました。",[[0,2,"1157170"],[4,2,"1012480"],[6,4,"1419200"],[10,2,"1234250"],[14,4,"1592190"],[19,2,"1587040"]],[[19,1,"い"]]],["「いえいえ、だめです。なんといったって、頭のとがっているのがいちばんえらいのです。」",[[1,4,"1000620"],[6,2,"1409110"],[11,2,"2846738"],[14,2,"1587040"],[20,1,"1582310"],[22,3,"1389970"],[26,2,"1577980"],[30,4,"1165970"],[34,3,"1155780"]],[[20,1,"あたま"]]],["「いいえ、ちがいます。まるいのがえらいのです。」",[[1,3,"1583250"],[5,3,"1158880"],[11,3,"1604230"],[16,3,"1155780"]],[]],["「そうでないよ。大きなことだよ。」がやがやがやがや、もうなにがなんだかわからなくなりました。山猫が叫びました。",[[1,2,"1241450"],[4,2,"1529520"],[8,3,"1412890"],[11,2,"1241450"],[17,4,"1003280"],[21,4,"1003280"],[26,2,"1012480"],[28,2,"1577100"],[31,2,"2846738"],[35,3,"1606560"],[40,2,"1375610"],[46,2,"1303100"],[49,2,"1235910"]],[[8,1,"おお"],[46,2,"やまねこ"],[49,1,"さけ"]]],["「だまれ、やかましい。ここをなんと心得る。しずまれしずまれ。」",[[1,3,"1534930"],[5,5,"1211380"],[11,2,"1288810"],[14,2,"2846738"],[17,3,"1360920"],[21,3,"1431670"],[25,3,"1431670"]],[[17,2,"こころえ"]]],["別当が、むちをひゅうぱちっと鳴らしました。山猫がひげをぴんとひねって言いました。",[[0,2,"1510070"],[4,2,"1633970"],[7,3,"2523940"],[10,3,"1010410"],[14,3,"1532880"],[21,2,"1303100"],[24,2,"1601810"],[30,3,"1469530"],[34,2,"1587040"]],[[0,2,"べっとう"],[14,1,"な"],[21,2,"やまねこ"],[34,1,"い"]]],["「裁判ももうきょうで三日目だぞ。いい加減になかなおりをしたらどうだ。」",[[1,2,"1296120"],[4,2,"1012480"],[6,3,"1579110"],[10,2,"1301330"],[12,1,"1604890"],[16,4,"1277440"],[21,2,"1423310"],[24,2,"1385780"],[27,1,"1157170"],[30,2,"1451160"]],[[1,2,"さいばん"],[10,2,"みっか"],[12,1,"め"],[18,2,"かげん"]]],["「いえ、いえ、だめです。あたまのとがったものが……。」がやがやがやがや。",[[1,2,"1583250"],[4,2,"1583250"],[7,2,"1409110"],[12,3,"1582310"],[16,3,"1389970"],[20,2,"1502390"],[27,4,"1003280"],[31,4,"1003280"]],[]],["山ねこが叫びました。",[[0,3,"1303100"],[4,2,"1235910"]],[[0,1,"やま"],[4,1,"さけ"]]],["「やかましい。ここをなんとこころえる。しずまれ、しずまれ。」",[[1,5,"1211380"],[7,2,"1288810"],[10,2,"2846738"],[13,5,"1360920"],[19,3,"1431670"],[24,3,"1431670"]],[]],["別当が、むちをひゅうぱちっと鳴らし、どんぐりはみんなしずまりました。山猫が一郎にそっと申しました。",[[0,2,"1510070"],[4,2,"1633970"],[7,3,"2523940"],[10,3,"1010410"],[14,3,"1532880"],[18,4,"1419200"],[23,3,"1202150"],[26,4,"1594270"],[34,2,"1303100"],[40,3,"1006810"],[43,2,"1363090"]],[[0,2,"べっとう"],[14,1,"な"],[34,2,"やまねこ"],[37,2,"いちろう"],[43,1,"もう"]]],["「このとおりです。どうしたらいいでしょう。」",[[1,5,"2233930"],[9,2,"1451160"],[11,1,"1157170"],[14,2,"1605820"]],[]],["一郎はわらってこたえました。",[[3,3,"1351360"],[7,3,"1179810"]],[[0,2,"いちろう"]]],["「そんなら、こう言いわたしたらいいでしょう。このなかでいちばんばかで、めちゃくちゃで、まるでなっていないようなのが、いちばんえらいとね。ぼくお説教できいたんです。」",[[1,2,"1006970"],[6,2,"1578760"],[8,5,"1264190"],[15,2,"1605820"],[22,4,"2872942"],[27,4,"1165970"],[31,2,"1601260"],[35,6,"1533000"],[43,3,"1216280"],[46,2,"1375610"],[49,1,"1577980"],[52,2,"1605845"],[58,4,"1165970"],[62,3,"1155780"],[68,2,"1521400"],[71,2,"1386430"],[74,2,"1226210"]],[[8,1,"い"],[71,2,"せっきょう"]]],["山猫はなるほどというふうにうなずいて、それからいかにも気取って、繻子のきものの胸を開いて、黄いろの陣羽織をちょっと出してどんぐりどもに申しわたしました。",[[0,2,"1303100"],[3,4,"1375820"],[8,2,"1587040"],[10,2,"1499730"],[13,4,"1574310"],[19,2,"1006970"],[23,3,"1466970"],[27,3,"1222260"],[32,2,"1570570"],[35,3,"1423240"],[39,1,"1237820"],[41,2,"1202440"],[45,3,"1576760"],[49,3,"1633530"],[53,4,"1163940"],[57,2,"1338180"],[60,4,"1419200"],[64,2,"1234250"],[67,5,"1362990"]],[[0,2,"やまねこ"],[27,2,"きど"],[32,2,"しゅす"],[39,1,"えり"],[41,1,"ひら"],[45,1,"き"],[49,3,"じんばおり"],[57,1,"だ"],[67,1,"もう"]]],["「よろしい。しずかにしろ。申しわたしだ。このなかで、いちばんえらくなくて、ばかで、めちゃくちゃで、てんでなっていなくて、あたまのつぶれたようなやつが、いちばんえらいのだ。」",[[1,4,"1224880"],[6,3,"1381820"],[10,2,"1157170"],[13,5,"1362990"],[20,4,"2872942"],[26,4,"1165970"],[30,3,"1155780"],[33,2,"1529520"],[37,2,"1601260"],[41,6,"1533000"],[49,3,"1008320"],[52,2,"1375610"],[55,1,"1577980"],[60,3,"1582310"],[64,3,"1433830"],[68,2,"1605845"],[71,2,"1445640"],[75,4,"1165970"],[79,3,"1155780"]],[[13,1,"もう"]]],["どんぐりは、しいんとしてしまいました。それはそれはしいんとして、堅まってしまいました。",[[0,4,"1419200"],[6,4,"1359470"],[10,1,"1157170"],[12,3,"1305380"],[19,2,"1006970"],[22,2,"1006970"],[25,4,"1359470"],[29,1,"1157170"],[32,1,"1895580"],[33,2,"1410590"],[36,3,"1305380"]],[[32,1,"かた"]]],["そこで山猫は、黒い繻子の服をぬいで、額の汗をぬぐいながら、一郎の手をとりました。別当も大よろこびで、五六ぺん、鞭をひゅうぱちっ、ひゅうぱちっ、ひゅうひゅうぱちっと鳴らしました。やまねこが言いました。",[[0,2,"1436050"],[3,2,"1303100"],[7,2,"1287420"],[9,2,"1570570"],[12,1,"1500940"],[14,2,"1416400"],[18,1,"1207500"],[20,1,"1213060"],[22,3,"1357220"],[32,1,"1327190"],[34,2,"1326980"],[40,2,"1510070"],[43,5,"1413310"],[52,2,"2208060"],[55,1,"1633970"],[57,3,"2523940"],[60,3,"1010410"],[64,3,"2523940"],[67,3,"1010410"],[71,6,"2059800"],[77,3,"1010410"],[81,3,"1532880"],[88,4,"1303100"],[93,2,"1587040"]],[[3,2,"やまねこ"],[7,1,"くろ"],[9,2,"しゅす"],[12,1,"ふく"],[18,1,"がく"],[20,1,"あせ"],[29,2,"いちろう"],[32,1,"て"],[40,2,"べっとう"],[43,1,"おお"],[50,2,"ごろく"],[55,1,"むち"],[81,1,"な"],[93,1,"い"]]],["「どうもありがとうございました。これほどのひどい裁判を、まるで一分半でかたづけてくださいました。どうかこれからわたしの裁判所の、名誉判事になってください。これからも、葉書が行ったら、どうか来てくださいませんか。そのたびにお礼はいたします。」",[[1,2,"1451160"],[4,5,"1586820"],[9,3,"1270350"],[16,2,"1628530"],[21,3,"1602060"],[24,2,"1296120"],[28,3,"1216280"],[31,3,"1632850"],[35,4,"1511790"],[40,4,"1184280"],[48,2,"1451160"],[51,2,"1628530"],[55,3,"1311110"],[59,3,"1296160"],[64,2,"1531870"],[66,2,"1478560"],[69,2,"1375610"],[72,4,"1184280"],[77,2,"1628530"],[83,2,"1546590"],[86,2,"1578850"],[91,2,"1451160"],[94,1,"1547720"],[96,4,"1184280"],[105,4,"2651400"],[110,2,"1270810"],[113,3,"1421900"]],[[24,2,"さいばん"],[31,3,"いちふんはん"],[59,3,"さいばんしょ"],[64,2,"めいよ"],[66,2,"はんじ"],[83,2,"はがき"],[86,1,"い"],[94,1,"き"],[111,1,"れい"]]],["「承知しました。お礼なんかいりませんよ。」",[[1,2,"1349480"],[3,1,"1157170"],[8,2,"1270810"],[13,2,"1465580"]],[[1,2,"しょうち"],[9,1,"れい"]]],["「いいえ、お礼はどうかとってください。わたしのじんかくにかかわりますから。そしてこれからは、葉書にかねた一郎どのと書いて、こちらを裁判所としますが、ようございますか。」",[[1,3,"1583250"],[5,2,"1270810"],[8,2,"1451160"],[11,2,"1326980"],[14,4,"1184280"],[19,3,"1311110"],[23,4,"1366730"],[28,4,"1589880"],[37,3,"1006730"],[40,2,"1628530"],[46,2,"1546590"],[49,2,"1256520"],[54,2,"1442500"],[57,2,"1343950"],[61,3,"1004500"],[65,3,"1296160"],[69,1,"1157170"],[74,2,"1605845"],[76,3,"1270350"]],[[6,1,"れい"],[46,2,"はがき"],[52,2,"いちろう"],[57,1,"か"],[65,3,"さいばんしょ"]]],["一郎が「ええ、かまいません。」と申しますと、やまねこはまだなにか言いたそうに、しばらくひげをひねって、眼をぱちぱちさせていましたが、とうとう決心したらしく言い出しました。",[[4,2,"1001140"],[7,3,"1279680"],[16,2,"1363090"],[22,4,"1303100"],[27,2,"1527110"],[29,2,"1577100"],[32,2,"1587040"],[35,2,"1241450"],[39,4,"1304420"],[43,2,"1601810"],[46,3,"1469530"],[51,1,"1604890"],[53,4,"1101650"],[57,1,"1157170"],[60,1,"1577980"],[66,4,"1449890"],[70,2,"1254340"],[72,1,"1157170"],[77,4,"1264080"]],[[0,2,"いちろう"],[16,1,"もう"],[32,1,"い"],[51,1,"め"],[70,2,"けっしん"],[77,3,"いいだ"]]],["「それから、はがきの文句ですが、これからは、用事これありに付き、明日出頭すべしと書いてどうでしょう。」",[[1,2,"1006970"],[6,3,"1546590"],[10,2,"1505260"],[16,2,"1628530"],[22,2,"1546300"],[24,2,"1628530"],[26,2,"2150170"],[29,2,"1495740"],[32,2,"1584660"],[34,2,"1339870"],[36,1,"1157170"],[40,2,"1343950"],[43,2,"1451160"]],[[10,2,"もんく"],[22,2,"ようじ"],[29,1,"つ"],[32,2,"みょうにち"],[34,2,"しゅっとう"],[40,1,"か"]]],["一郎はわらって言いました。",[[3,3,"1351360"],[7,2,"1587040"]],[[0,2,"いちろう"],[7,1,"い"]]],["「さあ、なんだか変ですね。そいつだけはやめた方がいいでしょう。」",[[1,2,"1005110"],[4,2,"2846738"],[8,1,"1510640"],[13,3,"1006600"],[19,2,"1310680"],[22,1,"1516930"],[24,2,"1605820"]],[[8,1,"へん"],[22,1,"ほう"]]],["山猫は、どうも言いようがまずかった、いかにも残念だというふうに、しばらくひげをひねったまま、下を向いていましたが、やっとあきらめて言いました。",[[0,2,"1303100"],[4,2,"1451160"],[7,4,"1756510"],[12,4,"1495000"],[18,3,"1466970"],[22,2,"1304680"],[26,2,"1587040"],[28,2,"1499730"],[32,4,"1304420"],[36,2,"1601810"],[39,3,"1469530"],[43,2,"1585410"],[46,1,"1184140"],[48,2,"1277080"],[51,1,"1577980"],[57,3,"1012800"],[60,4,"1436730"],[65,2,"1587040"]],[[0,2,"やまねこ"],[7,1,"い"],[22,2,"ざんねん"],[46,1,"した"],[48,1,"む"],[65,1,"い"]]],["「それでは、文句はいままでのとおりにしましょう。そこで今日のお礼ですが、あなたは黄金のどんぐり一升と、塩鮭のあたまと、どっちをおすきですか。」",[[1,2,"1006970"],[6,2,"1505260"],[9,2,"1288850"],[14,3,"1432920"],[18,1,"1157170"],[24,2,"1436050"],[27,2,"1579110"],[30,2,"1270810"],[36,3,"1223615"],[40,2,"1181860"],[43,4,"1419200"],[47,2,"1163460"],[51,2,"1178700"],[54,3,"1582310"],[59,3,"1189360"],[64,2,"1277450"]],[[6,2,"もんく"],[27,2,"きょう"],[31,1,"れい"],[40,2,"きん"],[48,1,"しょう"],[51,2,"しおざけ"]]],["「黄金のどんぐりがすきです。」",[[1,2,"1181860"],[4,4,"1419200"],[9,2,"1277450"]],[[1,2,"おうごん"]]],["山猫は、鮭の頭でなくて、まあよかったというように、口早に馬車別当に云いました。",[[0,2,"1303100"],[4,1,"1579300"],[6,1,"1582310"],[8,2,"1529520"],[12,2,"1012050"],[14,3,"1605820"],[19,2,"1587040"],[21,2,"1605845"],[25,2,"1276550"],[28,2,"1471780"],[30,2,"1510070"],[33,2,"1587040"]],[[0,2,"やまねこ"],[4,1,"しゃけ"],[6,1,"あたま"],[25,2,"くちばや"],[28,2,"ばしゃ"],[30,2,"べっとう"],[33,1,"い"]]],["「どんぐりを一升早くもってこい。一升にたりなかったら、めっきのどんぐりもまぜてこい。はやく。」",[[1,4,"1419200"],[6,2,"1163460"],[8,2,"1404975"],[10,2,"1315720"],[13,2,"1547720"],[16,2,"1163460"],[19,2,"1404740"],[27,3,"1582210"],[31,4,"1419200"],[36,2,"1290310"],[39,2,"1547720"],[42,3,"1404975"]],[[6,2,"いちしょう"],[8,1,"はや"],[16,2,"いちしょう"]]],["別当は、さっきのどんぐりをますに入れて、はかって叫びました。",[[0,2,"1510070"],[4,3,"1005180"],[8,4,"1419200"],[13,2,"1524900"],[16,2,"1465610"],[20,3,"1600660"],[24,2,"1235910"]],[[0,2,"べっとう"],[16,1,"い"],[24,1,"さけ"]]],["「ちょうど一升あります。」",[[1,4,"1427340"],[5,2,"1163460"],[7,2,"1296400"]],[[5,2,"いちしょう"]]],["山ねこの陣羽織が風にばたばた鳴りました。そこで山ねこは、大きく延びあがって、めをつぶって、半分あくびをしながら言いました。",[[0,3,"1303100"],[4,3,"1633530"],[8,1,"1499720"],[10,4,"1098660"],[14,2,"1532910"],[20,2,"1436050"],[23,3,"1303100"],[28,3,"1588880"],[31,2,"1358870"],[33,3,"1352290"],[38,1,"1197710"],[40,3,"1585820"],[45,2,"1479890"],[47,3,"1254010"],[51,1,"1157170"],[55,2,"1587040"]],[[0,1,"やま"],[4,3,"じんばおり"],[8,1,"ふう"],[14,1,"な"],[23,1,"やま"],[28,1,"おお"],[31,1,"の"],[45,2,"はんぶん"],[55,1,"い"]]],["「よし、はやく馬車のしたくをしろ。」白い大きなきのこでこしらえた馬車が、ひっぱりだされました。そしてなんだかねずみいろの、おかしな形の馬がついています。",[[1,2,"1541760"],[4,3,"1404975"],[7,2,"1471780"],[10,3,"1310260"],[14,2,"1157170"],[18,2,"1474910"],[20,3,"1412890"],[23,3,"1416010"],[27,4,"1567390"],[32,2,"1471780"],[36,6,"1169450"],[47,3,"1006730"],[50,2,"2846738"],[54,5,"1397910"],[61,4,"1612790"],[65,1,"1250220"],[67,1,"1471560"],[69,2,"1495740"],[72,1,"1577980"]],[[7,2,"ばしゃ"],[18,1,"しろ"],[20,1,"おお"],[32,2,"ばしゃ"],[65,1,"かたち"],[67,1,"うま"]]],["「さあ、おうちへお送りいたしましょう。」山猫が言いました。二人は馬車にのり別当は、どんぐりのますを馬車のなかに入れました。",[[1,2,"1005110"],[4,3,"2213230"],[9,2,"1402730"],[11,3,"1421900"],[20,2,"1303100"],[23,2,"1587040"],[29,2,"1582670"],[32,2,"1471780"],[35,2,"1355120"],[37,2,"1510070"],[41,4,"1419200"],[46,2,"1524900"],[49,2,"1471780"],[52,2,"1423310"],[55,2,"1465610"]],[[9,1,"おく"],[20,2,"やまねこ"],[23,1,"い"],[29,2,"ふたり"],[32,2,"ばしゃ"],[37,2,"べっとう"],[49,2,"ばしゃ"],[55,1,"い"]]],["ひゅう、ぱちっ。",[[0,3,"2523940"],[4,3,"1010410"]],[]],["馬車は草地をはなれました。木や藪がけむりのようにぐらぐらゆれました。一郎は黄金のどんぐりを見、やまねこはとぼけたかおつきで、遠くをみていました。",[[0,2,"1471780"],[3,2,"1633620"],[6,3,"1550840"],[13,1,"1534520"],[15,1,"1634220"],[17,3,"1177180"],[21,2,"1605845"],[24,4,"1004110"],[28,2,"1545710"],[37,2,"1181860"],[40,4,"1419200"],[45,1,"1259290"],[47,4,"1303100"],[52,3,"1610900"],[57,3,"1002580"],[62,2,"1177820"],[65,1,"1259290"],[67,1,"1577980"]],[[0,2,"ばしゃ"],[3,2,"くさち"],[13,1,"き"],[15,1,"やぶ"],[34,2,"いちろう"],[37,2,"きん"],[45,1,"み"],[62,1,"とお"]]],["馬車が進むにしたがって、どんぐりはだんだん光がうすくなって、まもなく馬車がとまったときは、あたりまえの茶いろのどんぐりに変っていました。そして、山ねこの黄いろな陣羽織も、別当も、きのこの馬車も、一度に見えなくなって、一郎はじぶんのうちの前に、どんぐりを入れたますを持って立っていました。",[[0,2,"1471780"],[3,2,"1365980"],[6,4,"1335210"],[12,4,"1419200"],[17,4,"1597350"],[21,1,"1272780"],[23,3,"1475480"],[26,2,"1375610"],[30,1,"1633990"],[32,2,"1529520"],[34,2,"1471780"],[37,3,"1310620"],[41,2,"1315840"],[45,5,"1448800"],[51,3,"1422720"],[55,4,"1419200"],[60,2,"1510790"],[63,1,"1577980"],[68,3,"1006730"],[72,3,"1303100"],[76,3,"1576760"],[80,3,"1633530"],[85,2,"1510070"],[89,3,"1416010"],[93,2,"1471780"],[97,2,"1576250"],[100,2,"1259140"],[104,2,"1375610"],[111,3,"1318610"],[115,2,"1457730"],[118,1,"1392580"],[121,4,"1419200"],[126,2,"1465610"],[129,2,"1524900"],[132,2,"1315720"],[135,2,"1597040"],[138,1,"1577980"]],[[0,2,"ばしゃ"],[3,1,"すす"],[21,1,"ひかり"],[34,2,"ばしゃ"],[51,1,"ちゃ"],[60,1,"かわ"],[72,1,"やま"],[76,1,"き"],[80,3,"じんばおり"],[85,2,"べっとう"],[93,2,"ばしゃ"],[97,2,"いちど"],[100,1,"み"],[108,2,"いちろう"],[118,1,"まえ"],[126,1,"い"],[132,1,"も"],[135,1,"た"]]],["それからあと、山ねこ拝というはがきは、もうきませんでした。やっぱり、出頭すべしと書いてもいいと言えばよかったと、一郎はときどき思うのです。",[[0,2,"1006970"],[4,2,"1269320"],[7,3,"1303100"],[10,1,"1633870"],[12,2,"1587040"],[14,3,"1546590"],[19,2,"1012480"],[21,1,"1547720"],[29,4,"2772770"],[34,2,"1339870"],[36,1,"1157170"],[40,2,"1343950"],[44,2,"1605820"],[47,2,"1587040"],[50,3,"1605820"],[59,4,"1598680"],[63,2,"1589350"]],[[7,1,"やま"],[10,1,"はい"],[34,2,"しゅっとう"],[40,1,"か"],[47,1,"い"],[56,2,"いちろう"],[63,1,"おも"]]]]