[["一",[],[[0,1,"いち"]]],["むかし、むかし、あるところに、おじいさんとおばあさんがありました。まいにち、おじいさんは山へしば刈りに、おばあさんは川へ洗濯に行きました。",[[0,3,"1382370"],[4,3,"1382370"],[8,2,"1586840"],[10,3,"1343100"],[15,5,"1002320"],[21,5,"1002330"],[27,2,"1296400"],[33,4,"1524720"],[38,5,"1002320"],[44,1,"1302680"],[46,1,"1157170"],[52,5,"1002330"],[58,1,"1390020"],[60,2,"1390980"],[63,2,"1578850"]],[[44,1,"やま"],[48,1,"か"],[58,1,"かわ"],[60,2,"せんたく"],[63,1,"い"]]],["ある日、おばあさんが、川のそばで、せっせと洗濯をしていますと、川上から、大きな桃が一つ、",[[0,3,"1153630"],[4,5,"1002330"],[11,1,"1390020"],[13,2,"1403830"],[17,4,"2008620"],[21,2,"1390980"],[24,1,"1157170"],[26,1,"1577980"],[36,3,"1412890"],[39,1,"1448290"],[41,2,"1160820"]],[[2,1,"ひ"],[11,1,"かわ"],[21,2,"せんたく"],[31,2,"かわかみ"],[36,1,"おお"],[39,1,"もも"],[41,1,"ひと"]]],["「ドンブラコッコ、スッコッコ。",[],[]],["ドンブラコッコ、スッコッコ。」",[],[]],["と流れて来ました。",[[1,2,"1552140"],[4,1,"1547720"]],[[1,1,"なが"],[4,1,"き"]]],["「おやおや、これはみごとな桃だこと。おじいさんへのおみやげに、どれどれ、うちへ持って帰りましょう。」",[[1,4,"1001570"],[6,2,"1628530"],[9,3,"1259620"],[13,1,"1448290"],[15,2,"1241450"],[18,5,"1002320"],[25,4,"1002500"],[31,4,"1188630"],[36,2,"1457730"],[39,2,"1315720"],[42,2,"1221270"]],[[13,1,"もも"],[39,1,"も"],[42,1,"かえ"]]],["おばあさんは、そう言いながら、腰をかがめて桃を取ろうとしましたが、遠くって手がとどきません。おばあさんはそこで、",[[0,5,"1002330"],[7,4,"1394680"],[15,1,"1288340"],[17,3,"1246560"],[21,1,"1448290"],[23,3,"1326980"],[27,1,"1157170"],[33,2,"1177820"],[37,1,"1327190"],[39,3,"1457200"],[46,5,"1002330"],[52,2,"1436050"]],[[9,1,"い"],[15,1,"こし"],[21,1,"もも"],[23,1,"と"],[33,1,"とお"],[37,1,"て"]]],["「あっちの水は、かあらいぞ。",[[1,3,"1483185"],[5,1,"1371260"],[9,3,"1281450"]],[[5,1,"みいず"]]],["こっちの水は、ああまいぞ。",[[0,3,"1004500"],[4,1,"1371260"],[7,1,"2394370"],[8,3,"1213400"]],[[4,1,"みいず"]]],["かあらい水は、よけて来い。",[[7,2,"1583260"],[10,2,"1547720"]],[[4,1,"みいず"],[10,1,"こ"]]],["ああまい水に、よって来い。",[[0,1,"1565440"],[1,3,"1213400"],[4,1,"1371260"],[7,2,"1536350"],[10,2,"1547720"]],[[4,1,"みいず"],[10,1,"こ"]]],["と歌いながら、手をたたきました。すると桃はまた、",[[1,2,"1588120"],[7,1,"1327190"],[9,3,"1416170"],[16,2,"1157170"],[19,1,"1448290"],[21,2,"1524930"]],[[1,1,"うた"],[7,1,"て"],[19,1,"もも"]]],["「ドンブラコッコ、スッコッコ。",[],[]],["ドンブラコッコ、スッコッコ。」",[],[]],["といいながら、おばあさんの前へ流れて来ました。おばあさんはにこにこしながら、",[[1,2,"1587040"],[7,5,"1002330"],[13,1,"1392580"],[15,2,"1552140"],[18,1,"1547720"],[23,5,"1002330"],[29,4,"1091130"],[33,1,"1157170"]],[[13,1,"まえ"],[15,1,"なが"],[18,1,"き"]]],["「早くおじいさんと二人で分けて食べましょう。」",[[1,2,"1404975"],[3,5,"1002320"],[9,2,"1582670"],[12,2,"1503000"],[15,2,"1358280"]],[[1,1,"はや"],[9,2,"ふたり"],[12,1,"わ"],[15,1,"た"]]],["と言って、桃をひろい上げて、洗濯物といっしょにたらいの中に入れて、えっちら、おっちら、かかえておうちへ帰りました。",[[1,2,"1587040"],[5,1,"1448290"],[7,3,"1332570"],[10,2,"1352320"],[14,3,"1391020"],[18,4,"1163400"],[23,3,"2096310"],[27,1,"1423310"],[29,2,"1465610"],[33,9,"2036470"],[43,3,"1516310"],[47,3,"2213230"],[51,2,"1221270"]],[[1,1,"い"],[5,1,"もも"],[10,1,"あ"],[14,3,"せんたくもの"],[27,1,"なか"],[29,1,"い"],[51,1,"かえ"]]],["夕方になってやっと、おじいさんは山からしばを背負って帰って来ました。",[[0,2,"1542790"],[3,2,"1375610"],[6,3,"1012800"],[10,5,"1002320"],[16,1,"1302680"],[19,2,"1321610"],[22,3,"1472860"],[26,2,"1221270"],[29,1,"1547720"]],[[0,2,"ゆうがた"],[16,1,"やま"],[22,2,"せお"],[26,1,"かえ"],[29,1,"き"]]],["「おばあさん、今帰ったよ。」",[[1,5,"1002330"],[7,1,"1288850"],[8,2,"1221270"]],[[7,1,"いま"],[8,1,"かえ"]]],["「おや、おじいさん、おかいんなさい。待っていましたよ。さあ、早くお上がんなさい。いいものを上げますから。」",[[1,2,"1365040"],[4,5,"1002320"],[11,2,"1473740"],[14,3,"1157090"],[18,2,"1410590"],[21,1,"1577980"],[27,2,"1005110"],[30,2,"1404975"],[33,3,"1352290"],[36,3,"1157090"],[40,2,"1605820"],[42,2,"1502390"],[45,2,"1352320"]],[[18,1,"ま"],[30,1,"はや"],[33,1,"あ"],[45,1,"あ"]]],["「それはありがたいな。何だね、そのいいものというのは。」",[[1,2,"1006970"],[4,5,"1541560"],[11,1,"2846738"],[15,2,"1006830"],[17,2,"1605820"],[19,2,"1502390"],[22,2,"1587040"]],[[11,1,"なん"]]],["こういいながら、おじいさんはわらじをぬいで、上に上がりました。その間に、おばあさんは戸棚の中からさっきの桃を重そうにかかえて来て、",[[0,4,"1004320"],[8,5,"1002320"],[14,3,"1402080"],[18,2,"1416400"],[22,1,"1352130"],[24,3,"1352290"],[31,3,"2712120"],[36,5,"1002330"],[42,2,"1267050"],[45,1,"1423310"],[48,3,"1005180"],[52,1,"1448290"],[54,1,"1335750"],[55,2,"1241450"],[58,3,"1516310"],[62,1,"1547720"]],[[22,1,"うえ"],[24,1,"あ"],[33,1,"ま"],[42,2,"とだな"],[45,1,"なか"],[52,1,"もも"],[54,1,"おも"],[62,1,"き"]]],["「ほら、ごらんなさいこの桃を。」",[[1,2,"1453850"],[4,6,"2217020"],[10,2,"1582920"],[12,1,"1448290"]],[[12,1,"もも"]]],["と言いました。",[[1,2,"1587040"]],[[1,1,"い"]]],["「ほほう、これはこれは。どこからこんなみごとな桃を買って来た。」",[[1,3,"2274490"],[5,2,"1628530"],[8,2,"1628530"],[12,2,"1577140"],[16,3,"1004880"],[19,3,"1259620"],[23,1,"1448290"],[25,2,"1473740"],[28,1,"1547720"]],[[23,1,"もも"],[25,1,"か"],[28,1,"き"]]],["「いいえ、買って来たのではありません。今日川で拾って来たのですよ。」",[[1,3,"1583250"],[5,2,"1473740"],[8,1,"1547720"],[13,2,"1296400"],[19,2,"1579110"],[21,1,"1390020"],[23,2,"1332570"],[26,1,"1547720"]],[[5,1,"か"],[8,1,"き"],[19,2,"きょう"],[21,1,"かわ"],[23,1,"ひろ"],[26,1,"き"]]],["「え、なに、川で拾って来た。それはいよいよめずらしい。」",[[1,1,"2194050"],[3,2,"1577100"],[6,1,"1390020"],[8,2,"1332570"],[11,1,"1547720"],[14,2,"1006970"],[17,4,"1587670"],[21,5,"1431850"]],[[6,1,"かわ"],[8,1,"ひろ"],[11,1,"き"]]],["こうおじいさんは言いながら、桃を両手にのせて、ためつ、すがめつ、ながめていますと、だしぬけに、桃はぽんと中から二つに割れて、",[[0,3,"1835900"],[3,4,"2231000"],[8,2,"1587040"],[14,1,"1448290"],[16,2,"1553660"],[19,2,"1600270"],[23,2,"1157080"],[27,3,"2028010"],[32,3,"1428830"],[36,1,"1577980"],[41,4,"1338120"],[47,1,"1448290"],[49,2,"1632650"],[52,1,"1423310"],[55,2,"1461160"],[58,2,"1208020"]],[[8,1,"い"],[14,1,"もも"],[16,2,"りょうて"],[47,1,"もも"],[52,1,"なか"],[55,1,"ふた"],[58,1,"わ"]]],["「おぎゃあ、おぎゃあ。」",[[1,4,"2060550"],[6,4,"2060550"]],[]],["と勇ましいうぶ声を上げながら、かわいらしい赤さんが元気よくとび出しました。",[[1,4,"1539660"],[5,3,"1661940"],[9,2,"1352320"],[15,6,"1190740"],[21,1,"2013900"],[22,2,"1579350"],[25,2,"1260720"],[27,2,"1605820"],[29,4,"1485350"]],[[1,1,"いさ"],[7,1,"こえ"],[9,1,"あ"],[21,1,"あか"],[25,2,"げんき"],[31,1,"だ"]]],["「おやおや、まあ。」",[[1,4,"1001570"],[6,2,"1012050"]],[]],["おじいさんも、おばあさんも、びっくりして、二人いっしょに声を立てました。",[[0,5,"1002320"],[7,5,"1002330"],[14,4,"1226360"],[18,1,"1157170"],[21,2,"1582670"],[23,4,"1163400"],[28,1,"1380440"],[30,2,"1551530"]],[[21,2,"ふたり"],[28,1,"こえ"],[30,1,"た"]]],["「まあまあ、わたしたちが、へいぜい、どうかして子供が一人ほしい、ほしいと言っていたものだから、きっと神さまがこの子をさずけて下さったにちがいない。」",[[1,4,"1012070"],[6,5,"1311300"],[13,4,"1507510"],[18,2,"1451160"],[21,1,"1157170"],[23,2,"1307850"],[26,2,"1576150"],[28,3,"1547330"],[32,3,"1547330"],[36,2,"1587040"],[39,1,"1577980"],[41,2,"1502390"],[47,3,"1003430"],[50,3,"1364920"],[54,2,"1582920"],[56,1,"1307770"],[58,3,"1330280"],[62,3,"1184280"],[67,5,"1610740"]],[[23,2,"こども"],[26,2,"ひとり"],[36,1,"い"],[50,1,"かみ"],[56,1,"こ"],[62,1,"くだ"]]],["おじいさんも、おばあさんも、うれしがって、こう言いました。",[[0,5,"1002320"],[7,5,"1002330"],[14,5,"1219520"],[21,4,"1004320"]],[[23,1,"い"]]],["そこであわてておじいさんがお湯をわかすやら、おばあさんがむつきをそろえるやら、大さわぎをして、赤さんを抱き上げて、うぶ湯をつかわせました。するといきなり、",[[0,2,"1436050"],[3,3,"1278830"],[7,5,"1002320"],[13,2,"1002510"],[16,3,"1501660"],[22,5,"1002330"],[28,3,"1521890"],[32,4,"1406120"],[39,4,"1414410"],[44,1,"1157170"],[47,1,"2013900"],[48,2,"1579350"],[51,4,"1516380"],[57,3,"1754920"],[61,3,"1305990"],[69,2,"1157170"],[72,4,"1282000"]],[[14,1,"ゆ"],[39,1,"おお"],[47,1,"あか"],[51,1,"だ"],[53,1,"あ"],[59,1,"ゆ"]]],["「うん。」",[[1,2,"1172610"]],[]],["と言いながら、赤さんは抱いているおばあさんの手をはねのけました。",[[1,2,"1587040"],[7,1,"2013900"],[8,2,"1579350"],[11,2,"1584090"],[14,2,"1577980"],[16,5,"1002330"],[22,1,"1327190"],[24,4,"1429660"]],[[1,1,"い"],[7,1,"あか"],[11,1,"だ"],[22,1,"て"]]],["「おやおや、何という元気のいい子だろう。」",[[1,4,"1001570"],[6,1,"2846738"],[8,2,"1587040"],[10,2,"1260720"],[13,3,"1835640"]],[[6,1,"なん"],[10,2,"げんき"],[15,1,"こ"]]],["おじいさんとおばあさんは、こう言って顔を見合わせながら、「あッは、あッは。」とおもしろそうに笑いました。",[[0,5,"1002320"],[6,5,"1002330"],[13,4,"1004320"],[18,1,"1217730"],[20,4,"1259570"],[29,2,"2394370"],[33,2,"2394370"],[35,1,"2069620"],[39,4,"1533580"],[43,2,"1241450"],[46,2,"1351360"]],[[15,1,"い"],[18,1,"かお"],[20,2,"みあ"],[46,1,"わら"]]],["そして桃の中から生まれた子だというので、この子に桃太郎という名をつけました。",[[0,3,"1006730"],[3,1,"1448290"],[5,1,"1423310"],[8,3,"1378690"],[12,1,"1307770"],[15,2,"1587040"],[20,2,"1582920"],[22,1,"1307770"],[28,2,"1587040"],[30,1,"1531330"],[32,2,"1433680"]],[[3,1,"もも"],[5,1,"なか"],[8,1,"う"],[12,1,"こ"],[22,1,"こ"],[24,3,"ももたろう"],[30,1,"な"]]],["二",[],[[0,1,"に"]]],["おじいさんとおばあさんは、それはそれはだいじにして桃太郎を育てました。桃太郎はだんだん成長するにつれて、あたりまえの子供にくらべては、ずっと体も大きいし、力がばかに強くって、すもうをとっても近所の村じゅうで、かなうものは一人もないくらいでしたが、そのくせ気だてはごくやさしくって、おじいさんとおばあさんによく孝行をしました。",[[0,5,"1002320"],[6,5,"1002330"],[13,2,"1006970"],[16,2,"1006970"],[19,3,"1413940"],[23,1,"1157170"],[29,2,"1160570"],[39,4,"1597350"],[43,2,"1375790"],[45,2,"1157170"],[48,2,"1559290"],[52,5,"1448800"],[58,2,"1307850"],[61,3,"1483540"],[67,3,"1006380"],[70,1,"1409140"],[72,3,"1588880"],[77,1,"1554820"],[79,2,"1601260"],[82,2,"1236070"],[87,3,"1401360"],[91,2,"1326980"],[95,2,"1242350"],[98,4,"2859474"],[104,3,"1208870"],[107,2,"1502390"],[110,2,"1576150"],[113,2,"1529520"],[123,4,"2097300"],[127,3,"1222670"],[131,2,"1240180"],[133,4,"1539040"],[140,5,"1002320"],[146,5,"1002330"],[152,2,"1605870"],[154,2,"1277880"],[157,1,"1157170"]],[[25,3,"ももたろう"],[29,1,"そだ"],[35,3,"ももたろう"],[43,2,"せいちょう"],[58,2,"こども"],[70,1,"からだ"],[72,1,"おお"],[77,1,"ちから"],[82,1,"つよ"],[95,2,"きんじょ"],[98,1,"むら"],[110,2,"ひとり"],[127,1,"き"],[154,2,"こうこう"]]],["桃太郎は十五になりました。",[[7,2,"1375610"]],[[0,3,"ももたろう"],[4,2,"じゅうご"]]],["もうそのじぶんには、日本の国中で、桃太郎ほど強いものはないようになりました。桃太郎はどこか外国へ出かけて、腕いっぱい、力だめしをしてみたくなりました。",[[0,2,"1012480"],[2,2,"1006830"],[4,3,"1318610"],[13,2,"1286850"],[22,2,"1236070"],[24,2,"1502390"],[27,4,"1459400"],[32,2,"1375610"],[42,2,"1577140"],[45,2,"1203620"],[48,3,"1598550"],[53,1,"1562850"],[54,4,"1165670"],[59,4,"1555010"],[64,1,"1157170"],[66,1,"1259290"],[69,2,"1375610"]],[[10,2,"にほん"],[13,2,"くにじゅう"],[17,3,"ももたろう"],[22,1,"つよ"],[38,3,"ももたろう"],[45,2,"がいこく"],[48,1,"で"],[53,1,"うで"],[59,1,"ちから"]]],["するとそのころ、ほうぼう外国の島々をめぐって帰って来た人があって、いろいろめずらしい、ふしぎなお話をした末に、",[[0,2,"1157170"],[3,4,"2547920"],[8,4,"1584105"],[12,2,"1203620"],[15,2,"1594540"],[18,3,"1342050"],[22,2,"1221270"],[25,1,"1547720"],[27,1,"1580640"],[29,2,"1296400"],[33,4,"1587850"],[37,5,"1431850"],[43,3,"1492570"],[47,2,"2581590"],[50,1,"1157170"],[52,1,"1525250"]],[[12,2,"がいこく"],[15,2,"しまじま"],[22,1,"かえ"],[25,1,"き"],[27,1,"ひと"],[48,1,"はなし"],[52,1,"すえ"]]],["「もう何年も何年も船をこいで行くと、遠い遠い海のはてに、鬼が島という所がある。悪い鬼どもが、いかめしいくろがねのお