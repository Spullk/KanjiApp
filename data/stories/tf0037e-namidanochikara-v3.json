[["昔、昔、世界に巨人がいました。この巨人は、身長が３００メートルありました。",[[0,1,"1382370"],[2,1,"1382370"],[4,2,"1373860"],[7,2,"1232090"],[10,1,"1577980"],[15,2,"1582920"],[17,2,"1232090"],[21,2,"1365770"],[27,4,"1132570"],[31,2,"1296400"]],[[0,1,"むかし"],[2,1,"むかし"],[4,2,"せかい"],[7,2,"きょじん"],[17,2,"きょじん"],[21,2,"しんちょう"]]],["巨人は、だんだんいなくなりました。最後の巨人はメキシコのきれいな町に住んでいました。この町は、アグアスカリエンテスと呼ばれていました。ステンエ2リカスアグア",[[0,2,"1232090"],[4,4,"1597350"],[8,3,"1155180"],[11,2,"1375610"],[17,2,"1293810"],[20,2,"1232090"],[28,3,"1591900","奇麗",3],[32,1,"1603990"],[34,2,"1334040"],[37,1,"1577980"],[42,2,"1582920"],[44,1,"1603990"],[58,2,"1266440"],[62,1,"1577980"]],[[0,2,"きょじん"],[17,2,"さいご"],[20,2,"きょじん"],[32,1,"まち"],[34,1,"す"],[44,1,"まち"],[58,1,"よ"]]],["ある日、その巨人も病気になって死にました。",[[0,3,"1153630"],[4,2,"1006830"],[6,2,"1232090"],[9,2,"1490230"],[12,2,"1375610"],[15,2,"1310730"]],[[2,1,"ひ"],[6,2,"きょじん"],[9,2,"びょうき"],[15,1,"し"]]],["でも、巨人を入れられる大きな墓はありませんでした。土の上に倒れたままでした。",[[3,2,"1232090"],[6,2,"1465610"],[11,3,"1412890"],[14,1,"1514840"],[16,2,"1296400"],[25,1,"1445270"],[27,1,"1352130"],[29,2,"1445790"],[32,2,"1585410"]],[[3,2,"きょじん"],[6,1,"い"],[11,1,"おお"],[14,1,"はか"],[25,1,"つち"],[27,1,"うえ"],[29,1,"たお"]]],["長い時間が経ちました。巨人の体は、土で覆われてしまいました。",[[0,2,"1429750"],[2,2,"1315920"],[5,2,"1251100"],[11,2,"1232090"],[14,1,"1409140"],[17,1,"1445270"],[19,2,"1588840"],[23,3,"1305380"]],[[0,1,"なが"],[2,2,"じかん"],[5,1,"た"],[11,2,"きょじん"],[14,1,"からだ"],[17,1,"つち"],[19,1,"おお"]]],["そして、大きくて広い丘になりました。この丘は人の形をしていました。",[[0,3,"1006730"],[4,3,"1588880"],[8,2,"1278410"],[10,1,"1588920"],[12,2,"1375610"],[18,2,"1582920"],[20,1,"1588920"],[22,1,"1580640"],[24,1,"1250220"],[26,1,"1157170"],[28,1,"1577980"]],[[4,1,"おお"],[8,1,"ひろ"],[10,1,"おか"],[20,1,"おか"],[22,1,"ひと"],[24,1,"かたち"]]],["その丘は「死者の丘」と丘呼ばれました。の7者アグアスカリエンテスで死一番有名な場所になりました。",[[0,2,"1006830"],[2,1,"1588920"],[5,2,"1310870"],[8,1,"1588920"],[11,1,"1588920"],[12,2,"1266440"],[21,1,"1322990"],[33,1,"1310720"],[34,2,"1165970"],[36,2,"1541620"],[39,2,"1355850"],[42,2,"1375610"]],[[2,1,"おか"],[5,2,"ししゃ"],[8,1,"おか"],[11,1,"おか"],[12,1,"よ"],[21,1,"しゃ"],[33,1,"し"],[34,2,"いちばん"],[36,2,"ゆうめい"],[39,2,"ばしょ"]]],["それから３０００年後、町の汚染が進んで、丘まで来ました。",[[0,2,"1006970"],[8,2,"1468570"],[11,1,"1603990"],[13,2,"1179040"],[16,2,"1365980"],[20,1,"1588920"],[23,1,"1547720"]],[[8,2,"ねんご"],[11,1,"まち"],[13,2,"おせん"],[16,1,"すす"],[20,1,"おか"],[23,1,"き"]]],["！てけ助そんなある日、急に地面が大きく揺れました。みんなは地震があったと思いました。みんなびっくりしました。！え",[[4,3,"1007130"],[7,3,"1153630"],[11,1,"1228560"],[13,2,"1421510"],[16,3,"1588880"],[19,2,"1545710"],[25,3,"1202150"],[29,2,"1421210"],[32,2,"1296400"],[36,2,"1589350"],[42,3,"1202150"],[45,4,"1226360"],[49,1,"1157170"],[55,1,"2194050"]],[[3,1,"じょ"],[9,1,"ひ"],[11,1,"きゅう"],[13,2,"じめん"],[16,1,"おお"],[19,1,"ゆ"],[29,2,"じしん"],[36,1,"おも"]]],["でも地震ではありませんでした。巨人が起き上がったのです。みんなは近くに集まりました。そして巨人を見ました。女の巨人でした。",[[2,2,"1421210"],[6,2,"1296400"],[15,2,"1232090"],[18,5,"1223650"],[28,3,"1202150"],[32,2,"1242160"],[35,3,"1333550"],[42,3,"1006730"],[45,2,"1232090"],[48,1,"1259290"],[53,1,"1344930"],[55,2,"1232090"]],[[2,2,"じしん"],[15,2,"きょじん"],[18,3,"おきあ"],[32,1,"ちか"],[35,1,"あつ"],[45,2,"きょじん"],[48,1,"み"],[53,1,"おんな"],[55,2,"きょじん"]]],["巨人は泣いていました。大きな涙を流しました。",[[0,2,"1232090"],[3,2,"1229840"],[6,1,"1577980"],[11,3,"1412890"],[14,1,"1555930"],[16,2,"1552120"]],[[0,2,"きょじん"],[3,1,"な"],[11,1,"おお"],[14,1,"なみだ"],[16,1,"なが"]]],["人々は逃げようとしましたが、逃げられませんでした。そして、涙は人を動物に変えました。",[[0,2,"1580650"],[3,4,"1450330"],[8,1,"1157170"],[14,2,"1450330"],[25,3,"1006730"],[29,1,"1555930"],[31,1,"1580640"],[33,2,"1451470"],[36,2,"1510650"]],[[0,2,"ひとびと"],[3,1,"に"],[14,1,"に"],[29,1,"なみだ"],[31,1,"ひと"],[33,2,"どうぶつ"],[36,1,"か"]]],["建物を木に変えました。",[[0,2,"1257540"],[3,1,"1534520"],[5,2,"1510650"]],[[0,2,"たてもの"],[3,1,"き"],[5,1,"か"]]],["世界中の人がこのニュースを見ました。５日ぐらい経って、汚染がなくなりました。天気もよくなりました。",[[0,3,"1753790"],[4,1,"1580640"],[6,2,"1582920"],[8,4,"1091500"],[13,1,"1259290"],[18,2,"1268570"],[23,2,"1251100"],[27,2,"1179040"],[30,4,"1518540"],[38,2,"1438690"],[41,4,"2029460"]],[[0,3,"せかいじゅう"],[4,1,"ひと"],[13,1,"み"],[18,2,"いつか"],[23,1,"た"],[27,2,"おせん"],[38,2,"てん