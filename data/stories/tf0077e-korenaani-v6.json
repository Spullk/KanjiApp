[["これ、なあに？",[[0,2,"1628530"],[3,3,"1577100"]],[]],["これは、ランドセル。小学生のかばんです。",[[0,2,"1628530"],[4,5,"1140220"],[10,3,"1347880"],[14,3,"1208910"]],[[10,3,"しょうがくせい"]]],["これ、なあに？",[[0,2,"1628530"],[3,3,"1577100"]],[]],["これは、うわばき。学校の入り口で、くつをぬぎます。そして、うわばきをはきます。",[[0,2,"1628530"],[4,4,"1354470"],[9,2,"1206730"],[12,3,"1582820"],[17,2,"1246700"],[20,2,"1416400"],[25,3,"1006730"],[29,4,"1354470"],[34,2,"1488000"]],[[9,2,"がっこう"],[12,3,"いりぐち"]]],["教室に来ました。",[[0,2,"1237150"],[3,1,"1547720"]],[[0,2,"きょうしつ"],[3,1,"き"]]],["これ、なあに？",[[0,2,"1628530"],[3,3,"1577100"]],[]],["これは、ふでばこ。えんぴつや、けしゴムが入っています。",[[0,2,"1628530"],[4,4,"1487890"],[9,4,"1178590"],[15,4,"1350080"],[20,2,"1465590"],[23,1,"1577980"]],[[20,1,"はい"]]],["これ、なあに？これは、きゅうしょくぶくろ。",[[0,2,"1628530"],[3,3,"1577100"],[7,2,"1628530"],[11,6,"1230250"],[17,3,"1411070"]],[]],["白いぼうしとエプロンが入っています。きゅうしょく当番が、使います。",[[0,2,"1474910"],[2,3,"1520380"],[6,4,"1029760"],[11,2,"1465590"],[14,1,"1577980"],[18,6,"1230250"],[24,2,"1449220"],[28,2,"1305990"]],[[0,1,"しろ"],[11,1,"はい"],[24,2,"とうばん"],[28,1,"つか"]]],["子どもがきゅうしょく当番をします。",[[0,3,"1307850"],[4,6,"1230250"],[10,2,"1449220"],[13,1,"1157170"]],[[0,1,"こ"],[10,2,"とうばん"]]],["これが、きゅうしょく。学校の昼ごはんです。",[[0,2,"1628530"],[4,6,"1230250"],[11,2,"1206730"],[14,4,"1602340"]],[[11,2,"がっこう"],[14,1,"ひる"]]],["教室できゅうしょくを食べます。",[[0,2,"1237150"],[3,6,"1230250"],[10,2,"1358280"]],[[0,2,"きょうしつ"],[10,1,"た"]]],["これ、なあに？これは、ぞうきん。",[[0,2,"1628530"],[3,3,"1577100"],[7,2,"1628530"],[11,4,"1299370"]],[]],["これ、なあに？これは、ほうき。",[[0,2,"1628530"],[3,3,"1577100"],[7,2,"1628530"],[11,3,"1566500"]],[]],["これ、なあに？これは、ちりとり。",[[0,2,"1628530"],[3,3,"1577100"],[7,2,"1628530"],[11,4,"1369920"]],[]],["そうじ当番が使います。子どもが、そうじ当番をします。",[[0,3,"1399790"],[3,2,"1449220"],[6,2,"1305990"],[11,3,"1307850"],[16,3,"1399790"],[19,2,"1449220"],[22,1,"1157170"]],[[3,2,"とうばん"],[6,1,"つか"],[11,1,"こ"],[19,2,"とうばん"]]],["これ、なあに？これは、げたばこ。くつを出します。そして、うわばきを入れます。",[[0,2,"1628530"],[3,3,"1577100"],[7,2,"1628530"],[11,4,"1185830"],[16,2,"1246700"],[19,2,"1338180"],[24,3,"1