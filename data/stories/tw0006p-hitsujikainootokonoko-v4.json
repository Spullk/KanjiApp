[["毎日、同じ仕事です。男の子はおもしろくありません。男の子は村へ行きました。――何かおもしろいことがしたいな･･･。そして、大きな声で言いました。あ、そうだ！――「オオカミだ！」",[[0,2,"1524720"],[3,2,"1451750"],[5,2,"1304970"],[10,3,"1420010"],[14,5,"1533580"],[19,2,"1296400"],[25,3,"1420010"],[29,1,"1406820"],[31,2,"1578850"],[39,1,"2846738"],[41,5,"1533580"],[46,2,"1241450"],[49,1,"1157170"],[57,3,"1006730"],[61,3,"1412890"],[64,1,"1380440"],[66,2,"1587040"],[72,1,"2394370"],[74,2,"1241450"],[81,4,"1560940"]],[[0,2,"まいにち"],[3,1,"おな"],[5,2,"しごと"],[10,3,"おとこのこ"],[25,3,"おとこのこ"],[29,1,"むら"],[31,1,"い"],[39,1,"なん"],[61,1,"おお"],[64,1,"こえ"],[66,1,"い"]]],["でも、オオカミはいません。村の人たちが来ました。村の人たちは帰りました。「オオカミはどこだ？」――これはおもしろい！――「オオカミはどこだ？」男の子は笑いました。",[[3,4,"1560940"],[8,1,"1577980"],[13,1,"1406820"],[15,3,"1368740"],[19,1,"1547720"],[24,1,"1406820"],[26,3,"1368740"],[30,2,"1221270"],[37,4,"1560940"],[42,2,"1577140"],[49,2,"1628530"],[52,5,"1533580"],[61,4,"1560940"],[66,2,"1577140"],[71,3,"1420010"],[75,2,"1351360"]],[[13,1,"むら"],[15,1,"ひと"],[19,1,"き"],[24,1,"むら"],[26,1,"ひと"],[30,1,"かえ"],[71,3,"おとこのこ"],[75,1,"わら"]]],["次の日、男の子は、また大きな声で言いました。村の人たちが、また、来ました。「オオカミだ！オオカミだ！」でも、オオカミはいません。",[[0,1,"1316380"],[2,1,"1463770"],[4,3,"1420010"],[9,2,"1524930"],[11,3,"1412890"],[14,1,"1380440"],[16,2,"1587040"],[22,1,"1406820"],[24,3,"1368740"],[29,2,"1524930"],[32,1,"1547720"],[38,4,"1560940"],[44,4,"1560940"],[54,4,"1560940"],[59,1,"1577980"]],[[0,1,"つぎ"],[2,1,"ひ"],[4,3,"おとこのこ"],[11,1,"おお"],[14,1,"こえ"],[16,1,"い"],[22,1,"むら"],[24,1,"ひと"],[32,1,"き"]]],["村の人たちは帰りました。――おもしろい、おもしろい！――男の子は、笑いました。その次の日、本当にオオカミが来ました。",[[0,1,"1406820"],[2,3,"1368740"],[6,2,"1221270"],[14,5,"1533580"],[20,5,"1533580"],[28,3,"1420010"],[33,2,"1351360"],[39,2,"1006830"],[41,1,"1316380"],[43,1,"1463770"],[45,2,"1523060"],[48,4,"1560940"],[53,1,"1547720"]],[[0,1,"むら"],[2,1,"ひと"],[6,1,"かえ"],[28,3,"おとこのこ"],[33,1,"わら"],[41,1,"つぎ"],[43,1,"ひ"],[45,2,"ほんとう"],[53,1,"き"]]],["男の子は大きな声で言いました。「大変だ、オオカミだ！オオカミだ！」でも、村の人たちは来ません。オオカミは、羊をみんな食べました。",[[0,3,"1420010"],[4,3,"1412890"],[7,1,"1380440"],[9,2,"1587040"],[16,2,"1415000"]