[["キャラメルとあめ玉が、お菓子箱の中で喧嘩を始めました。",[[0,5,"2480290"],[6,3,"1153530"],[11,3,"1001710"],[14,1,"1585650"],[16,1,"1423310"],[18,2,"1257040"],[21,2,"1307550"]],[[8,1,"だま"],[12,2,"かし"],[14,1,"ばこ"],[16,1,"なか"],[18,2,"けんか"],[21,1,"はじ"]]],["キャラメルが言いました。「おい、あめ玉！おまえは丸くて甘いだけだ。服もないだろう。おれには服があるし、家もあるんだぞ。やーい！」",[[0,5,"2480290"],[6,2,"1587040"],[13,2,"1643510"],[16,3,"1153530"],[20,3,"1002290"],[24,2,"1604230"],[27,2,"1213400"],[33,1,"1500940"],[35,2,"1529520"],[41,2,"1576870"],[45,1,"1500940"],[47,2,"1296400"],[51,1,"1191730"],[53,2,"1296400"],[59,3,"2648350"]],[[6,1,"い"],[18,1,"だま"],[24,1,"まる"],[27,1,"あま"],[33,1,"ふく"],[45,1,"ふく"],[51,1,"いえ"]]],["あめ玉は怒りました。顔が真っ赤です。「おい、キャラメル！ばかなことを言うな。おれも外ではいつも服を着てるんだ」",[[0,3,"1153530"],[4,2,"1445690"],[10,1,"1217730"],[12,3,"1363250"],[19,2,"1643510"],[22,5,"2480290"],[28,2,"1601260"],[31,2,"1241450"],[34,2,"1587040"],[38,2,"1576870"],[41,1,"1203250"],[44,3,"1188890"],[47,1,"1500940"],[49,1,"1423000"]],[[2,1,"だま"],[4,1,"おこ"],[10,1,"かお"],[12,3,"まっか"],[34,1,"ゆ"],[41,1,"そと"],[47,1,"ふく"],[49,1,"き"]]],["あめ玉は、また言いました。「おまえの名前はどうしてキャラメルなんだ？日本にいるんだから、外国語の名前はだめだ！」",[[0,3,"1153530"],[5,2,"1524930"],[7,2,"1587040"],[14,3,"1002290"],[18,2,"1531710"],[21,2,"1451160"],[23,1,"1157170"],[25,5,"2480290"],[37,2,"1577980"],[44,3,"1203640"],[48,2,"1531710"],[51,2,"1409110"]],[[2,1,"だま"],[7,1,"い"],[18,2,"なまえ"],[34,2,"にっぽん"],[44,3,"がいこくご"],[48,2,"なまえ"]]],["キャラメルは言いました。「おまえはカステラやシュークリームやワッフルを食べたことがないのか？おいしいお菓子は、みんな外国の名前だぞ。日本のあめ玉やせんべいは、おいしくない」カステラシュークリームワッフルせんべいあめ玉",[[0,5,"2480290"],[6,2,"1587040"],[13,3,"1002290"],[17,4,"1037370"],[22,7,"1061950"],[30,4,"1149080"],[35,2,"1358280"],[38,2,"1241450"],[41,2,"1529520"],[46,4,"1486650"],[50,3,"1001710"],[55,3,"1202150"],[58,2,"1203620"],[61,2,"1531710"],[69,3,"1153530"],[73,4,"1391560"],[79,4,"1486650"],[83,2,"1529520"],[101,4,"1391560"],[105,3,"1153530"]],[[6,1,"い"],[35,1,"た"],[51,2,"かし"],[58,2,"がいこく"],[61,2,"なまえ"],[66,2,"にっぽん"],[71,1,"だま"],[107,1,"だま"]]],["あめ玉が言いました。「ようかんは、おいしいぞ。おまえより、ずっとおいしいぞ。コンペイトウは、ポルトガル語だ。でも、おいしくない。ウエハースなんて、たくさん食べても、おなかがいっぱいにならないじゃないか」ようかんコンペイトウウエハース",[[0,3,"1153530"],[4,2,"1587040"],[11,4,"1546540"],[17,4,"1486650"],[23,3,"1002290"],[29,3,"1006380"],[32,4,"1486650"],[38,6,"1243180"],[46,6,"1125950"],[57,4,"1486650"],[61,2,"1529520"],[64,5,"1026280"],[73,4,"1415870"],[77,2,"1358280"],[82,3,"1002610"],[86,4,"1165670"],[91,2,"1375610"],[97,2,"1529520"],[101,4,"1546540"],[105,6,"1243180"],[111,5,"1026280"]],[[2,1,"だま"],[4,1,"い"],[51,1,"ご"],[77,1,"た"]]],["キャラメルが言いました。「ばかだなぁ。ウエハースは、体にいいんだぞ。ウエハースも、おれも牛乳が入っているんだ」",[[0,5,"2480290"],[6,2,"1587040"],[13,2,"1601260"],[19,5,"1026280"],[26,1,"1409140"],[28,2,"1605820"],[34,5,"1026280"],[41,2,"1576870"],[44,2,"1231590"],[47,2,"1465590"],[50,2,"1577980"]],[[6,1,"い"],[26,1,"からだ"],[44,2,"ぎゅうにゅう"],[47,1,"はい"]]],["あめ玉が言いました。「おい、よく聞け！おれの中のニッキは薬だ。おまえの中の牛乳は、薬なのか？」ニッキ",[[0,3,"1153530"],[4,2,"1587040"],[11,2,"1643510"],[14,2,"1605870"],[16,2,"1591110"],[19,2,"1576870"],[22,1,"1423310"],[28,1,"1538160"],[31,3,"1002290"],[35,1,"1423310"],[37,2,"1231590"],[41,1,"1538160"]],[[2,1,"だま"],[4,1,"い"],[16,1,"き"],[22,1,"なか"],[28,1,"くすり"],[35,1,"なか"],[37,2,"ぎゅうにゅう"],[41,1,"くすり"]]],["キャラメルが言いました。「おまえは、ばかか？」あめ玉が言いました。「ばかは、おまえだ！」喧嘩は終わりません。",[[0,5,"2480290"],[6,2,"1587040"],[13,3,"1002290"],[18,2,"1601260"],[23,3,"1153530"],[27,2,"1587040"],[34,2,"1601260"],[38,3,"1002290"],[44,2,"1257040"],[47,3,"1589600"]],[[6,1,"い"],[25,1,"だま"],[27,1,"い"],[44,2,"けんか"],[47,1,"お"]]],["この喧嘩を友だちが見ていました。キャラメルの友だちは、ミント、ボンボン、チョコレートです。あめ玉の友だちは、かりんとう、どらやき、あるへいとうです。かりんとうチョコレートどらやきボンボンあるへいとうミント",[[0,2,"1582920"],[2,2,"1257040"],[5,3,"1540170"],[9,1,"1259290"],[11,1,"1577980"],[16,5,"2480290"],[22,3,"1540170"],[27,3,"1132110"],[31,4,"2207260"],[36,6,"1078270"],[45,3,"1153530"],[49,3,"1540170"],[54,5,"1195070"],[60,4,"2080020"],[65,2,"1296400"],[74,5,"1195070"],[79,6,"1078270"],[85,4,"2080020"],[89,4,"2207260"],[93,2,"1296400"],[96,3,"1175420"],[99,3,"1132110"]],[[2,2,"けんか"],[5,1,"とも"],[9,1,"み"],[22,1,"とも"],[47,1,"だま"],[49,1,"とも"]]],["友だちもいっしょに喧嘩を始めました。大喧嘩になりました。お菓子箱の中は熱いです。みんなの体が溶けて、くっついてしまいました。もう、動くことができません。",[[0,3,"1540170"],[4,4,"1163400"],[9,2,"1257040"],[12,2,"1307550"],[18,3,"2111580"],[22,2,"1375610"],[28,3,"1001710"],[31,1,"1585650"],[33,1,"1423310"],[35,2,"1467720"],[40,3,"1202150"],[44,1,"1409140"],[46,2,"1546070"],[50,4,"1003860"],[55,3,"1305380"],[62,2,"1012480"],[65,2,"1451210"],[67,2,"1241450"],[70,2,"1340450"]],[[0,1,"とも"],[9,2,"けんか"],[12,1,"はじ"],[18,3,"おおげんか"],[29,2,"かし"],[31,1,"ばこ"],[33,1,"なか"],[35,1,"あつ"],[44,1,"からだ"],[46,1,"と"],[65,1,"うご"]]],["そこへ、男の子が来ました。男の子は、お菓子のふたを開けて、びっくりしました。そして、大きな声で言いました。「お母さん、大変、大変！お菓子が喧嘩をしているよー！」",[[0,2,"1436050"],[4,3,"1420010"],[8,1,"1547720"],[13,3,"1420010"],[18,3,"1001710"],[22,2,"1204540"],[25,2,"1202450"],[29,4,"1226360"],[33,1,"1157170"],[38,3,"1006730"],[42,3,"1412890"],[45,1,"1380440"],[47,2,"1587040"],[54,4,"1002650"],[59,2,"1415000"],[62,2,"1415000"],[65,3,"1001710"],[69,2,"1257040"],[72,1,"1157170"],[74,2,"1577980"]],[[4,3,"おとこのこ"],[8,1,"き"],[13,3,"おとこのこ"],[19,2,"かし"],[25,1,"あ"],[42,1,"おお"],[45,1,"こえ"],[47,1,"い"],[55,1,"かあ"],[59,2,"たいへん"],[62,2,"たいへん"],[66,2,"かし"],[69,2,"けんか"]]],["お母さんもお菓子箱の中を見ました。そして、言いました。「ほらね、たくさん入れてはだめと言ったでしょう」",[[0,4,"1002650"],[5,3,"1001710"],[8,1,"1585650"],[10,1,"1423310"],[12,1,"1259290"],[17,3,"1006730"],[21,2,"1587040"],[28,2,"1453850"],[32,4,"1415870"],[36,2,"1465610"],[40,2,"1409110"],[43,2,"1587040"]],[[1,1,"かあ"],[6,2,"かし"],[8,1,"ばこ"],[10,1,"なか"],[12,1,"み"],[21,1,"い"],[36,1,"い"],[43,1,"い"]]],["でも、だいじょうぶよ。ちょっと待ってなさい」すると、お母さんは金槌で…。",[[3,6,"1414150"],[11,4,"1163940"],[15,2,"1410590"],[18,3,"1157090"],[22,2,"1157170"],[26,4,"1002650"],[31,2,"1779760"]],[[15,1,"ま"],[27,1,"かあ"],[31,2,"かなづち"]]],["お菓子はバラバラになりました。",[[0,3,"1001710"],[4,4,"1010320"],[9,2,"1375610"]],[[1,2,"かし"]]],["お母さんが、言いました。「さあ、食べなさい！」",[[0,4,"1002650"],[6,2,"1587040"],[13,2,"1005110"],[16,2,"1358280"],[18,3,"1157090"]],[[1,1,"かあ"],[6,1,"い"],[16,1,"た"]]],["夢野久作（1889～1936年）夢野久作は、福岡県生まれの作家です。軍人、僧、郵便局長など、いろいろな仕事をしました。新聞記者だったとき、たくさんの童話を書きましたが、やがて、不思議で怖い小説を書くようになりました。10年かけて書いた「ドグラ・マグラ」は、わかりにくくて不思議な小説として有名です。",[[14,1,"2084840"],[25,3,"1609350"],[29,2,"1297510"],[34,2,"1248540"],[37,1,"1398030"],[39,3,"1542430"],[42,1,"2647210"],[46,4,"1587850"],[51,2,"1304970"],[54,1,"1157170"],[59,4,"1362370"],[66,2,"1315840"],[69,4,"1415870"],[74,2,"1454000"],[77,2,"1343950"],[84,3,"1012730"],[88,3,"1492570"],[92,2,"1593480"],[94,2,"1348430"],[97,2,"1343950"],[99,2,"1605845"],[102,2,"1375610"],[110,1,"2084840"],[111,2,"1570710"],[114,2,"1343950"],[128,6,"1606540"],[135,3,"1492570"],[139,2,"1348430"],[142,1,"1157170"],[144,2,"1541620"]],[[0,2,"ゆめの"],[2,2,"きゅうさく"],[14,1,"ねん"],[16,2,"ゆめの"],[18,2,"きゅうさく"],[22,3,"ふくおかけん"],[25,1,"う"],[29,2,"さっか"],[34,2,"ぐんじん"],[37,1,"そう"],[39,3,"ゆうびんきょく"],[42,1,"ちょう"],[51,2,"しごと"],[59,4,"しんぶんきしゃ"],[74,2,"どうわ"],[77,1,"か"],[88,3,"ふしぎ"],[92,1,"こわ"],[94,2,"しょうせつ"],[97,1,"か"],[110,1,"ねん"],[114,1,"か"],[135,3,"ふしぎ"],[139,2,"しょうせつ"],[144,2,"ゆうめい"]]]]