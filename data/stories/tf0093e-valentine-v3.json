[["もうすぐ2月14日、バレンタインデーです。世界のバレンタインデーの楽しみ方はいろいろです。日本では、女性が男性にチョコレートをあげます。",[[0,4,"2015610"],[5,1,"1255430"],[8,1,"1463770"],[10,8,"1100020"],[21,2,"1373860"],[24,8,"1100020"],[33,3,"1207270"],[36,1,"1516930"],[38,4,"1587850"],[50,2,"1345250"],[53,2,"1420160"],[56,6,"1078270"],[63,2,"1352320"]],[[5,1,"がつ"],[8,1,"か"],[21,2,"せかい"],[33,1,"たの"],[36,1,"かた"],[45,2,"にっぽん"],[50,2,"じょせい"],[53,2,"だんせい"]]],["この時期に、お店ではたくさんのチョコレートが売られています。日本で、バレンタインデーにチョコレートを贈る習慣は、チョコレートの会社やデパートのキャンペーンから始まりました。",[[0,2,"1582920"],[2,2,"1316040"],[6,2,"2842661"],[10,4,"1415870"],[15,6,"1078270"],[22,2,"1473950"],[26,1,"1577980"],[34,8,"1100020"],[43,6,"1078270"],[50,2,"1403550"],[52,2,"1333090"],[56,6,"1078270"],[63,2,"1198550"],[66,4,"1083590"],[71,6,"1042250"],[79,3,"1307500"]],[[2,2,"じき"],[7,1,"みせ"],[22,1,"う"],[30,2,"にっぽん"],[50,1,"おく"],[52,2,"しゅうかん"],[63,2,"かいしゃ"],[79,1,"はじ"]]],["バレンタインデーに渡すチョコレートは、渡す相手によって呼び方が変わります。本当に好きな男性にあげるチョコレートを「本命チョコ」といいます。付き合いたい男性に告白する女性もいます。手作りのチョコレートを用意する女性も多いです。男性も女性からチョコレートをもらえるのを楽しみにしています。",[[0,8,"1100020"],[9,2,"1444610"],[11,6,"1078270"],[19,2,"1444610"],[21,2,"1401000"],[24,2,"1536350"],[27,3,"2033730"],[31,3,"1510790"],[37,2,"1523060"],[40,2,"1277450"],[43,2,"1420160"],[46,3,"1352320"],[49,6,"1078270"],[57,5,"2534830"],[64,2,"1587040"],[69,4,"1597790"],[75,2,"1420160"],[78,2,"1286060"],[80,2,"1157170"],[82,2,"1345250"],[85,1,"1577980"],[89,3,"1598360"],[93,6,"1078270"],[100,2,"1546220"],[102,2,"1157170"],[104,2,"1345250"],[107,2,"1407460"],[112,2,"1420160"],[115,2,"1345250"],[119,6,"1078270"],[126,4,"1535910"],[132,3,"1207250"],[136,1,"1157170"],[138,1,"1577980"]],[[9,1,"わた"],[19,1,"わた"],[21,2,"あいて"],[27,3,"よびかた"],[31,1,"か"],[37,2,"ほんとう"],[40,1,"す"],[43,2,"だんせい"],[57,2,"ほんめい"],[69,3,"つきあ"],[75,2,"だんせい"],[78,2,"こくはく"],[82,2,"じょせい"],[89,2,"てづく"],[100,2,"ようい"],[104,2,"じょせい"],[107,1,"おお"],[112,2,"だんせい"],[115,2,"じょせい"],[132,1,"たの"]]],["大学生の健太さんのバレンタインデーを見てみましょう。健太さんは留学生のアンナさんと付き合っています。日本では、女性が男性にチョコレートを贈ります。健太さんは日本で育った男性なので、アンナさんからチョコレートをもらえると思っていました。一方、アンナさんはイギリスで育ったので、健太さんからプレゼントをもらえると思っていました。",[[0,3,"1413260"],[6,2,"1579350"],[9,8,"1100020"],[18,1,"1259290"],[20,1,"1259290"],[28,2,"1579350"],[31,3,"1552750"],[38,2,"1579350"],[41,4,"1597790"],[46,1,"1577980"],[55,2,"1345250"],[58,2,"1420160"],[61,6,"1078270"],[68,2,"1403550"],[75,2,"1579350"],[81,2,"1160540"],[84,2,"1420160"],[93,2,"1579350"],[97,6,"1078270"],[104,4,"1535910"],[109,2,"1589350"],[112,1,"1577980"],[117,2,"1166510"],[123,2,"1579350"],[131,2,"1160540"],[139,2,"1579350"],[143,5,"1116840"],[149,4,"1535910"],[154,2,"1589350"],[157,1,"1577980"]],[[0,3,"だいがくせい"],[4,2,"けんた"],[18,1,"み"],[26,2,"けんた"],[31,3,"りゅうがくせい"],[41,3,"つきあ"],[50,2,"にっぽん"],[55,2,"じょせい"],[58,2,"だんせい"],[68,1,"おく"],[73,2,"けんた"],[78,2,"にっぽん"],[81,1,"そだ"],[84,2,"だんせい"],[109,1,"おも"],[117,2,"いっぽう"],[131,1,"そだ"],[137,2,"けんた"],[154,1,"おも"]]],["バレンタインデー当日、いくら待っても相手が何もくれません。お互いに聞いてみると、二人とも何も用意していないことがわかりました。そこで、けんかになってしまいました…。国際カップルのバレンタインデーは大変です。",[[0,8,"1100020"],[8,2,"1449210"],[11,3,"1219980"],[14,2,"1410590"],[18,2,"1401000"],[21,1,"2846738"],[23,2,"1269130"],[29,3,"1979930"],[33,2,"1591110"],[36,2,"1259290"],[40,2,"1582670"],[44,1,"2846738"],[46,2,"1546220"],[48,1,"1157170"],[50,1,"1577980"],[53,2,"1241450"],[56,3,"1606560"],[63,2,"1436050"],[67,3,"1257040"],[71,2,"1375610"],[74,3,"1305380"],[82,6,"2850102"],[89,8,"1100020"],[98,2,"1415000"]],[[8,2,"とうじつ"],[14,1,"ま"],[18,2,"あいて"],[21,1,"なん"],[30,1,"たが"],[33,1,"き"],[40,2,"ふたり"],[44,1,"なん"],[46,2,"ようい"],[82,2,"こくさい"],[98,2,"たいへん"]]],["同じ職場の男性にあげるチョコレートを「義理チョコ」といいます。いつもお世話になっているお礼として、たくさんの男性にあげるので、準備が大変で、お金もかかります。「こんな習慣はなくした方がいい」と言う人もいます。それでも、たくさんチョコレートをもらうことは、男性にとって、うれしいことです。",[[0,2,"1451750"],[2,2,"1357540"],[5,2,"1420160"],[8,3,"1352320"],[11,6,"1078270"],[19,5,"1225930"],[26,2,"1587040"],[31,3,"1188890"],[34,3,"2144410"],[38,2,"1375610"],[41,2,"1577980"],[43,2,"1270810"],[46,1,"1157170"],[49,4,"1415870"],[54,2,"1420160"],[57,3,"1352320"],[63,2,"1341670"],[66,2,"1415000"],[70,2,"1001820"],[73,3,"1207590"],[80,3,"1004880"],[83,2,"1333090"],[86,3,"1529530"],[90,1,"1516930"],[92,2,"1605820"],[96,2,"1587040"],[98,1,"1580640"],[100,1,"1577980"],[104,2,"1006970"],[109,4,"1415870"],[113,6,"1078270"],[120,3,"1535910"],[123,2,"1241450"],[127,2,"1420160"],[130,2,"1326980"],[134,4,"1219510"],[138,2,"1241450"]],[[0,1,"おな"],[2,2,"しょくば"],[5,2,"だんせい"],[19,2,"ぎり"],[35,2,"せわ"],[44,1,"れい"],[54,2,"だんせい"],[63,2,"じゅんび"],[66,2,"たいへん"],[71,1,"かね"],[83,2,"しゅうかん"],[90,1,"ほう"],[96,1,"い"],[98,1,"ひと"],[127,2,"だんせい"]]],["義理チョコを楽しみにしているのは、男性だけではありません。会社員の夫を持つ、さなえさんもその一人です。バレタインデーには、さなえさんの夫も「義理チョコ」を食べ切れないほど持ち帰ります。さなえさんは、そのチョコレートを喜んで食べます。",[[0,5,"1225930"],[6,3,"1207250"],[10,1,"1157170"],[12,2,"1577980"],[17,2,"1420160"],[23,2,"1296400"],[29,3,"1198560"],[33,1,"1496480"],[35,2,"1315720"],[41,2,"1579350"],[44,2,"1006830"],[46,2,"1576150"],[64,2,"1579350"],[67,1,"1496480"],[70,5,"1225930"],[77,2,"1358280"],[79,2,"1384860"],[85,4,"1658430"],[95,2,"1579350"],[99,2,"1006830"],[101,6,"1078270"],[108,2,"1218760"],[111,2,"1358280"]],[[0,2,"ぎり"],[6,1,"たの"],[17,2,"だんせい"],[29,3,"かいしゃいん"],[33,1,"おっと"],[35,1,"も"],[46,2,"ひとり"],[67,1,"おっと"],[70,2,"ぎり"],[77,1,"た"],[79,1,"き"],[85,3,"もちかえ"],[108,1,"よろこ"],[111,1,"た"]]],["仲のいい友達にあげるチョコレートを「友チョコ」といいます。日本の小中学校は、お菓子を持って行ってはいけないので、先生に見つからないようにこっそりチョコレートを交換します。",[[0,1,"1425710"],[2,2,"1605820"],[4,2,"1540170"],[7,3,"1352320"],[10,6,"1078270"],[18,4,"2534820"],[24,2,"1587040"],[32,4,"2056200"],[38,3,"1001710"],[42,2,"1315720"],[45,2,"1578850"],[49,2,"1578850"],[56,2,"1387990"],[59,4,"1604550"],[65,2,"1605845"],[68,4,"1004520"],[72,6,"1078270"],[79,2,"1271750"],[81,1,"1157170"]],[[0,1,"なか"],[4,2,"ともだち"],[18,1,"とも"],[29,2,"にっぽん"],[32,4,"しょうちゅうがっこう"],[39,2,"かし"],[42,1,"も"],[45,1,"い"],[56,2,"せんせい"],[59,1,"み"],[79,2,"こうかん"]]],["自分のために買うチョコレートを「ご褒美チョコ」といいます。いつもがんばっている自分のために、普段は買わない高級なチョコレートを買います。",[[0,2,"1318610"],[3,2,"1157080"],[6,2,"1473740"],[8,6,"1078270"],[16,3,"2211980"],[19,3,"1078260"],[24,2,"1587040"],[29,3,"1188890"],[32,4,"1217700"],[37,2,"1577980"],[39,2,"1318610"],[42,2,"1157080"],[46,2,"1497180"],[49,2,"1473740"]